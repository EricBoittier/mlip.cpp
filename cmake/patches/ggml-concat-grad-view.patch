 // else if there is no gradient for tensor, set the corresponding value
 // else, just add/subtract/etc. the gradients
 
+// a CONCAT's gradient w.r.t. one of its srcs, a view of its own gradient: read where it
+// is when that view is contiguous (e.g. one part of a concatenation along the last used
+// dimension) and the src does not accumulate its gradient in place, instead of a copy of
+// its bytes (GGML_CONCAT_GRAD_CONT=1: always the copy)
+static struct ggml_tensor * ggml_concat_grad_part(
+        struct ggml_context * ctx,
+        struct ggml_cgraph  * cgraph,
+        size_t                isrc,
+        struct ggml_tensor  * view) {
+    static int copy = -1;
+    if (copy < 0) {
+        copy = getenv("GGML_CONCAT_GRAD_CONT") != NULL;
+    }
+    if (!copy && ggml_is_contiguous(view) && !cgraph->grad_accs[isrc]) {
+        return view;
+    }
+    return ggml_cont(ctx, view);
+}
