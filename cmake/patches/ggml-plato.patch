+
+// Plato-PET-LR ops
+
+struct ggml_tensor * ggml_plato_attn(
+        struct ggml_context * ctx,
+        struct ggml_tensor  * qkv,
+        struct ggml_tensor  * ang,
+        struct ggml_tensor  * bias,
+        struct ggml_tensor  * off,
+        int                   n_head,
+        int                   max_len,
+        float                 scale,
+        int                   n_frames,
+        const float         * frame_weights) {
+    GGML_ASSERT(qkv->type == GGML_TYPE_F32 && ang->type == GGML_TYPE_F32 && bias->type == GGML_TYPE_F32 && off->type == GGML_TYPE_I32);
+    GGML_ASSERT(ggml_is_contiguous(qkv) && ggml_is_contiguous(ang) && ggml_is_contiguous(bias) && ggml_is_contiguous(off));
+    GGML_ASSERT(n_head > 0 && qkv->ne[0] % (3*n_head) == 0 && max_len > 0 && n_frames >= 1 && n_frames <= 12);
+    const int64_t D = qkv->ne[0] / 3, T = qkv->ne[1], d = D / n_head, N = ggml_nelements(off) - 1;
+    GGML_ASSERT(d % 2 == 0 && ggml_nelements(ang) == (d/2)*n_frames*T && ggml_nelements(bias) == T - N);
+
+    struct ggml_tensor * result = ggml_new_tensor_2d(ctx, GGML_TYPE_F32, D, T);
+    int32_t params[16] = { n_head, max_len, n_frames, 0 };
+    memcpy(params + 3, &scale, sizeof(float));
+    memcpy(params + 4, frame_weights, n_frames*sizeof(float));
+    ggml_set_op_params(result, params, sizeof(params));
+    result->op     = GGML_OP_PLATO_ATTN;
+    result->src[0] = qkv;
+    result->src[1] = ang;
+    result->src[2] = bias;
+    result->src[3] = off;
+    return result;
+}
+
+// [3D T] d qkv, then [d/2 F T] d ang, then [T - N] d bias
+static struct ggml_tensor * ggml_plato_attn_back(
+        struct ggml_context * ctx,
+        struct ggml_tensor  * attn,
+        struct ggml_tensor  * grad) {
+    GGML_ASSERT(ggml_is_contiguous(grad) && ggml_are_same_shape(grad, attn));
+    struct ggml_tensor * qkv = attn->src[0];
+    const int64_t T = qkv->ne[1];
+    struct ggml_tensor * result = ggml_new_tensor_1d(ctx, GGML_TYPE_F32,
+            qkv->ne[0]*T + ggml_nelements(attn->src[1]) + ggml_nelements(attn->src[2]));
+    ggml_set_op_params(result, attn->op_params, sizeof(attn->op_params));
+    result->op     = GGML_OP_PLATO_ATTN_BACK;
+    result->src[0] = qkv;
+    result->src[1] = attn->src[1];
+    result->src[2] = attn->src[2];
+    result->src[3] = attn->src[3];
+    result->src[4] = grad;
+    return result;
+}
+
+struct ggml_tensor * ggml_plato_fft3(
+        struct ggml_context * ctx,
+        struct ggml_tensor  * a,
+        int                   mode,
+        int                   M0,
+        int                   M1,
+        int                   M2) {
+    GGML_ASSERT(a->type == GGML_TYPE_F32 && ggml_is_contiguous(a) && mode >= 0 && mode <= 3);
+    const int64_t Mh = M2/2 + 1, real = (int64_t) M0*M1*M2, cplx = 2*(int64_t) M0*M1*Mh;
+    const bool to_complex = mode == 0 || mode == 2;
+    const int64_t n_in = to_complex ? real : cplx;
+    GGML_ASSERT(ggml_nelements(a) % n_in == 0);
+    const int64_t C = ggml_nelements(a) / n_in;
+    struct ggml_tensor * result = to_complex ? ggml_new_tensor_4d(ctx, GGML_TYPE_F32, 2*Mh, M1, M0, C)
+                                             : ggml_new_tensor_4d(ctx, GGML_TYPE_F32, M2, M1, M0, C);
+    int32_t params[4] = { mode, M0, M1, M2 };
+    ggml_set_op_params(result, params, sizeof(params));
+    result->op     = GGML_OP_PLATO_FFT3;
+    result->src[0] = a;
+    return result;
+}
+
+struct ggml_tensor * ggml_plato_spread_blocked(
+        struct ggml_context * ctx,
+        struct ggml_tensor  * v,
+        struct ggml_tensor  * frac,
+        struct ggml_tensor  * block,
+        int                   n_blocks,
+        int                   M0,
+        int                   M1,
+        int                   M2) {
+    GGML_ASSERT(v->type == GGML_TYPE_F32 && frac->type == GGML_TYPE_F32 && ggml_is_contiguous(v) && ggml_is_contiguous(frac));
+    GGML_ASSERT(frac->ne[0] == 3 && ggml_nrows(frac) == ggml_nrows(v) && M0 >= 4 && M1 >= 4 && M2 >= 4 && n_blocks >= 1);
+    GGML_ASSERT(!block || (block->type == GGML_TYPE_I32 && ggml_nelements(block) == ggml_nrows(v) && ggml_is_contiguous(block)));
+    struct ggml_tensor * result = ggml_new_tensor_4d(ctx, GGML_TYPE_F32, M2, M1, M0, v->ne[0]*n_blocks);
+    int32_t params[4] = { M0, M1, M2, n_blocks };
+    ggml_set_op_params(result, params, sizeof(params));
+    result->op     = GGML_OP_PLATO_SPREAD;
+    result->src[0] = v;
+    result->src[1] = frac;
+    result->src[2] = block;
+    return result;
+}
+
+struct ggml_tensor * ggml_plato_spread(
+        struct ggml_context * ctx,
+        struct ggml_tensor  * v,
+        struct ggml_tensor  * frac,
+        int                   M0,
+        int                   M1,
+        int                   M2) {
+    return ggml_plato_spread_blocked(ctx, v, frac, NULL, 1, M0, M1, M2);
+}
