+namespace {
+
+typedef std::complex<double> plato_cd;
+
+// one line of the mixed-radix FFT: out[0, n) = DFT of in[0], in[stride], ...
+// (sign -1 forward), with tw[k] = exp(sign 2 pi i k / N) of the top-level N = n * step
+void plato_fft_rec(const plato_cd * in, int64_t stride, plato_cd * out, int64_t n, const plato_cd * tw, int64_t step,
+                   plato_cd * tmp) {
+    if (n == 1) { out[0] = in[0]; return; }
+    int64_t p = 2;
+    while (n % p) p++;
+    const int64_t m = n / p;
+    for (int64_t r = 0; r < p; r++) plato_fft_rec(in + r*stride, stride*p, out + r*m, m, tw, step*p, tmp);
+    const int64_t N = n*step;
+    for (int64_t k = 0; k < m; k++) {
+        for (int64_t r = 0; r < p; r++) tmp[r] = out[r*m + k];
+        for (int64_t q = 0; q < p; q++) {
+            plato_cd acc = 0.0;
+            const int64_t e = k + q*m; // exponent r e of W_n = W_N^{step}
+            for (int64_t r = 0; r < p; r++) acc += tmp[r]*tw[(r*e % n)*step % N];
+            out[k + q*m] = acc;
+        }
+    }
+}
+
+struct plato_fft_line {
+    std::vector<plato_cd> tw, a, b, tmp;
+    int64_t n = 0;
+    int sign = 0;
+    void plan(int64_t n_, int sign_) {
+        if (n_ == n && sign_ == sign) return;
+        n = n_, sign = sign_;
+        tw.resize(n), a.resize(n), b.resize(n), tmp.resize(n);
+        for (int64_t k = 0; k < n; k++) tw[k] = std::polar(1.0, sign*2.0*M_PI*(double)k/(double)n);
+    }
+    void run() { plato_fft_rec(a.data(), 1, b.data(), n, tw.data(), 1, tmp.data()); } // a -> b
+};
+
+} // namespace
+
+void ggml_compute_forward_plato_fft3(const ggml_compute_params * params, ggml_tensor * dst) {
+    const int32_t * p = (const int32_t *) dst->op_params;
+    const int mode = p[0];
+    const int64_t M0 = p[1], M1 = p[2], M2 = p[3], Mh = M2/2 + 1, N = M0*M1*M2;
+    const bool fwd = mode == 0 || mode == 2;
+    const int64_t C = fwd ? ggml_nelements(dst->src[0]) / N : ggml_nelements(dst) / N;
+    const int ith = params->ith, nth = params->nth;
+    auto cfac = [&](int64_t m2) { return (m2 > 0 && 2*m2 < M2) ? 2.0 : 1.0; };
+    thread_local plato_fft_line line;
+    if (fwd) {
+        const float * x = (const float *) dst->src[0]->data;
+        float * y = (float *) dst->data; // [C][M0][M1][Mh] complex
+        line.plan(M2, -1);
+        for (int64_t l = ith; l < C*M0*M1; l += nth) {
+            for (int64_t k = 0; k < M2; k++) line.a[k] = x[l*M2 + k];
+            line.run();
+            for (int64_t k = 0; k < Mh; k++) y[2*(l*Mh + k)] = (float) line.b[k].real(), y[2*(l*Mh + k) + 1] = (float) line.b[k].imag();
+        }
+        ggml_barrier(params->threadpool);
+        line.plan(M1, -1);
+        for (int64_t l = ith; l < C*M0*Mh; l += nth) { // (c, i0, m2), axis 1
+            const int64_t m2 = l % Mh, ci0 = l / Mh;
+            float * base = y + 2*(ci0*M1*Mh + m2);
+            for (int64_t k = 0; k < M1; k++) line.a[k] = plato_cd(base[2*k*Mh], base[2*k*Mh + 1]);
+            line.run();
+            for (int64_t k = 0; k < M1; k++) base[2*k*Mh] = (float) line.b[k].real(), base[2*k*Mh + 1] = (float) line.b[k].imag();
+        }
+        ggml_barrier(params->threadpool);
+        line.plan(M0, -1);
+        for (int64_t l = ith; l < C*M1*Mh; l += nth) { // (c, i1, m2), axis 0
+            const int64_t m2 = l % Mh, i1 = (l / Mh) % M1, c = l / (Mh*M1);
+            float * base = y + 2*(c*M0*M1*Mh + i1*Mh + m2);
+            const int64_t st = 2*M1*Mh;
+            const double sc = mode == 2 ? cfac(m2)/(double) N : 1.0;
+            for (int64_t k = 0; k < M0; k++) line.a[k] = plato_cd(base[k*st], base[k*st + 1]);
+            line.run();
+            for (int64_t k = 0; k < M0; k++) base[k*st] = (float)(sc*line.b[k].real()), base[k*st + 1] = (float)(sc*line.b[k].imag());
+        }
+    } else {
+        const float * y = (const float *) dst->src[0]->data; // complex
+        float * w = (float *) params->wdata;                  // complex work copy
+        float * x = (float *) dst->data;
+        line.plan(M0, +1);
+        for (int64_t l = ith; l < C*M1*Mh; l += nth) { // axis 0, with the input scale
+            const int64_t m2 = l % Mh, i1 = (l / Mh) % M1, c = l / (Mh*M1);
+            const int64_t o = 2*(c*M0*M1*Mh + i1*Mh + m2), st = 2*M1*Mh;
+            const double sc = mode == 1 ? 1.0/(double) N : 1.0/cfac(m2);
+            for (int64_t k = 0; k < M0; k++) line.a[k] = sc*plato_cd(y[o + k*st], y[o + k*st + 1]);
+            line.run();
+            for (int64_t k = 0; k < M0; k++) w[o + k*st] = (float) line.b[k].real(), w[o + k*st + 1] = (float) line.b[k].imag();
+        }
+        ggml_barrier(params->threadpool);
+        line.plan(M1, +1);
+        for (int64_t l = ith; l < C*M0*Mh; l += nth) {
+            const int64_t m2 = l % Mh, ci0 = l / Mh;
+            float * base = w + 2*(ci0*M1*Mh + m2);
+            for (int64_t k = 0; k < M1; k++) line.a[k] = plato_cd(base[2*k*Mh], base[2*k*Mh + 1]);
+            line.run();
+            for (int64_t k = 0; k < M1; k++) base[2*k*Mh] = (float) line.b[k].real(), base[2*k*Mh + 1] = (float) line.b[k].imag();
+        }
+        ggml_barrier(params->threadpool);
+        line.plan(M2, +1);
+        for (int64_t l = ith; l < C*M0*M1; l += nth) { // c2r: the real parts of the self-conjugate bins
+            const float * b = w + 2*l*Mh;
+            for (int64_t k = 0; k < Mh; k++) line.a[k] = plato_cd(b[2*k], b[2*k + 1]);
+            line.a[0] = line.a[0].real();
+            if (M2 % 2 == 0) line.a[M2/2] = line.a[M2/2].real();
+            for (int64_t k = Mh; k < M2; k++) line.a[k] = std::conj(line.a[M2 - k]);
+            line.run();
+            for (int64_t k = 0; k < M2; k++) x[l*M2 + k] = (float) line.b[k].real();
+        }
+    }
+}
+
+namespace {
+
+// order-4 B-spline weights (bspline4_stencil) and their derivatives w.r.t. u
+inline void plato_bspline(float u, int64_t K, int64_t idx[4], float w[4], float dw[4]) {
+    const float fl = floorf(u), t = u - fl;
+    const int64_t i0 = (int64_t) fl;
+    const float t2 = t*t, t3 = t2*t, s = 1.0f - t;
+    w[0] = s*s*s/6.0f;
+    w[1] = (3.0f*t3 - 6.0f*t2 + 4.0f)/6.0f;
+    w[2] = (-3.0f*t3 + 3.0f*t2 + 3.0f*t + 1.0f)/6.0f;
+    w[3] = t3/6.0f;
+    dw[0] = -0.5f*s*s;
+    dw[1] = 1.5f*t2 - 2.0f*t;
+    dw[2] = -1.5f*t2 + t + 0.5f;
+    dw[3] = 0.5f*t2;
+    for (int k = 0; k < 4; k++) idx[k] = (((i0 + k - 1) % K) + K) % K;
+}
+
+struct plato_stencil {
+    int64_t idx[64];
+    float w[64], dw[3][64];
+    void make(const float * frac, int64_t M0, int64_t M1, int64_t M2, bool deriv) {
+        int64_t i[3][4];
+        float wt[3][4], dt[3][4];
+        const int64_t K[3] = {M0, M1, M2};
+        for (int a = 0; a < 3; a++) {
+            plato_bspline(frac[a]*(float) K[a], K[a], i[a], wt[a], dt[a]);
+            for (int k = 0; k < 4; k++) dt[a][k] *= (float) K[a];
+        }
+        for (int x = 0; x < 4; x++) for (int y = 0; y < 4; y++) for (int z = 0; z < 4; z++) {
+            const int s = (x*4 + y)*4 + z;
+            idx[s] = (i[0][x]*M1 + i[1][y])*M2 + i[2][z];
+            w[s] = wt[0][x]*wt[1][y]*wt[2][z];
+            if (deriv) {
+                dw[0][s] = dt[0][x]*wt[1][y]*wt[2][z];
+                dw[1][s] = wt[0][x]*dt[1][y]*wt[2][z];
+                dw[2][s] = wt[0][x]*wt[1][y]*dt[2][z];
+            }
+        }
+    }
+};
+
+} // namespace
+
+void ggml_compute_forward_plato_spread(const ggml_compute_params * params, ggml_tensor * dst) {
+    const float * v = (const float *) dst->src[0]->data, * frac = (const float *) dst->src[1]->data;
+    const int32_t * blk = dst->src[2] ? (const int32_t *) dst->src[2]->data : nullptr;
+    const int64_t C = dst->src[0]->ne[0], n = ggml_nrows(dst->src[1]), CT = dst->ne[3];
+    const int64_t M2 = dst->ne[0], M1 = dst->ne[1], M0 = dst->ne[2], M = M0*M1*M2;
+    float * rho = (float *) dst->data;
+    plato_stencil st;
+    for (int64_t ct = params->ith; ct < CT; ct += params->nth) { // a channel per thread: no races
+        float * r = rho + ct*M;
+        memset(r, 0, M*sizeof(float));
+        const int64_t b = ct / C, c = ct % C;
+        for (int64_t a = 0; a < n; a++) {
+            if ((blk ? blk[a] : 0) != b) continue;
+            st.make(frac + 3*a, M0, M1, M2, false);
+            const float va = v[a*C + c];
+            for (int s = 0; s < 64; s++) r[st.idx[s]] += st.w[s]*va;
+        }
+    }
+}
+
+void ggml_compute_forward_plato_gather(const ggml_compute_params * params, ggml_tensor * dst) {
+    const ggml_tensor * mesh = dst->src[0];
+    const float * phi = (const float *) mesh->data, * frac = (const float *) dst->src[1]->data;
+    const int32_t * blk = dst->src[2] ? (const int32_t *) dst->src[2]->data : nullptr;
+    const int64_t M2 = mesh->ne[0], M1 = mesh->ne[1], M0 = mesh->ne[2], M = M0*M1*M2;
+    const int64_t n = ggml_nrows(dst->src[1]);
+    const bool deriv = ggml_get_op_params_i32(dst, 0) != 0;
+    const int64_t C = ggml_get_op_params_i32(dst, 1);
+    float * out = (float *) dst->data;
+    plato_stencil st;
+    for (int64_t a = params->ith; a < n; a += params->nth) {
+        st.make(frac + 3*a, M0, M1, M2, deriv);
+        const int64_t c0 = (blk ? blk[a] : 0)*C;
+        for (int64_t c = 0; c < C; c++) {
+            const float * m = phi + (c0 + c)*M;
+            if (!deriv) {
+                float acc = 0.0f;
+                for (int s = 0; s < 64; s++) acc += st.w[s]*m[st.idx[s]];
+                out[a*C + c] = acc;
+            } else {
+                for (int k = 0; k < 3; k++) {
+                    float acc = 0.0f;
+                    for (int s = 0; s < 64; s++) acc += st.dw[k][s]*m[st.idx[s]];
+                    out[(a*3 + k)*C + c] = acc;
+                }
+            }
+        }
+    }
+}
+
+void ggml_compute_forward_plato_erf(const ggml_compute_params * params, ggml_tensor * dst) {
+    GGML_ASSERT(ggml_is_contiguous(dst->src[0]));
+    const float * x = (const float *) dst->src[0]->data;
+    float * y = (float *) dst->data;
+    const int64_t n = ggml_nelements(dst);
+    const int64_t chunk = (n + params->nth - 1) / params->nth, lo = params->ith*chunk, hi = std::min(n, lo + chunk);
+    for (int64_t k = lo; k < hi; k++) y[k] = erff(x[k]);
+}
+
+// ggml_plato_ewald: [nk, G, 3] = C, S, C^2 + S^2 per k and structure
+
+void ggml_compute_forward_plato_ewald(const ggml_compute_params * params, ggml_tensor * dst) {
+    const float * frac = (const float *) dst->src[0]->data, * q = (const float *) dst->src[1]->data;
+    const int32_t * sidx = dst->src[2] ? (const int32_t *) dst->src[2]->data : nullptr;
+    const float * kn = (const float *) dst->src[3]->data;
+    const int64_t n = ggml_nelements(dst->src[1]), nk = dst->ne[0], G = dst->ne[1];
+    float * out = (float *) dst->data;
+    for (int64_t k = params->ith; k < nk; k += params->nth) {
+        const float n0 = kn[3*k], n1 = kn[3*k + 1], n2 = kn[3*k + 2];
+        for (int64_t g = 0; g < G; g++) out[g*nk + k] = 0.0f, out[(G + g)*nk + k] = 0.0f;
+        std::vector<double> C(G, 0.0), S(G, 0.0);
+        for (int64_t i = 0; i < n; i++) {
+            const float ph = frac[3*i]*n0 + frac[3*i + 1]*n1 + frac[3*i + 2]*n2;
+            const int64_t g = sidx ? sidx[i] : 0;
+            C[g] += q[i]*cosf(ph), S[g] += q[i]*sinf(ph);
+        }
+        for (int64_t g = 0; g < G; g++) {
+            out[g*nk + k] = (float) C[g], out[(G + g)*nk + k] = (float) S[g];
+            out[(2*G + g)*nk + k] = (float) (C[g]*C[g] + S[g]*S[g]);
+        }
+    }
+}
+
+void ggml_compute_forward_plato_ewald_back(const ggml_compute_params * params, ggml_tensor * dst) {
+    const float * frac = (const float *) dst->src[0]->data, * q = (const float *) dst->src[1]->data;
+    const int32_t * sidx = dst->src[2] ? (const int32_t *) dst->src[2]->data : nullptr;
+    const float * kn = (const float *) dst->src[3]->data;
+    const ggml_tensor * res = dst->src[4];
+    const float * R = (const float *) res->data, * dR = (const float *) dst->src[5]->data;
+    const int64_t n = ggml_nelements(dst->src[1]), nk = res->ne[0], G = res->ne[1];
+    float * dq = (float *) dst->data, * df = dq + n;
+    for (int64_t i = params->ith; i < n; i += params->nth) {
+        const int64_t g = sidx ? sidx[i] : 0;
+        const float * C = R + g*nk, * S = R + (G + g)*nk, * dP = dR + (2*G + g)*nk;
+        double aq = 0, a0 = 0, a1 = 0, a2 = 0;
+        for (int64_t k = 0; k < nk; k++) {
+            const float ph = frac[3*i]*kn[3*k] + frac[3*i + 1]*kn[3*k + 1] + frac[3*i + 2]*kn[3*k + 2];
+            const float c = cosf(ph), s = sinf(ph);
+            aq += 2.0*dP[k]*(C[k]*c + S[k]*s);
+            const double t = 2.0*dP[k]*q[i]*(S[k]*c - C[k]*s);
+            a0 += t*kn[3*k], a1 += t*kn[3*k + 1], a2 += t*kn[3*k + 2];
+        }
+        dq[i] = (float) aq, df[3*i] = (float) a0, df[3*i + 1] = (float) a1, df[3*i + 2] = (float) a2;
+    }
+}
