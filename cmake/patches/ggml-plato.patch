+// Plato-PET-LR ops (reference CPU kernels; see ggml.h)
+
+namespace {
+
+struct plato_attn_args {
+    int H, max_len, F;
+    float scale;
+    float w[12];
+    int64_t N, D, d, hd, T;
+    const int32_t * off;
+    int64_t len(int64_t i) const { return 1 + off[i + 1] - off[i]; }
+    int64_t row(int64_t i, int64_t t) const { return t == 0 ? i : N + off[i] + t - 1; }
+};
+
+plato_attn_args plato_attn_get(const ggml_tensor * t) {
+    plato_attn_args a;
+    const int32_t * p = (const int32_t *) t->op_params;
+    a.H = p[0], a.max_len = p[1], a.F = p[2];
+    memcpy(&a.scale, p + 3, sizeof(float));
+    memcpy(a.w, p + 4, a.F*sizeof(float));
+    const ggml_tensor * qkv = t->src[0];
+    a.D = qkv->ne[0] / 3, a.T = qkv->ne[1], a.d = a.D / a.H, a.hd = a.d / 2;
+    a.N = ggml_nelements(t->src[3]) - 1;
+    a.off = (const int32_t *) t->src[3]->data;
+    return a;
+}
+
+inline void plato_rope(const float * x, const float * ang, int64_t hd, float * r) {
+    for (int64_t j = 0; j < hd; j++) {
+        const float c = cosf(ang[j]), s = sinf(ang[j]);
+        r[j]      = x[j]*c - x[j + hd]*s;
+        r[j + hd] = x[j]*s + x[j + hd]*c;
+    }
+}
+
+} // namespace
+
+void ggml_compute_forward_plato_attn(const ggml_compute_params * params, ggml_tensor * dst) {
+    const plato_attn_args a = plato_attn_get(dst);
+    const float * x = (const float *) dst->src[0]->data;
+    const float * ang = (const float *) dst->src[1]->data;
+    const float * bias = (const float *) dst->src[2]->data;
+    float * out = (float *) dst->data;
+    const int64_t D = a.D, d = a.d, hd = a.hd, F = a.F, FA = F*hd;
+    if (params->ith == 0) {
+        for (int64_t r = a.N + a.off[a.N]; r < a.T; r++) memset(out + r*D, 0, D*sizeof(float));
+    }
+    std::vector<float> kr, qr(d), p, P;
+    for (int64_t i = params->ith; i < a.N; i += params->nth) {
+        const int64_t L = a.len(i);
+        kr.resize(F*L*d), p.resize(L), P.resize(L);
+        for (int h = 0; h < a.H; h++) {
+            for (int64_t t = 0; t < L; t++) {
+                const int64_t r = a.row(i, t);
+                for (int64_t f = 0; f < F; f++) plato_rope(x + r*3*D + D + h*d, ang + r*FA + f*hd, hd, kr.data() + (f*L + t)*d);
+            }
+            for (int64_t s = 0; s < L; s++) {
+                const int64_t rs = a.row(i, s);
+                std::fill(P.begin(), P.end(), 0.0f);
+                for (int64_t f = 0; f < F; f++) {
+                    plato_rope(x + rs*3*D + h*d, ang + rs*FA + f*hd, hd, qr.data());
+                    float mx = -INFINITY;
+                    for (int64_t t = 0; t < L; t++) {
+                        const float * k = kr.data() + (f*L + t)*d;
+                        float acc = 0.0f;
+                        for (int64_t c = 0; c < d; c++) acc += qr[c]*k[c];
+                        const int64_t rt = a.row(i, t);
+                        p[t] = a.scale*acc + (rt < a.N ? 0.0f : bias[rt - a.N]);
+                        mx = std::max(mx, p[t]);
+                    }
+                    double sum = 0.0;
+                    for (int64_t t = 0; t < L; t++) p[t] = expf(p[t] - mx), sum += p[t];
+                    for (int64_t t = 0; t < L; t++) P[t] += a.w[f]*(float)(p[t]/sum);
+                }
+                float * o = out + rs*D + h*d;
+                for (int64_t c = 0; c < d; c++) o[c] = 0.0f;
+                for (int64_t t = 0; t < L; t++) {
+                    const float * v = x + a.row(i, t)*3*D + 2*D + h*d;
+                    for (int64_t c = 0; c < d; c++) o[c] += P[t]*v[c];
+                }
+            }
+        }
+    }
+}
+
+void ggml_compute_forward_plato_attn_back(const ggml_compute_params * params, ggml_tensor * dst) {
+    const plato_attn_args a = plato_attn_get(dst);
+    const float * x = (const float *) dst->src[0]->data;
+    const float * ang = (const float *) dst->src[1]->data;
+    const float * bias = (const float *) dst->src[2]->data;
+    const float * grad = (const float *) dst->src[4]->data;
+    const int64_t D = a.D, d = a.d, hd = a.hd, F = a.F, FA = F*hd, T = a.T, N = a.N;
+    float * dqkv = (float *) dst->data, * dang = dqkv + 3*D*T, * dbias = dang + FA*T;
+    if (params->ith == 0) {
+        for (int64_t r = N + a.off[N]; r < T; r++) {
+            memset(dqkv + r*3*D, 0, 3*D*sizeof(float));
+            memset(dang + r*FA, 0, FA*sizeof(float));
+            dbias[r - N] = 0.0f;
+        }
+    }
+    std::vector<float> qr, kr, pf, dP, dqr, dkr;
+    for (int64_t i = params->ith; i < N; i += params->nth) {
+        const int64_t L = a.len(i);
+        qr.resize(F*L*d), kr.resize(F*L*d), pf.resize(F*L*L), dP.resize(L*L), dqr.resize(F*L*d), dkr.resize(F*L*d);
+        for (int64_t t = 0; t < L; t++) {
+            const int64_t r = a.row(i, t);
+            memset(dqkv + r*3*D, 0, 3*D*sizeof(float));
+            memset(dang + r*FA, 0, FA*sizeof(float));
+            if (r >= N) dbias[r - N] = 0.0f;
+        }
+        for (int h = 0; h < a.H; h++) {
+            for (int64_t t = 0; t < L; t++) {
+                const int64_t r = a.row(i, t);
+                for (int64_t f = 0; f < F; f++) {
+                    plato_rope(x + r*3*D + h*d, ang + r*FA + f*hd, hd, qr.data() + (f*L + t)*d);
+                    plato_rope(x + r*3*D + D + h*d, ang + r*FA + f*hd, hd, kr.data() + (f*L + t)*d);
+                }
+            }
+            for (int64_t s = 0; s < L; s++) {
+                const float * gs = grad + a.row(i, s)*D + h*d;
+                for (int64_t t = 0; t < L; t++) {
+                    const float * v = x + a.row(i, t)*3*D + 2*D + h*d;
+                    float acc = 0.0f;
+                    for (int64_t c = 0; c < d; c++) acc += gs[c]*v[c];
+                    dP[s*L + t] = acc;
+                }
+                for (int64_t f = 0; f < F; f++) {
+                    float * p = pf.data() + (f*L + s)*L;
+                    const float * q = qr.data() + (f*L + s)*d;
+                    float mx = -INFINITY;
+                    for (int64_t t = 0; t < L; t++) {
+                        const float * k = kr.data() + (f*L + t)*d;
+                        float acc = 0.0f;
+                        for (int64_t c = 0; c < d; c++) acc += q[c]*k[c];
+                        const int64_t rt = a.row(i, t);
+                        p[t] = a.scale*acc + (rt < N ? 0.0f : bias[rt - N]);
+                        mx = std::max(mx, p[t]);
+                    }
+                    double sum = 0.0;
+                    for (int64_t t = 0; t < L; t++) p[t] = expf(p[t] - mx), sum += p[t];
+                    for (int64_t t = 0; t < L; t++) p[t] = (float)(p[t]/sum);
+                }
+            }
+            std::fill(dqr.begin(), dqr.end(), 0.0f);
+            std::fill(dkr.begin(), dkr.end(), 0.0f);
+            for (int64_t s = 0; s < L; s++) {
+                const float * gs = grad + a.row(i, s)*D + h*d;
+                for (int64_t f = 0; f < F; f++) {
+                    const float * p = pf.data() + (f*L + s)*L;
+                    double Ds = 0.0;
+                    for (int64_t t = 0; t < L; t++) Ds += p[t]*dP[s*L + t];
+                    for (int64_t t = 0; t < L; t++) {
+                        const float da = a.w[f]*p[t]*(dP[s*L + t] - (float) Ds);
+                        const float sc = a.scale*da;
+                        const float * k = kr.data() + (f*L + t)*d, * q = qr.data() + (f*L + s)*d;
+                        float * dq = dqr.data() + (f*L + s)*d, * dk = dkr.data() + (f*L + t)*d;
+                        for (int64_t c = 0; c < d; c++) dq[c] += sc*k[c], dk[c] += sc*q[c];
+                        const int64_t rt = a.row(i, t);
+                        if (rt >= N) dbias[rt - N] += da;
+                        // dv_t += w_f p_f[s, t] dO_s
+                        float * dv = dqkv + rt*3*D + 2*D + h*d;
+                        const float wp = a.w[f]*p[t];
+                        for (int64_t c = 0; c < d; c++) dv[c] += wp*gs[c];
+                    }
+                }
+            }
+            // back through the rotations: d x = R^T d r, d ang_j = d r2 r1 - d r1 r2
+            for (int64_t t = 0; t < L; t++) {
+                const int64_t r = a.row(i, t);
+                float * dq = dqkv + r*3*D + h*d, * dk = dqkv + r*3*D + D + h*d;
+                for (int64_t f = 0; f < F; f++) {
+                    const float * an = ang + r*FA + f*hd;
+                    float * da = dang + r*FA + f*hd;
+                    const float * gq = dqr.data() + (f*L + t)*d, * gk = dkr.data() + (f*L + t)*d;
+                    const float * rq = qr.data() + (f*L + t)*d, * rk = kr.data() + (f*L + t)*d;
+                    for (int64_t j = 0; j < hd; j++) {
+                        const float c = cosf(an[j]), sn = sinf(an[j]);
+                        dq[j] += gq[j]*c + gq[j + hd]*sn, dq[j + hd] += -gq[j]*sn + gq[j + hd]*c;
+                        dk[j] += gk[j]*c + gk[j + hd]*sn, dk[j + hd] += -gk[j]*sn + gk[j + hd]*c;
+                        da[j] += gq[j + hd]*rq[j] - gq[j]*rq[j + hd] + gk[j + hd]*rk[j] - gk[j]*rk[j + hd];
+                    }
+                }
+            }
+        }
+    }
+}
