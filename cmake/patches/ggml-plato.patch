+struct ggml_tensor * ggml_plato_gather_blocked(
+        struct ggml_context * ctx,
+        struct ggml_tensor  * mesh,
+        struct ggml_tensor  * frac,
+        struct ggml_tensor  * block,
+        int                   C,
+        bool                  deriv) {
+    GGML_ASSERT(mesh->type == GGML_TYPE_F32 && frac->type == GGML_TYPE_F32 && ggml_is_contiguous(mesh) && ggml_is_contiguous(frac));
+    GGML_ASSERT(frac->ne[0] == 3 && mesh->ne[0] >= 4 && mesh->ne[1] >= 4 && mesh->ne[2] >= 4 && C >= 1 && mesh->ne[3] % C == 0);
+    GGML_ASSERT(!block || (block->type == GGML_TYPE_I32 && ggml_nelements(block) == ggml_nrows(frac) && ggml_is_contiguous(block)));
