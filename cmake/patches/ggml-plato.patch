+    result->op     = GGML_OP_PLATO_GATHER;
+    result->src[0] = mesh;
+    result->src[1] = frac;
+    result->src[2] = block;
+    return result;
+}
+
+struct ggml_tensor * ggml_plato_gather(
+        struct ggml_context * ctx,
+        struct ggml_tensor  * mesh,
+        struct ggml_tensor  * frac,
+        bool                  deriv) {
+    return ggml_plato_gather_blocked(ctx, mesh, frac, NULL, (int) mesh->ne[3], deriv);
+}
+
+struct ggml_tensor * ggml_plato_ewald(
+        struct ggml_context * ctx,
+        struct ggml_tensor  * frac,
+        struct ggml_tensor  * q,
+        struct ggml_tensor  * struct_index,
+        struct ggml_tensor  * kn,
+        int                   n_struct) {
+    GGML_ASSERT(frac->type == GGML_TYPE_F32 && q->type == GGML_TYPE_F32 && kn->type == GGML_TYPE_F32);
+    GGML_ASSERT(ggml_is_contiguous(frac) && ggml_is_contiguous(q) && ggml_is_contiguous(kn));
+    GGML_ASSERT(frac->ne[0] == 3 && kn->ne[0] == 3 && ggml_nelements(q) == ggml_nrows(frac) && n_struct >= 1);
+    GGML_ASSERT(!struct_index || (struct_index->type == GGML_TYPE_I32 && ggml_nelements(struct_index) == ggml_nelements(q)));
+    GGML_ASSERT(struct_index || n_struct == 1);
+    struct ggml_tensor * result = ggml_new_tensor_3d(ctx, GGML_TYPE_F32, ggml_nrows(kn), n_struct, 3);
+    ggml_set_op_params_i32(result, 0, n_struct);
+    result->op     = GGML_OP_PLATO_EWALD;
+    result->src[0] = frac;
+    result->src[1] = q;
+    result->src[2] = struct_index;
+    result->src[3] = kn;
+    return result;
+}
+
+struct ggml_tensor * ggml_plato_erf(
+        struct ggml_context * ctx,
+        struct ggml_tensor  * a) {
+    GGML_ASSERT(a->type == GGML_TYPE_F32);
+    struct ggml_tensor * result = ggml_dup_tensor(ctx, a);
+    result->op     = GGML_OP_PLATO_ERF;
+    result->src[0] = a;
+    return result;
+}
