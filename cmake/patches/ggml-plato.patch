+    const int64_t n = ggml_nrows(frac);
+    struct ggml_tensor * result = deriv ? ggml_new_tensor_3d(ctx, GGML_TYPE_F32, C, 3, n) : ggml_new_tensor_2d(ctx, GGML_TYPE_F32, C, n);
