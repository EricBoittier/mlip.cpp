diff --git a/src/ggml-cuda/plato.cu b/src/ggml-cuda/plato.cu
new file mode 100644
index 00000000..fc412fd9
--- /dev/null
+++ b/src/ggml-cuda/plato.cu
@@ -0,0 +1,652 @@
+#include "plato.cuh"
+
+#include <cufft.h>
+
+#include <map>
+#include <mutex>
+#include <tuple>
+
+// ---------------------------------------------------------------------------
+// frame-averaged RoPE attention over ragged sequences: one block per sequence,
+// the heads in turn; rotated keys (and queries, backward) of the sequence in
+// shared memory, one thread per query (forward, backward pass 1) or key (pass 2)
+
+namespace {
+
+struct plato_frame_w { float w[12]; };
+
+struct plato_attn_cu {
+    int H, max_len, F;
+    float scale;
+    plato_frame_w w;
+    int N, D, d, T;
+};
+
+plato_attn_cu plato_attn_cu_get(const ggml_tensor * t) {
+    plato_attn_cu a;
+    const int32_t * p = (const int32_t *) t->op_params;
+    a.H = p[0], a.max_len = p[1], a.F = p[2];
+    memcpy(&a.scale, p + 3, sizeof(float));
+    memcpy(a.w.w, p + 4, a.F*sizeof(float));
+    const ggml_tensor * qkv = t->src[0];
+    a.D = (int) (qkv->ne[0] / 3), a.T = (int) qkv->ne[1], a.d = a.D / a.H;
+    a.N = (int) (ggml_nelements(t->src[3]) - 1);
+    return a;
+}
+
+__device__ __forceinline__ int plato_row(const int * off, int N, int i, int t) { return t == 0 ? i : N + off[i] + t - 1; }
+
+template <int CH>
+__device__ __forceinline__ void plato_rope_reg(const float * x, const float * ang, float * r) {
+    constexpr int HD = CH / 2;
+#pragma unroll
+    for (int j = 0; j < HD; j++) {
+        float s, c;
+        sincosf(ang[j], &s, &c);
+        const float x1 = x[j], x2 = x[j + HD];
+        r[j] = x1*c - x2*s, r[j + HD] = x1*s + x2*c;
+    }
+}
+
+template <int CH, int F>
+__global__ void plato_attn_fwd(const float * __restrict__ qkv, const float * __restrict__ ang, const float * __restrict__ bias,
+                               const int * __restrict__ off, float * __restrict__ out, int N, int D, int H, float scale,
+                               plato_frame_w fw) {
+    constexpr int HD = CH / 2;
+    extern __shared__ float sm[];
+    const int i = blockIdx.x, L = 1 + off[i + 1] - off[i];
+    float * kr = sm;               // [F][L][CH]
+    float * vs = sm + F * L * CH;  // [L][CH]
+    float * bs = vs + L * CH;      // [L]
+    for (int t = threadIdx.x; t < L; t += blockDim.x) {
+        const int r = plato_row(off, N, i, t);
+        bs[t] = r < N ? 0.0f : bias[r - N];
+    }
+    for (int h = 0; h < H; h++) {
+        __syncthreads();
+        for (int e = threadIdx.x; e < L * F * HD; e += blockDim.x) {
+            const int t = e / (F * HD), f = (e / HD) % F, j = e % HD;
+            const int r = plato_row(off, N, i, t);
+            const float * k = qkv + (int64_t) r * 3 * D + D + h * CH;
+            float s, c;
+            sincosf(ang[(int64_t) r * F * HD + f * HD + j], &s, &c);
+            kr[(f * L + t) * CH + j] = k[j] * c - k[j + HD] * s;
+            kr[(f * L + t) * CH + j + HD] = k[j] * s + k[j + HD] * c;
+        }
+        for (int e = threadIdx.x; e < L * CH; e += blockDim.x) {
+            const int t = e / CH, c = e % CH;
+            vs[e] = qkv[(int64_t) plato_row(off, N, i, t) * 3 * D + 2 * D + h * CH + c];
+        }
+        __syncthreads();
+        for (int s = threadIdx.x; s < L; s += blockDim.x) {
+            const int rs = plato_row(off, N, i, s);
+            float q[CH], o[CH];
+#pragma unroll
+            for (int c = 0; c < CH; c++) q[c] = qkv[(int64_t) rs * 3 * D + h * CH + c], o[c] = 0.0f;
+#pragma unroll 1
+            for (int f = 0; f < F; f++) {
+                float qr[CH], acc[CH];
+                plato_rope_reg<CH>(q, ang + (int64_t) rs * F * HD + f * HD, qr);
+#pragma unroll
+                for (int c = 0; c < CH; c++) acc[c] = 0.0f;
+                float m = -INFINITY, Z = 0.0f;
+                for (int t = 0; t < L; t++) {
+                    const float * k = kr + (f * L + t) * CH;
+                    float a = 0.0f;
+#pragma unroll
+                    for (int c = 0; c < CH; c++) a += qr[c] * k[c];
+                    a = scale * a + bs[t];
+                    if (a > m) {
+                        const float corr = __expf(m - a);
+                        Z *= corr;
+#pragma unroll
+                        for (int c = 0; c < CH; c++) acc[c] *= corr;
+                        m = a;
+                    }
+                    const float e = expf(a - m);
+                    Z += e;
+#pragma unroll
+                    for (int c = 0; c < CH; c++) acc[c] += e * vs[t * CH + c];
+                }
+                const float sc = fw.w[f] / Z;
+#pragma unroll
+                for (int c = 0; c < CH; c++) o[c] += sc * acc[c];
+            }
+#pragma unroll
+            for (int c = 0; c < CH; c++) out[(int64_t) rs * D + h * CH + c] = o[c];
+        }
+    }
+}
+
+template <int CH, int F>
+__global__ void plato_attn_bwd(const float * __restrict__ qkv, const float * __restrict__ ang, const float * __restrict__ bias,
+                               const int * __restrict__ off, const float * __restrict__ grad, float * __restrict__ dqkv,
+                               float * __restrict__ dang, float * __restrict__ dbias, int N, int D, int H, float scale,
+                               plato_frame_w fw) {
+    constexpr int HD = CH / 2;
+    extern __shared__ float sm[];
+    const int i = blockIdx.x, L = 1 + off[i + 1] - off[i];
+    float * qr = sm;                  // [F][L][CH]
+    float * kr = qr + F * L * CH;     // [F][L][CH]
+    float * vs = kr + F * L * CH;     // [L][CH]
+    float * gs = vs + L * CH;         // [L][CH]
+    float * mz = gs + L * CH;         // [F][L][3]: max, 1/Z, D
+    float * da = mz + 3 * F * L;      // [L][F HD]
+    float * bs = da + L * F * HD;     // [L]
+    float * db = bs + L;              // [L]
+    for (int t = threadIdx.x; t < L; t += blockDim.x) {
+        const int r = plato_row(off, N, i, t);
+        bs[t] = r < N ? 0.0f : bias[r - N];
+        db[t] = 0.0f;
+    }
+    for (int e = threadIdx.x; e < L * F * HD; e += blockDim.x) da[e] = 0.0f;
+    for (int h = 0; h < H; h++) {
+        __syncthreads();
+        for (int e = threadIdx.x; e < L * F * HD; e += blockDim.x) {
+            const int t = e / (F * HD), f = (e / HD) % F, j = e % HD;
+            const int r = plato_row(off, N, i, t);
+            const float * q = qkv + (int64_t) r * 3 * D + h * CH, * k = q + D;
+            float s, c;
+            sincosf(ang[(int64_t) r * F * HD + f * HD + j], &s, &c);
+            qr[(f * L + t) * CH + j] = q[j] * c - q[j + HD] * s;
+            qr[(f * L + t) * CH + j + HD] = q[j] * s + q[j + HD] * c;
+            kr[(f * L + t) * CH + j] = k[j] * c - k[j + HD] * s;
+            kr[(f * L + t) * CH + j + HD] = k[j] * s + k[j + HD] * c;
+        }
+        for (int e = threadIdx.x; e < L * CH; e += blockDim.x) {
+            const int t = e / CH, c = e % CH;
+            const int r = plato_row(off, N, i, t);
+            vs[e] = qkv[(int64_t) r * 3 * D + 2 * D + h * CH + c];
+            gs[e] = grad[(int64_t) r * D + h * CH + c];
+        }
+        __syncthreads();
+        // pass 1, a query per thread: softmax statistics, D = sum_t p dP, d q
+        for (int s = threadIdx.x; s < L; s += blockDim.x) {
+            const int rs = plato_row(off, N, i, s);
+            float dq[CH];
+#pragma unroll
+            for (int c = 0; c < CH; c++) dq[c] = 0.0f;
+#pragma unroll 1
+            for (int f = 0; f < F; f++) {
+                const float * q = qr + (f * L + s) * CH;
+                float m = -INFINITY, Z = 0.0f, Dn = 0.0f;
+                for (int t = 0; t < L; t++) {
+                    const float * k = kr + (f * L + t) * CH;
+                    float a = 0.0f, dP = 0.0f;
+#pragma unroll
+                    for (int c = 0; c < CH; c++) a += q[c] * k[c], dP += gs[s * CH + c] * vs[t * CH + c];
+                    a = scale * a + bs[t];
+                    if (a > m) {
+                        const float corr = __expf(m - a);
+                        Z *= corr, Dn *= corr, m = a;
+                    }
+                    const float e = expf(a - m);
+                    Z += e, Dn += e * dP;
+                }
+                const float iz = 1.0f / Z, Dv = Dn * iz;
+                mz[(f * L + s) * 3 + 0] = m, mz[(f * L + s) * 3 + 1] = iz, mz[(f * L + s) * 3 + 2] = Dv;
+                float g[CH];
+#pragma unroll
+                for (int c = 0; c < CH; c++) g[c] = 0.0f;
+                for (int t = 0; t < L; t++) {
+                    const float * k = kr + (f * L + t) * CH;
+                    float a = 0.0f, dP = 0.0f;
+#pragma unroll
+                    for (int c = 0; c < CH; c++) a += q[c] * k[c], dP += gs[s * CH + c] * vs[t * CH + c];
+                    const float p = expf(scale * a + bs[t] - m) * iz;
+                    const float w = scale * fw.w[f] * p * (dP - Dv);
+#pragma unroll
+                    for (int c = 0; c < CH; c++) g[c] += w * k[c];
+                }
+                // back through the rotation of this frame
+                const float * an = ang + (int64_t) rs * F * HD + f * HD;
+#pragma unroll
+                for (int j = 0; j < HD; j++) {
+                    float sn, cs;
+                    sincosf(an[j], &sn, &cs);
+                    dq[j] += g[j] * cs + g[j + HD] * sn, dq[j + HD] += -g[j] * sn + g[j + HD] * cs;
+                    da[s * F * HD + f * HD + j] += g[j + HD] * q[j] - g[j] * q[j + HD];
+                }
+            }
+#pragma unroll
+            for (int c = 0; c < CH; c++) dqkv[(int64_t) rs * 3 * D + h * CH + c] = dq[c];
+        }
+        __syncthreads();
+        // pass 2, a key per thread: d k, d v, d bias
+        for (int t = threadIdx.x; t < L; t += blockDim.x) {
+            const int rt = plato_row(off, N, i, t);
+            float dk[CH], dv[CH], dbt = 0.0f;
+#pragma unroll
+            for (int c = 0; c < CH; c++) dk[c] = 0.0f, dv[c] = 0.0f;
+#pragma unroll 1
+            for (int f = 0; f < F; f++) {
+                const float * k = kr + (f * L + t) * CH;
+                float g[CH];
+#pragma unroll
+                for (int c = 0; c < CH; c++) g[c] = 0.0f;
+                for (int s = 0; s < L; s++) {
+                    const float * q = qr + (f * L + s) * CH;
+                    float a = 0.0f, dP = 0.0f;
+#pragma unroll
+                    for (int c = 0; c < CH; c++) a += q[c] * k[c], dP += gs[s * CH + c] * vs[t * CH + c];
+                    const float * st = mz + (f * L + s) * 3;
+                    const float wp = fw.w[f] * expf(scale * a + bs[t] - st[0]) * st[1];
+                    const float dd = wp * (dP - st[2]);
+                    dbt += dd;
+#pragma unroll
+                    for (int c = 0; c < CH; c++) g[c] += scale * dd * q[c], dv[c] += wp * gs[s * CH + c];
+                }
+                const float * an = ang + (int64_t) rt * F * HD + f * HD;
+#pragma unroll
+                for (int j = 0; j < HD; j++) {
+                    float sn, cs;
+                    sincosf(an[j], &sn, &cs);
+                    dk[j] += g[j] * cs + g[j + HD] * sn, dk[j + HD] += -g[j] * sn + g[j + HD] * cs;
+                    da[t * F * HD + f * HD + j] += g[j + HD] * k[j] - g[j] * k[j + HD];
+                }
+            }
+#pragma unroll
+            for (int c = 0; c < CH; c++) {
+                dqkv[(int64_t) rt * 3 * D + D + h * CH + c] = dk[c];
+                dqkv[(int64_t) rt * 3 * D + 2 * D + h * CH + c] = dv[c];
+            }
+            db[t] += dbt;
+        }
+    }
+    __syncthreads();
+    for (int e = threadIdx.x; e < L * F * HD; e += blockDim.x) {
+        const int t = e / (F * HD), r = e % (F * HD);
+        dang[(int64_t) plato_row(off, N, i, t) * F * HD + r] = da[e];
+    }
+    for (int t = threadIdx.x; t < L; t += blockDim.x) {
+        const int r = plato_row(off, N, i, t);
+        if (r >= N) dbias[r - N] = db[t];
+    }
+}
+
+size_t plato_attn_smem(int CH, int F, int L, bool back) {
+    const int HD = CH / 2;
+    return sizeof(float) * (back ? (size_t) 2 * F * L * CH + 2 * L * CH + 3 * F * L + L * F * HD + 2 * L
+                                 : (size_t) F * L * CH + L * CH + L);
+}
+
+template <int CH, int F>
+void plato_attn_launch(ggml_backend_cuda_context & ctx, ggml_tensor * dst, bool back) {
+    const plato_attn_cu a = plato_attn_cu_get(dst);
+    cudaStream_t st = ctx.stream();
+    const int L = a.max_len;
+    const int threads = std::min(256, std::max(32, (L + 31) / 32 * 32));
+    const size_t smem = plato_attn_smem(CH, F, L, back);
+    const float * qkv = (const float *) dst->src[0]->data, * ang = (const float *) dst->src[1]->data,
+                * bias = (const float *) dst->src[2]->data;
+    const int * off = (const int *) dst->src[3]->data;
+    CUDA_CHECK(cudaMemsetAsync(dst->data, 0, ggml_nbytes(dst), st));
+    if (a.N == 0) return;
+    if (!back) {
+        if (smem > 48 * 1024)
+            CUDA_CHECK(cudaFuncSetAttribute(plato_attn_fwd<CH, F>, cudaFuncAttributeMaxDynamicSharedMemorySize, (int) smem));
+        plato_attn_fwd<CH, F><<<a.N, threads, smem, st>>>(qkv, ang, bias, off, (float *) dst->data, a.N, a.D, a.H, a.scale, a.w);
+    } else {
+        if (smem > 48 * 1024)
+            CUDA_CHECK(cudaFuncSetAttribute(plato_attn_bwd<CH, F>, cudaFuncAttributeMaxDynamicSharedMemorySize, (int) smem));
+        float * dqkv = (float *) dst->data, * dang = dqkv + (int64_t) 3 * a.D * a.T,
+              * dbias = dang + ggml_nelements(dst->src[1]);
+        plato_attn_bwd<CH, F><<<a.N, threads, smem, st>>>(qkv, ang, bias, off, (const float *) dst->src[4]->data, dqkv, dang,
+                                                         dbias, a.N, a.D, a.H, a.scale, a.w);
+    }
+    CUDA_CHECK(cudaGetLastError());
+}
+
+template <int CH>
+bool plato_attn_dispatch_f(ggml_backend_cuda_context & ctx, ggml_tensor * dst, bool back, int F) {
+    switch (F) {
+        case 1:  plato_attn_launch<CH, 1>(ctx, dst, back);  return true;
+        case 3:  plato_attn_launch<CH, 3>(ctx, dst, back);  return true;
+        case 4:  plato_attn_launch<CH, 4>(ctx, dst, back);  return true;
+        case 6:  plato_attn_launch<CH, 6>(ctx, dst, back);  return true;
+        case 12: plato_attn_launch<CH, 12>(ctx, dst, back); return true;
+        default: return false;
+    }
+}
+
+void plato_attn_dispatch(ggml_backend_cuda_context & ctx, ggml_tensor * dst, bool back) {
+    const plato_attn_cu a = plato_attn_cu_get(dst);
+    bool ok = false;
+    switch (a.d) {
+        case 8:  ok = plato_attn_dispatch_f<8>(ctx, dst, back, a.F);  break;
+        case 16: ok = plato_attn_dispatch_f<16>(ctx, dst, back, a.F); break;
+        case 32: ok = plato_attn_dispatch_f<32>(ctx, dst, back, a.F); break;
+        default: break;
+    }
+    GGML_ASSERT(ok && "plato_attn: unsupported head size or frame count");
+}
+
+// ---------------------------------------------------------------------------
+// FFTs (cuFFT plans cached per device and shape)
+
+struct plato_plans {
+    std::mutex mu;
+    std::map<std::tuple<int, int, int, int, int, int64_t>, cufftHandle> plans;
+};
+plato_plans & plato_plan_cache() {
+    static plato_plans p;
+    return p;
+}
+
+void cufft_check(cufftResult r, const char * what) {
+    if (r != CUFFT_SUCCESS) GGML_ABORT("cuFFT error %d in %s", (int) r, what);
+}
+
+// kind 0: R2C 3-D, batch C; 1: C2C 2-D over (M0, M1), stride Mh, batch Mh; 2: C2R 1-D along M2, batch C M0 M1
+cufftHandle plato_plan(int device, int kind, int M0, int M1, int M2, int64_t C) {
+    plato_plans & cache = plato_plan_cache();
+    std::lock_guard<std::mutex> lock(cache.mu);
+    auto key = std::make_tuple(device, kind, M0, M1, M2, C);
+    auto it = cache.plans.find(key);
+    if (it != cache.plans.end()) return it->second;
+    cufftHandle p;
+    const int Mh = M2 / 2 + 1;
+    if (kind == 0) {
+        int n[3] = {M0, M1, M2};
+        cufft_check(cufftPlanMany(&p, 3, n, nullptr, 1, M0 * M1 * M2, nullptr, 1, M0 * M1 * Mh, CUFFT_R2C, (int) C), "plan r2c");
+    } else if (kind == 1) {
+        int n[2] = {M0, M1};
+        cufft_check(cufftPlanMany(&p, 2, n, n, Mh, 1, n, Mh, 1, CUFFT_C2C, Mh), "plan c2c");
+    } else if (kind == 2) {
+        int n[1] = {M2}, in[1] = {Mh}, on[1] = {M2};
+        cufft_check(cufftPlanMany(&p, 1, n, in, 1, Mh, on, 1, M2, CUFFT_C2R, (int) (C * M0 * M1)), "plan c2r");
+    } else {
+        int n[3] = {M0, M1, M2};
+        cufft_check(cufftPlanMany(&p, 3, n, nullptr, 1, M0 * M1 * Mh, nullptr, 1, M0 * M1 * M2, CUFFT_C2R, (int) C), "plan c2r 3d");
+    }
+    cache.plans[key] = p;
+    return p;
+}
+
+// the scale of bin m2 (complex layout [.., Mh]): c(m2) = 2 inside the half spectrum
+__device__ __forceinline__ float plato_cfac(int m2, int M2) { return (m2 > 0 && 2 * m2 < M2) ? 2.0f : 1.0f; }
+
+__global__ void plato_fft_scale(const float2 * __restrict__ x, float2 * __restrict__ y, int64_t n, int Mh, int M2, int mode, float invN) {
+    const int64_t e = (int64_t) blockIdx.x * blockDim.x + threadIdx.x;
+    if (e >= n) return;
+    const int m2 = (int) (e % Mh);
+    float s;
+    if (mode == 1) s = invN;                              // irfftn input
+    else if (mode == 3) s = 1.0f / plato_cfac(m2, M2);    // adjoint of rfftn input
+    else s = plato_cfac(m2, M2) * invN;                   // mode 2 output
+    float2 v = x[e];
+    y[e] = make_float2(s * v.x, s * v.y);
+}
+
+// the real parts of the self-conjugate bins of the last axis before the c2r pass
+__global__ void plato_fft_real_bins(float2 * __restrict__ y, int64_t lines, int Mh, int M2) {
+    const int64_t l = (int64_t) blockIdx.x * blockDim.x + threadIdx.x;
+    if (l >= lines) return;
+    y[l * Mh].y = 0.0f;
+    if (M2 % 2 == 0) y[l * Mh + M2 / 2].y = 0.0f;
+}
+
+// ---------------------------------------------------------------------------
+// B-spline assignment
+
+__device__ __forceinline__ void plato_bspline_cu(float u, int K, int idx[4], float w[4], float dw[4]) {
+    const float fl = floorf(u), t = u - fl;
+    const int i0 = (int) fl;
+    const float t2 = t * t, t3 = t2 * t, s = 1.0f - t;
+    w[0] = s * s * s / 6.0f;
+    w[1] = (3.0f * t3 - 6.0f * t2 + 4.0f) / 6.0f;
+    w[2] = (-3.0f * t3 + 3.0f * t2 + 3.0f * t + 1.0f) / 6.0f;
+    w[3] = t3 / 6.0f;
+    dw[0] = -0.5f * s * s;
+    dw[1] = 1.5f * t2 - 2.0f * t;
+    dw[2] = -1.5f * t2 + t + 0.5f;
+    dw[3] = 0.5f * t2;
+#pragma unroll
+    for (int k = 0; k < 4; k++) idx[k] = (((i0 + k - 1) % K) + K) % K;
+}
+
+// a thread per (atom, stencil point)
+__global__ void plato_spread_k(const float * __restrict__ v, const float * __restrict__ frac, const int * __restrict__ blk,
+                               float * __restrict__ rho, int n, int C, int M0, int M1, int M2) {
+    const int64_t e = (int64_t) blockIdx.x * blockDim.x + threadIdx.x;
+    if (e >= (int64_t) n * 64) return;
+    const int a = (int) (e / 64), s = (int) (e % 64), x = s / 16, y = (s / 4) % 4, z = s % 4;
+    int ix[4], iy[4], iz[4];
+    float wx[4], wy[4], wz[4], d[4];
+    plato_bspline_cu(frac[3 * a + 0] * (float) M0, M0, ix, wx, d);
+    plato_bspline_cu(frac[3 * a + 1] * (float) M1, M1, iy, wy, d);
+    plato_bspline_cu(frac[3 * a + 2] * (float) M2, M2, iz, wz, d);
+    const float w = wx[x] * wy[y] * wz[z];
+    const int64_t idx = ((int64_t) ix[x] * M1 + iy[y]) * M2 + iz[z], M = (int64_t) M0 * M1 * M2;
+    const int64_t c0 = (int64_t) (blk ? blk[a] : 0) * C;
+    for (int c = 0; c < C; c++) atomicAdd(rho + (c0 + c) * M + idx, w * v[(int64_t) a * C + c]);
+}
+
+// a thread per (atom, channel)
+__global__ void plato_gather_k(const float * __restrict__ phi, const float * __restrict__ frac, const int * __restrict__ blk,
+                               float * __restrict__ out, int n, int C, int M0, int M1, int M2, int deriv) {
+    const int64_t e = (int64_t) blockIdx.x * blockDim.x + threadIdx.x;
+    if (e >= (int64_t) n * C) return;
+    const int a = (int) (e / C), c = (int) (e % C);
+    int ix[4], iy[4], iz[4];
+    float wx[4], wy[4], wz[4], dx[4], dy[4], dz[4];
+    plato_bspline_cu(frac[3 * a + 0] * (float) M0, M0, ix, wx, dx);
+    plato_bspline_cu(frac[3 * a + 1] * (float) M1, M1, iy, wy, dy);
+    plato_bspline_cu(frac[3 * a + 2] * (float) M2, M2, iz, wz, dz);
+    const float * m = phi + ((int64_t) (blk ? blk[a] : 0) * C + c) * M0 * M1 * M2;
+    float acc = 0.0f, g0 = 0.0f, g1 = 0.0f, g2 = 0.0f;
+    for (int x = 0; x < 4; x++)
+        for (int y = 0; y < 4; y++) {
+            const float * row = m + ((int64_t) ix[x] * M1 + iy[y]) * M2;
+#pragma unroll
+            for (int z = 0; z < 4; z++) {
+                const float p = row[iz[z]];
+                if (!deriv) acc += wx[x] * wy[y] * wz[z] * p;
+                else {
+                    g0 += dx[x] * wy[y] * wz[z] * p;
+                    g1 += wx[x] * dy[y] * wz[z] * p;
+                    g2 += wx[x] * wy[y] * dz[z] * p;
+                }
+            }
+        }
+    if (!deriv) out[(int64_t) a * C + c] = acc;
+    else {
+        out[((int64_t) a * 3 + 0) * C + c] = g0 * (float) M0;
+        out[((int64_t) a * 3 + 1) * C + c] = g1 * (float) M1;
+        out[((int64_t) a * 3 + 2) * C + c] = g2 * (float) M2;
+    }
+}
+
+// structure factors: a thread per (k, structure); the atoms of structure g are those
+// of the range of g in the (sorted) structure index, found per block
+__global__ void plato_ewald_k(const float * __restrict__ frac, const float * __restrict__ q, const int * __restrict__ sidx,
+                              const float * __restrict__ kn, float * __restrict__ out, int n, int nk, int G) {
+    const int g = blockIdx.y;
+    __shared__ int range[2];
+    if (threadIdx.x == 0) {
+        int lo = 0, hi = n;
+        if (sidx) {
+            int a = 0, b = n; // lower bound of g
+            while (a < b) { const int m = (a + b) / 2; if (sidx[m] < g) a = m + 1; else b = m; }
+            lo = a, b = n;
+            while (a < b) { const int m = (a + b) / 2; if (sidx[m] <= g) a = m + 1; else b = m; }
+            hi = a;
+        }
+        range[0] = lo, range[1] = hi;
+    }
+    __syncthreads();
+    const int k = blockIdx.x * blockDim.x + threadIdx.x;
+    if (k >= nk) return;
+    const float n0 = kn[3 * k], n1 = kn[3 * k + 1], n2 = kn[3 * k + 2];
+    float C = 0.0f, S = 0.0f;
+    for (int i = range[0]; i < range[1]; i++) {
+        float s, c;
+        sincosf(frac[3 * i] * n0 + frac[3 * i + 1] * n1 + frac[3 * i + 2] * n2, &s, &c);
+        C += q[i] * c, S += q[i] * s;
+    }
+    out[(int64_t) g * nk + k] = C, out[(int64_t) (G + g) * nk + k] = S, out[(int64_t) (2 * G + g) * nk + k] = C * C + S * S;
+}
+
+// its gradient: a block per atom, the k vectors over the threads, a block reduction
+__global__ void plato_ewald_back_k(const float * __restrict__ frac, const float * __restrict__ q, const int * __restrict__ sidx,
+                                   const float * __restrict__ kn, const float * __restrict__ R, const float * __restrict__ dR,
+                                   float * __restrict__ dq, float * __restrict__ df, int n, int nk, int G) {
+    const int i = blockIdx.x, g = sidx ? sidx[i] : 0;
+    const float * C = R + (int64_t) g * nk, * S = R + (int64_t) (G + g) * nk, * dP = dR + (int64_t) (2 * G + g) * nk;
+    const float f0 = frac[3 * i], f1 = frac[3 * i + 1], f2 = frac[3 * i + 2], qi = q[i];
+    float aq = 0.0f, a0 = 0.0f, a1 = 0.0f, a2 = 0.0f;
+    for (int k = threadIdx.x; k < nk; k += blockDim.x) {
+        const float k0 = kn[3 * k], k1 = kn[3 * k + 1], k2 = kn[3 * k + 2];
+        float s, c;
+        sincosf(f0 * k0 + f1 * k1 + f2 * k2, &s, &c);
+        const float d = 2.0f * dP[k];
+        aq += d * (C[k] * c + S[k] * s);
+        const float t = d * qi * (S[k] * c - C[k] * s);
+        a0 += t * k0, a1 += t * k1, a2 += t * k2;
+    }
+    __shared__ float red[4][32];
+    const int lane = threadIdx.x % 32, warp = threadIdx.x / 32;
+    float v[4] = {aq, a0, a1, a2};
+#pragma unroll
+    for (int j = 0; j < 4; j++) {
+        for (int o = 16; o > 0; o >>= 1) v[j] += __shfl_xor_sync(0xffffffff, v[j], o);
+        if (lane == 0) red[j][warp] = v[j];
+    }
+    __syncthreads();
+    if (warp == 0) {
+#pragma unroll
+        for (int j = 0; j < 4; j++) {
+            float x = lane < (int) (blockDim.x / 32) ? red[j][lane] : 0.0f;
+            for (int o = 16; o > 0; o >>= 1) x += __shfl_xor_sync(0xffffffff, x, o);
+            v[j] = x;
+        }
+        if (lane == 0) dq[i] = v[0], df[3 * i] = v[1], df[3 * i + 1] = v[2], df[3 * i + 2] = v[3];
+    }
+}
+
+__global__ void plato_erf_k(const float * __restrict__ x, float * __restrict__ y, int64_t n) {
+    const int64_t e = (int64_t) blockIdx.x * blockDim.x + threadIdx.x;
+    if (e < n) y[e] = erff(x[e]);
+}
+
+int plato_blocks(int64_t n, int t) { return (int) ((n + t - 1) / t); }
+
+} // namespace
+
+bool ggml_cuda_plato_supported(const ggml_tensor * op) {
+      for (int i = 0; i < GGML_MAX_SRC; i++)
+        if (op->src[i] && !ggml_is_contiguous(op->src[i])) return false;
+    switch (op->op) {
+        case GGML_OP_PLATO_ATTN:
+        case GGML_OP_PLATO_ATTN_BACK: {
+            const plato_attn_cu a = plato_attn_cu_get(op);
+            if (a.d != 8 && a.d != 16 && a.d != 32) return false;
+            if (a.F != 1 && a.F != 3 && a.F != 4 && a.F != 6 && a.F != 12) return false;
+            return plato_attn_smem(a.d, a.F, a.max_len, op->op == GGML_OP_PLATO_ATTN_BACK) <= 220 * 1024;
+        }
+        case GGML_OP_PLATO_FFT3:
+        case GGML_OP_PLATO_SPREAD:
+        case GGML_OP_PLATO_GATHER:
+        case GGML_OP_PLATO_ERF:
+        case GGML_OP_PLATO_EWALD:
+        case GGML_OP_PLATO_EWALD_BACK:
+            return op->src[0]->type == GGML_TYPE_F32;
+        default:
+            return false;
+    }
+}
+
+void ggml_cuda_op_plato_attn(ggml_backend_cuda_context & ctx, ggml_tensor * dst) { plato_attn_dispatch(ctx, dst, false); }
+void ggml_cuda_op_plato_attn_back(ggml_backend_cuda_context & ctx, ggml_tensor * dst) { plato_attn_dispatch(ctx, dst, true); }
+
+void ggml_cuda_op_plato_fft3(ggml_backend_cuda_context & ctx, ggml_tensor * dst) {
+    const int32_t * p = (const int32_t *) dst->op_params;
+    const int mode = p[0], M0 = p[1], M1 = p[2], M2 = p[3], Mh = M2 / 2 + 1;
+    const int64_t N = (int64_t) M0 * M1 * M2, NH = (int64_t) M0 * M1 * Mh;
+    const bool fwd = mode == 0 || mode == 2;
+    const int64_t C = fwd ? ggml_nelements(dst->src[0]) / N : ggml_nelements(dst) / N;
+    cudaStream_t st = ctx.stream();
+    const float invN = 1.0f / (float) N;
+    if (fwd) {
+        cufftHandle plan = plato_plan(ctx.device, 0, M0, M1, M2, C);
+        cufft_check(cufftSetStream(plan, st), "stream");
+        cufft_check(cufftExecR2C(plan, (cufftReal *) dst->src[0]->data, (cufftComplex *) dst->data), "r2c");
+        if (mode == 2)
+            plato_fft_scale<<<plato_blocks(C * NH, 256), 256, 0, st>>>((const float2 *) dst->data, (float2 *) dst->data, C * NH, Mh,
+                                                                        M2, 2, invN);
+    } else {
+        ggml_cuda_pool_alloc<float2> tmp(ctx.pool(), C * NH);
+        plato_fft_scale<<<plato_blocks(C * NH, 256), 256, 0, st>>>((const float2 *) dst->src[0]->data, tmp.get(), C * NH, Mh, M2, mode,
+                                                                    invN);
+        // one batched 3-D C2R (GGML_PLATO_FFT_EXACT_C2R=1: complex passes over axes 0, 1 per channel,
+        // then the real parts of the self-conjugate bins and a 1-D C2R, the CPU's semantics for
+        // half spectra that are not Hermitian; the same for those of real data under a filter
+        // symmetric in k, which is what the mesh coupling and its gradients pass)
+        static const bool exact = getenv("GGML_PLATO_FFT_EXACT_C2R") != nullptr;
+        if (!exact) {
+            cufftHandle p3 = plato_plan(ctx.device, 3, M0, M1, M2, C);
+            cufft_check(cufftSetStream(p3, st), "stream");
+            cufft_check(cufftExecC2R(p3, (cufftComplex *) tmp.get(), (cufftReal *) dst->data), "c2r 3d");
+            CUDA_CHECK(cudaGetLastError());
+            return;
+        }
+        cufftHandle p2 = plato_plan(ctx.device, 1, M0, M1, M2, C);
+        cufft_check(cufftSetStream(p2, st), "stream");
+        for (int64_t c = 0; c < C; c++)
+            cufft_check(cufftExecC2C(p2, (cufftComplex *) (tmp.get() + c * NH), (cufftComplex *) (tmp.get() + c * NH), CUFFT_INVERSE),
+                        "c2c");
+        plato_fft_real_bins<<<plato_blocks(C * M0 * M1, 256), 256, 0, st>>>(tmp.get(), C * M0 * M1, Mh, M2);
+        cufftHandle p1 = plato_plan(ctx.device, 2, M0, M1, M2, C);
+        cufft_check(cufftSetStream(p1, st), "stream");
+        cufft_check(cufftExecC2R(p1, (cufftComplex *) tmp.get(), (cufftReal *) dst->data), "c2r");
+    }
+    CUDA_CHECK(cudaGetLastError());
+}
+
+void ggml_cuda_op_plato_spread(ggml_backend_cuda_context & ctx, ggml_tensor * dst) {
+    const int C = (int) dst->src[0]->ne[0], n = (int) ggml_nrows(dst->src[1]);
+    const int M2 = (int) dst->ne[0], M1 = (int) dst->ne[1], M0 = (int) dst->ne[2];
+    cudaStream_t st = ctx.stream();
+    CUDA_CHECK(cudaMemsetAsync(dst->data, 0, ggml_nbytes(dst), st));
+    if (n == 0) return;
+    plato_spread_k<<<plato_blocks((int64_t) n * 64, 256), 256, 0, st>>>(
+        (const float *) dst->src[0]->data, (const float *) dst->src[1]->data,
+        dst->src[2] ? (const int *) dst->src[2]->data : nullptr, (float *) dst->data, n, C, M0, M1, M2);
+    CUDA_CHECK(cudaGetLastError());
+}
+
+void ggml_cuda_op_plato_gather(ggml_backend_cuda_context & ctx, ggml_tensor * dst) {
+    const ggml_tensor * mesh = dst->src[0];
+    const int M2 = (int) mesh->ne[0], M1 = (int) mesh->ne[1], M0 = (int) mesh->ne[2], C = ggml_get_op_params_i32(dst, 1);
+    const int n = (int) ggml_nrows(dst->src[1]);
+    if (n == 0) return;
+    plato_gather_k<<<plato_blocks((int64_t) n * C, 128), 128, 0, ctx.stream()>>>(
+        (const float *) mesh->data, (const float *) dst->src[1]->data, dst->src[2] ? (const int *) dst->src[2]->data : nullptr,
+        (float *) dst->data, n, C, M0, M1, M2, ggml_get_op_params_i32(dst, 0));
+    CUDA_CHECK(cudaGetLastError());
+}
+
+void ggml_cuda_op_plato_erf(ggml_backend_cuda_context & ctx, ggml_tensor * dst) {
+    const int64_t n = ggml_nelements(dst);
+    plato_erf_k<<<plato_blocks(n, 256), 256, 0, ctx.stream()>>>((const float *) dst->src[0]->data, (float *) dst->data, n);
+    CUDA_CHECK(cudaGetLastError());
+}
+
+void ggml_cuda_op_plato_ewald(ggml_backend_cuda_context & ctx, ggml_tensor * dst) {
+    const int n = (int) ggml_nelements(dst->src[1]), nk = (int) dst->ne[0], G = (int) dst->ne[1];
+    const int * sidx = dst->src[2] ? (const int *) dst->src[2]->data : nullptr;
+    plato_ewald_k<<<dim3(plato_blocks(nk, 256), G), 256, 0, ctx.stream()>>>((const float *) dst->src[0]->data,
+        (const float *) dst->src[1]->data, sidx, (const float *) dst->src[3]->data, (float *) dst->data, n, nk, G);
+    CUDA_CHECK(cudaGetLastError());
+}
+
+void ggml_cuda_op_plato_ewald_back(ggml_backend_cuda_context & ctx, ggml_tensor * dst) {
+    const ggml_tensor * res = dst->src[4];
+    const int n = (int) ggml_nelements(dst->src[1]), nk = (int) res->ne[0], G = (int) res->ne[1];
+    const int * sidx = dst->src[2] ? (const int *) dst->src[2]->data : nullptr;
+    float * dq = (float *) dst->data;
+    if (n == 0) return;
+    plato_ewald_back_k<<<n, 256, 0, ctx.stream()>>>((const float *) dst->src[0]->data, (const float *) dst->src[1]->data, sidx,
+        (const float *) dst->src[3]->data, (const float *) res->data, (const float *) dst->src[5]->data, dq, dq + n, n, nk, G);
+    CUDA_CHECK(cudaGetLastError());
+}
