     const int64_t nrows = ggml_nrows(src0);
 
+    if (dst->op_params[GGML_MAX_OP_PARAMS / sizeof(int32_t) - 1] == 1) {
+        sum_rows_f32_f64acc_cuda(src0_d, dst_d, ncols, nrows, stream);
+        return;
+    }
+
     const dim3 block_nums(nrows, 1, 1);
 
     const int id  = ggml_cuda_get_device();
