+// ggml_newton_schulz
+
+struct ggml_tensor * ggml_newton_schulz_multi_coeffs(
+        struct ggml_context * ctx,
+        struct ggml_tensor ** xs,
+        int                   n,
+        int                   steps,
+        const float         * abc) {
+    GGML_ASSERT(n >= 1 && n <= GGML_MAX_SRC && steps >= 0 && steps <= GGML_NS_MAX_STEPS);
+    int64_t ne = 0;
+    for (int i = 0; i < n; i++) {
+        GGML_ASSERT(xs[i]->type == GGML_TYPE_F32 && ggml_is_contiguous(xs[i]) && xs[i]->ne[3] == 1);
+        ne += ggml_nelements(xs[i]);
+    }
+
+    struct ggml_tensor * result = ggml_new_tensor_1d(ctx, GGML_TYPE_F32, ne);
+
+    // op params: steps, then (a, b, c) per iteration
+    int32_t params[1 + 3 * GGML_NS_MAX_STEPS] = { steps };
+    memcpy(params + 1, abc, 3 * steps * sizeof(float));
+    ggml_set_op_params(result, params, sizeof(params));
+
+    result->op = GGML_OP_NEWTON_SCHULZ;
+    for (int i = 0; i < n; i++) result->src[i] = xs[i];
+
+    return result;
+}
+
+struct ggml_tensor * ggml_newton_schulz_multi(
+        struct ggml_context * ctx,
+        struct ggml_tensor ** xs,
+        int                   n,
+        int                   steps,
+        float                 a,
+        float                 b,
+        float                 c) {
+    float abc[3 * GGML_NS_MAX_STEPS];
+    for (int i = 0; i < steps && i < GGML_NS_MAX_STEPS; i++) abc[3 * i] = a, abc[3 * i + 1] = b, abc[3 * i + 2] = c;
+    return ggml_newton_schulz_multi_coeffs(ctx, xs, n, steps, abc);
+}
+
+struct ggml_tensor * ggml_newton_schulz(
+        struct ggml_context * ctx,
+        struct ggml_tensor  * x,
+        int                   steps,
+        float                 a,
+        float                 b,
+        float                 c) {
+    return ggml_reshape(ctx, ggml_newton_schulz_multi(ctx, &x, 1, steps, a, b, c), x);
+}
