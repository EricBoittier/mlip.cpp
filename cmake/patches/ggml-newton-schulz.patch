diff --git a/src/ggml-cuda/newton-schulz.cu b/src/ggml-cuda/newton-schulz.cu
new file mode 100644
index 0000000..fe798a5
--- /dev/null
+++ b/src/ggml-cuda/newton-schulz.cu
@@ -0,0 +1,226 @@
+#include "newton-schulz.cuh"
+
+#include <cuda_bf16.h>
+
+#include <cstdlib>
+#include <vector>
+
+// The groups of one GGML_OP_NEWTON_SCHULZ (src[g]: k[g] stacked ne0 x ne1
+// matrices), by value into the kernels. Matrices are numbered globally:
+// group g holds [first[g], first[g + 1]); X / dst and G / B are the
+// concatenation of the groups (offsets xoff / goff, in elements).
+struct ns_groups {
+    int           n;
+    const float * src[GGML_MAX_SRC];
+    int64_t       mat[GGML_MAX_SRC];  // elements per matrix: ne0 ne1
+    int64_t       gram[GGML_MAX_SRC]; // elements per Gram matrix: s^2
+    int64_t       s[GGML_MAX_SRC];    // Gram size (the shorter side)
+    int64_t       xoff[GGML_MAX_SRC], goff[GGML_MAX_SRC + 1];
+    int           first[GGML_MAX_SRC + 1];
+};
+
+static __device__ int ns_group_of_matrix(const ns_groups & g, const int m) {
+    int i = 0;
+    while (i + 1 < g.n && m >= g.first[i + 1]) i++;
+    return i;
+}
+
+// X = src / (|src|_F + 1e-7) in the storage type, one block per matrix
+template <typename T>
+static __global__ void k_ns_normalize(const ns_groups g, T * X) {
+    const int     gi = ns_group_of_matrix(g, blockIdx.x);
+    const int64_t n  = g.mat[gi], j = blockIdx.x - g.first[gi];
+    const float * s  = g.src[gi] + j * n;
+    T           * d  = X + g.xoff[gi] + j * n;
+    float acc = 0.0f;
+    for (int64_t i = threadIdx.x; i < n; i += blockDim.x) acc += s[i] * s[i];
+    __shared__ float part[32];
+    acc = warp_reduce_sum(acc);
+    if (threadIdx.x % WARP_SIZE == 0) part[threadIdx.x / WARP_SIZE] = acc;
+    __syncthreads();
+    if (threadIdx.x < WARP_SIZE) {
+        acc = threadIdx.x < blockDim.x / WARP_SIZE ? part[threadIdx.x] : 0.0f;
+        acc = warp_reduce_sum(acc);
+        if (threadIdx.x == 0) part[0] = acc;
+    }
+    __syncthreads();
+    const float inv = 1.0f / (sqrtf(part[0]) + 1e-7f);
+    for (int64_t i = threadIdx.x; i < n; i += blockDim.x) d[i] = T(s[i] * inv);
+}
+
+// B = b G + a I over every Gram matrix of every group (the GEMM then adds c G^2)
+template <typename T>
+static __global__ void k_ns_init_b(const ns_groups g, const T * G, T * B, const float a, const float b) {
+    const int64_t e = blockIdx.x * (int64_t) blockDim.x + threadIdx.x;
+    if (e >= g.goff[g.n]) return;
+    int gi = 0;
+    while (gi + 1 < g.n && e >= g.goff[gi + 1]) gi++;
+    const int64_t r = (e - g.goff[gi]) % g.gram[gi];
+    B[e] = T(b * float(G[e]) + (r % (g.s[gi] + 1) == 0 ? a : 0.0f));
+}
+
+template <typename T>
+static __global__ void k_ns_to_f32(const T * X, float * dst, const int64_t n) {
+    const int64_t i = blockIdx.x * (int64_t) blockDim.x + threadIdx.x;
+    if (i < n) dst[i] = float(X[i]);
+}
+
+// One GEMM stage: per group, k strided matrices C = alpha op(A) op(B) + beta C
+struct ns_gemm {
+    cublasOperation_t ta, tb;
+    int               m, n, k, lda, ldb, ldc, count;
+    const void *      A; const void * B; void * C;
+    int64_t           sA, sB, sC; // strides in elements
+    float             alpha, beta;
+};
+
+// device pointer arrays of a grouped GEMM: per matrix j of group i
+struct ns_ptr_job {
+    int      n, first[GGML_MAX_SRC + 1];
+    char *   A[GGML_MAX_SRC]; char * B[GGML_MAX_SRC]; char * C[GGML_MAX_SRC];
+    int64_t  sA[GGML_MAX_SRC], sB[GGML_MAX_SRC], sC[GGML_MAX_SRC]; // bytes
+};
+
+static __global__ void k_ns_ptrs(const ns_ptr_job job, const void ** A, const void ** B, void ** C) {
+    const int j = blockIdx.x * blockDim.x + threadIdx.x;
+    if (j >= job.first[job.n]) return;
+    int gi = 0;
+    while (gi + 1 < job.n && j >= job.first[gi + 1]) gi++;
+    const int64_t q = j - job.first[gi];
+    A[j] = job.A[gi] + q * job.sA[gi];
+    B[j] = job.B[gi] + q * job.sB[gi];
+    C[j] = job.C[gi] + q * job.sC[gi];
+}
+
+bool ggml_cuda_newton_schulz_supported(const ggml_tensor * op) {
+    for (int i = 0; i < GGML_MAX_SRC && op->src[i]; i++) {
+        const ggml_tensor * x = op->src[i];
+        if (x->type != GGML_TYPE_F32 || !ggml_is_contiguous(x) || x->ne[3] != 1) return false;
+    }
+    return true;
+}
+
+// Quintic Newton-Schulz on every matrix of every src (ggml ne0 x ne1 =
+// PyTorch rows ne1, cols ne0; column-major M = X^T with leading dimension
+// ne0). Gram over the shorter side, and the update folded into one GEMM:
+//   wide (ne1 <= ne0): G = M^T M, B = c G^2 + b G + a I, M' = M B
+//   tall (ne1 >  ne0): G = M M^T, B = c G^2 + b G + a I, M' = B M
+// X, G and B are stored in bf16 (fp32 accumulation, as Muon's reference);
+// GGML_NS_F32=1: fp32 storage with TF32 GEMMs (full FP32 with
+// GGML_CUDA_NO_TF32=1). Each stage is one grouped cuBLAS GEMM over all the
+// srcs (cublasGemmGroupedBatchedEx); GGML_NS_LOOP=1: one strided-batched
+// GEMM per src instead.
+template <typename T>
+static void ns_run(ggml_backend_cuda_context & ctx, ggml_tensor * dst, const ns_groups & g, const int64_t xtot) {
+    const int steps = ggml_get_op_params_i32(dst, 0); // then (a, b, c) per iteration
+    constexpr bool bf16 = std::is_same<T, nv_bfloat16>::value;
+    const cudaDataType_t dtype = bf16 ? CUDA_R_16BF : CUDA_R_32F;
+    static const cublasComputeType_t compute =
+        bf16 ? CUBLAS_COMPUTE_32F : getenv("GGML_CUDA_NO_TF32") ? CUBLAS_COMPUTE_32F : CUBLAS_COMPUTE_32F_FAST_TF32;
+    static const bool loop = getenv("GGML_NS_LOOP") != nullptr;
+
+    cudaStream_t   stream = ctx.stream();
+    cublasHandle_t handle = ctx.cublas_handle();
+    CUBLAS_CHECK(cublasSetStream(handle, stream));
+
+    const int64_t gtot = g.goff[g.n];
+    const int     nmat = g.first[g.n];
+    ggml_cuda_pool_alloc<T> X0(ctx.pool(), xtot), X1(ctx.pool(), xtot), G(ctx.pool(), gtot), B(ctx.pool(), gtot);
+    T * X[2] = { X0.get(), X1.get() };
+
+    // the stages: Gram (X[p] -> G) and update (X[p], B -> X[1 - p]) for both
+    // parities p, and B += c G G
+    auto stage = [&](int kind, int p) {
+        std::vector<ns_gemm> v;
+        for (int i = 0; i < g.n; i++) {
+            const ggml_tensor * x = dst->src[i];
+            const int  e0 = (int) x->ne[0], e1 = (int) x->ne[1], k = (int) x->ne[2], n = (int) g.s[i];
+            const bool wide = e1 <= e0;
+            T * xp = X[p] + g.xoff[i], * xn = X[1 - p] + g.xoff[i], * gp = G.get() + g.goff[i], * bp = B.get() + g.goff[i];
+            const int64_t sx = g.mat[i], sg = g.gram[i];
+            if (kind == 0) v.push_back(wide ? ns_gemm{ CUBLAS_OP_T, CUBLAS_OP_N, n, n, e0, e0, e0, n, k, xp, xp, gp, sx, sx, sg, 1.0f, 0.0f }
+                                            : ns_gemm{ CUBLAS_OP_N, CUBLAS_OP_T, n, n, e1, e0, e0, n, k, xp, xp, gp, sx, sx, sg, 1.0f, 0.0f });
+            if (kind == 1) v.push_back(ns_gemm{ CUBLAS_OP_N, CUBLAS_OP_N, n, n, n, n, n, n, k, gp, gp, bp, sg, sg, sg, 0.0f, 1.0f }); // alpha: c of the iteration
+            if (kind == 2) v.push_back(wide ? ns_gemm{ CUBLAS_OP_N, CUBLAS_OP_N, e0, e1, e1, e0, n, e0, k, xp, bp, xn, sx, sg, sx, 1.0f, 0.0f }
+                                            : ns_gemm{ CUBLAS_OP_N, CUBLAS_OP_N, e0, e1, e0, n, e0, e0, k, bp, xp, xn, sg, sx, sx, 1.0f, 0.0f });
+        }
+        return v;
+    };
+    // stage index: 0, 1 Gram (parity), 2 B, 3, 4 update (parity)
+    std::vector<ns_gemm> stages[5] = { stage(0, 0), stage(0, 1), stage(1, 0), stage(2, 0), stage(2, 1) };
+
+    // grouped: device pointer arrays for all 5 stages, filled by one kernel each
+    ggml_cuda_pool_alloc<void *> ptrs(ctx.pool(), loop ? 1 : 5 * 3 * nmat);
+    std::vector<int> m, n, k, lda, ldb, ldc, cnt;
+    std::vector<cublasOperation_t> opa, opb;
+    std::vector<float> alpha, beta;
+    if (!loop) {
+        for (int st = 0; st < 5; st++) {
+            ns_ptr_job job{};
+            job.n = g.n;
+            for (int i = 0; i < g.n; i++) {
+                const ns_gemm & q = stages[st][i];
+                job.first[i + 1] = job.first[i] + q.count;
+                job.A[i] = (char *) q.A; job.B[i] = (char *) q.B; job.C[i] = (char *) q.C;
+                job.sA[i] = q.sA * sizeof(T); job.sB[i] = q.sB * sizeof(T); job.sC[i] = q.sC * sizeof(T);
+            }
+            void ** base = ptrs.get() + st * 3 * nmat;
+            k_ns_ptrs<<<(nmat + 63) / 64, 64, 0, stream>>>(job, (const void **) base, (const void **) base + nmat, base + 2 * nmat);
+        }
+    }
+    auto gemm = [&](int st, float c = 0.0f) {
+        std::vector<ns_gemm> & v = stages[st];
+        if (st == 2) for (ns_gemm & q : v) q.alpha = c;
+        if (loop) {
+            for (const ns_gemm & q : v)
+                CUBLAS_CHECK(cublasGemmStridedBatchedEx(handle, q.ta, q.tb, q.m, q.n, q.k, &q.alpha, q.A, dtype, q.lda, q.sA,
+                    q.B, dtype, q.ldb, q.sB, &q.beta, q.C, dtype, q.ldc, q.sC, q.count, compute, CUBLAS_GEMM_DEFAULT));
+            return;
+        }
+        opa.clear(); opb.clear(); m.clear(); n.clear(); k.clear(); lda.clear(); ldb.clear(); ldc.clear(); cnt.clear();
+        alpha.clear(); beta.clear();
+        for (const ns_gemm & q : v) {
+            opa.push_back(q.ta); opb.push_back(q.tb); m.push_back(q.m); n.push_back(q.n); k.push_back(q.k);
+            lda.push_back(q.lda); ldb.push_back(q.ldb); ldc.push_back(q.ldc); cnt.push_back(q.count);
+            alpha.push_back(q.alpha); beta.push_back(q.beta);
+        }
+        void ** base = ptrs.get() + st * 3 * nmat;
+        CUBLAS_CHECK(cublasGemmGroupedBatchedEx(handle, opa.data(), opb.data(), m.data(), n.data(), k.data(), alpha.data(),
+            (const void * const *) base, dtype, lda.data(), (const void * const *) base + nmat, dtype, ldb.data(),
+            beta.data(), base + 2 * nmat, dtype, ldc.data(), g.n, cnt.data(), compute));
+    };
+
+    k_ns_normalize<T><<<nmat, 256, 0, stream>>>(g, X[0]);
+    int p = 0;
+    for (int it = 0; it < steps; it++) {
+        const float a = ggml_get_op_params_f32(dst, 1 + 3 * it), b = ggml_get_op_params_f32(dst, 2 + 3 * it),
+                    c = ggml_get_op_params_f32(dst, 3 + 3 * it);
+        gemm(p);                                                                     // G = Gram(X[p])
+        k_ns_init_b<T><<<(gtot + 255) / 256, 256, 0, stream>>>(g, G.get(), B.get(), a, b); // B = b G + a I
+        gemm(2, c);                                                                  // B += c G G
+        gemm(3 + p);                                                                 // X[1 - p] = X[p] B / B X[p]
+        p = 1 - p;
+    }
+    k_ns_to_f32<T><<<(xtot + 255) / 256, 256, 0, stream>>>(X[p], (float *) dst->data, xtot);
+}
+
+void ggml_cuda_op_newton_schulz(ggml_backend_cuda_context & ctx, ggml_tensor * dst) {
+    ns_groups g{};
+    int64_t xtot = 0;
+    for (int i = 0; i < GGML_MAX_SRC && dst->src[i]; i++) {
+        const ggml_tensor * x = dst->src[i];
+        const int64_t ne0 = x->ne[0], ne1 = x->ne[1], s = ne1 <= ne0 ? ne1 : ne0;
+        g.src[i]       = (const float *) x->data;
+        g.mat[i]       = ne0 * ne1;
+        g.s[i]         = s;
+        g.gram[i]      = s * s;
+        g.xoff[i]      = xtot;
+        g.first[i + 1] = g.first[i] + (int) x->ne[2];
+        g.goff[i + 1]  = g.goff[i] + s * s * x->ne[2];
+        xtot          += ne0 * ne1 * x->ne[2];
+        g.n            = i + 1;
+    }
+    static const bool f32 = getenv("GGML_NS_F32") != nullptr;
+    if (f32) ns_run<float>(ctx, dst, g, xtot);
+    else     ns_run<nv_bfloat16>(ctx, dst, g, xtot);
+}
