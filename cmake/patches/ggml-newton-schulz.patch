+// ggml_newton_schulz
+
+struct ggml_tensor * ggml_newton_schulz(
+        struct ggml_context * ctx,
+        struct ggml_tensor  * x,
+        int                   steps,
+        float                 a,
+        float                 b,
+        float                 c) {
+    GGML_ASSERT(x->type == GGML_TYPE_F32 && ggml_is_contiguous(x) && x->ne[3] == 1 && steps >= 0);
+
+    struct ggml_tensor * result = ggml_new_tensor(ctx, GGML_TYPE_F32, GGML_MAX_DIMS, x->ne);
+
+    int32_t params[4] = { steps, 0, 0, 0 };
+    memcpy(params + 1, &a, sizeof(float));
+    memcpy(params + 2, &b, sizeof(float));
+    memcpy(params + 3, &c, sizeof(float));
+    ggml_set_op_params(result, params, sizeof(params));
+
+    result->op     = GGML_OP_NEWTON_SCHULZ;
+    result->src[0] = x;
+
+    return result;
+}
+
 // ggml_soft_max_ext_back
 
 static struct ggml_tensor * ggml_soft_max_ext_back_impl(
