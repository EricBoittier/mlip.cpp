diff --git a/src/ggml-cuda/newton-schulz.cu b/src/ggml-cuda/newton-schulz.cu
new file mode 100644
index 0000000..da6334c
--- /dev/null
+++ b/src/ggml-cuda/newton-schulz.cu
@@ -0,0 +1,92 @@
+#include "newton-schulz.cuh"
+
+#include <cstdlib>
+
+// dst = src / (|src|_F + 1e-7), one block per matrix
+static __global__ void k_ns_normalize(const float * src, float * dst, const int64_t n) {
+    const float * s = src + blockIdx.x * n;
+    float       * d = dst + blockIdx.x * n;
+    float acc = 0.0f;
+    for (int64_t i = threadIdx.x; i < n; i += blockDim.x) acc += s[i] * s[i];
+    __shared__ float part[32];
+    acc = warp_reduce_sum(acc);
+    if (threadIdx.x % WARP_SIZE == 0) part[threadIdx.x / WARP_SIZE] = acc;
+    __syncthreads();
+    if (threadIdx.x < WARP_SIZE) {
+        acc = threadIdx.x < blockDim.x / WARP_SIZE ? part[threadIdx.x] : 0.0f;
+        acc = warp_reduce_sum(acc);
+        if (threadIdx.x == 0) part[0] = acc;
+    }
+    __syncthreads();
+    const float inv = 1.0f / (sqrtf(part[0]) + 1e-7f);
+    for (int64_t i = threadIdx.x; i < n; i += blockDim.x) d[i] = s[i] * inv;
+}
+
+// B[:, :, i] += a I (n x n matrices)
+static __global__ void k_ns_add_diag(float * B, const int n, const int k, const float a) {
+    const int64_t i = blockIdx.x * (int64_t) blockDim.x + threadIdx.x;
+    if (i >= (int64_t) n * k) return;
+    const int64_t m = i / n, j = i % n;
+    B[m * n * n + j * n + j] += a;
+}
+
+bool ggml_cuda_newton_schulz_supported(const ggml_tensor * op) {
+    const ggml_tensor * x = op->src[0];
+    return x->type == GGML_TYPE_F32 && ggml_is_contiguous(x) && x->ne[3] == 1;
+}
+
+// Quintic Newton-Schulz on each x[:, :, i] (ggml ne0 x ne1 = PyTorch rows ne1,
+// cols ne0; column-major M = X^T with leading dimension ne0). Gram over the
+// shorter side, and the update folded into one GEMM:
+//   wide (ne1 <= ne0): G = M^T M, B = c G^2 + b G + a I, M' = M B
+//   tall (ne1 >  ne0): G = M M^T, B = c G^2 + b G + a I, M' = B M
+// GEMMs are batched over the k matrices; TF32 by default, bf16 tensor cores
+// with GGML_NS_BF16=1, full FP32 with GGML_CUDA_NO_TF32=1.
+void ggml_cuda_op_newton_schulz(ggml_backend_cuda_context & ctx, ggml_tensor * dst) {
+    const ggml_tensor * src = dst->src[0];
+    const int     steps = ggml_get_op_params_i32(dst, 0);
+    const float   a = ggml_get_op_params_f32(dst, 1), b = ggml_get_op_params_f32(dst, 2), c = ggml_get_op_params_f32(dst, 3);
+    const int64_t ne0 = src->ne[0], ne1 = src->ne[1], k = src->ne[2];
+    const bool    wide = ne1 <= ne0;
+    const int64_t n = wide ? ne1 : ne0; // Gram size
+
+    cudaStream_t   stream = ctx.stream();
+    cublasHandle_t handle = ctx.cublas_handle();
+    CUBLAS_CHECK(cublasSetStream(handle, stream));
+
+    static const cublasComputeType_t compute =
+        getenv("GGML_NS_BF16") ? CUBLAS_COMPUTE_32F_FAST_16BF :
+        getenv("GGML_CUDA_NO_TF32") ? CUBLAS_COMPUTE_32F : CUBLAS_COMPUTE_32F_FAST_TF32;
+
+    ggml_cuda_pool_alloc<float> G(ctx.pool(), n * n * k), B(ctx.pool(), n * n * k), Y(ctx.pool(), ne0 * ne1 * k);
+    float * X   = (float *) dst->data;
+    float * Xn  = Y.get();
+    k_ns_normalize<<<k, 256, 0, stream>>>((const float *) src->data, X, ne0 * ne1);
+
+    const float one = 1.0f, zero = 0.0f;
+    const long long sX = ne0 * ne1, sG = n * n;
+    for (int it = 0; it < steps; it++) {
+        if (wide) {
+            CUBLAS_CHECK(cublasGemmStridedBatchedEx(handle, CUBLAS_OP_T, CUBLAS_OP_N, n, n, ne0, &one,
+                X, CUDA_R_32F, ne0, sX, X, CUDA_R_32F, ne0, sX, &zero, G.get(), CUDA_R_32F, n, sG, k, compute, CUBLAS_GEMM_DEFAULT));
+        } else {
+            CUBLAS_CHECK(cublasGemmStridedBatchedEx(handle, CUBLAS_OP_N, CUBLAS_OP_T, n, n, ne1, &one,
+                X, CUDA_R_32F, ne0, sX, X, CUDA_R_32F, ne0, sX, &zero, G.get(), CUDA_R_32F, n, sG, k, compute, CUBLAS_GEMM_DEFAULT));
+        }
+        CUDA_CHECK(cudaMemcpyAsync(B.get(), G.get(), n * n * k * sizeof(float), cudaMemcpyDeviceToDevice, stream));
+        CUBLAS_CHECK(cublasGemmStridedBatchedEx(handle, CUBLAS_OP_N, CUBLAS_OP_N, n, n, n, &c,
+            G.get(), CUDA_R_32F, n, sG, G.get(), CUDA_R_32F, n, sG, &b, B.get(), CUDA_R_32F, n, sG, k, compute, CUBLAS_GEMM_DEFAULT));
+        k_ns_add_diag<<<(n * k + 255) / 256, 256, 0, stream>>>(B.get(), n, k, a);
+        if (wide) {
+            CUBLAS_CHECK(cublasGemmStridedBatchedEx(handle, CUBLAS_OP_N, CUBLAS_OP_N, ne0, ne1, ne1, &one,
+                X, CUDA_R_32F, ne0, sX, B.get(), CUDA_R_32F, n, sG, &zero, Xn, CUDA_R_32F, ne0, sX, k, compute, CUBLAS_GEMM_DEFAULT));
+        } else {
+            CUBLAS_CHECK(cublasGemmStridedBatchedEx(handle, CUBLAS_OP_N, CUBLAS_OP_N, ne0, ne1, ne0, &one,
+                B.get(), CUDA_R_32F, n, sG, X, CUDA_R_32F, ne0, sX, &zero, Xn, CUDA_R_32F, ne0, sX, k, compute, CUBLAS_GEMM_DEFAULT));
+        }
+        std::swap(X, Xn);
+    }
+    if (X != (float *) dst->data) {
+        CUDA_CHECK(cudaMemcpyAsync(dst->data, X, ne0 * ne1 * k * sizeof(float), cudaMemcpyDeviceToDevice, stream));
+    }
+}
