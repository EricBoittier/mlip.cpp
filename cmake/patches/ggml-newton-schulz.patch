+// ggml_compute_forward_newton_schulz: reference implementation (thread 0),
+// same algebra as the CUDA kernel (column-major M = X^T, Gram over the
+// shorter side, B = c G^2 + b G + a I folded into one product)
+
+void ggml_compute_forward_newton_schulz(const ggml_compute_params * params, ggml_tensor * dst) {
+    if (params->ith != 0) return;
+    float * out = (float *) dst->data;
+    for (int si = 0; si < GGML_MAX_SRC && dst->src[si]; si++) {
+    const ggml_tensor * src = dst->src[si];
+    const int     steps = ggml_get_op_params_i32(dst, 0);
+    const int64_t ne0 = src->ne[0], ne1 = src->ne[1], k = src->ne[2];
+    const bool    wide = ne1 <= ne0;
+    const int64_t n = wide ? ne1 : ne0;
+    std::vector<float> G(n * n), B(n * n), Y(ne0 * ne1);
+    for (int64_t m = 0; m < k; m++) {
+        const float * s = (const float *) src->data + m * ne0 * ne1;
+        float * X = out + m * ne0 * ne1;
+        double ss = 0;
+        for (int64_t i = 0; i < ne0 * ne1; i++) ss += (double) s[i] * s[i];
+        const float inv = 1.0f / ((float) sqrt(ss) + 1e-7f);
+        for (int64_t i = 0; i < ne0 * ne1; i++) X[i] = s[i] * inv;
+        auto x = [&](int64_t r, int64_t col) -> float & { return X[col * ne0 + r]; }; // M(r, col), r < ne0, col < ne1
+        for (int it = 0; it < steps; it++) {
+            const float a = ggml_get_op_params_f32(dst, 1 + 3 * it), b = ggml_get_op_params_f32(dst, 2 + 3 * it),
+                        c = ggml_get_op_params_f32(dst, 3 + 3 * it);
+            for (int64_t i = 0; i < n; i++)
+                for (int64_t j = 0; j < n; j++) {
+                    double acc = 0;
+                    if (wide) for (int64_t r = 0; r < ne0; r++) acc += (double) x(r, i) * x(r, j); // (M^T M)(i, j)
+                    else      for (int64_t q = 0; q < ne1; q++) acc += (double) x(i, q) * x(j, q); // (M M^T)(i, j)
+                    G[j * n + i] = (float) acc;
+                }
+            for (int64_t i = 0; i < n; i++)
+                for (int64_t j = 0; j < n; j++) {
+                    double acc = 0;
+                    for (int64_t q = 0; q < n; q++) acc += (double) G[q * n + i] * G[j * n + q];
+                    B[j * n + i] = (float) (c * acc + b * G[j * n + i] + (i == j ? a : 0.0f));
+                }
+            for (int64_t r = 0; r < ne0; r++)
+                for (int64_t col = 0; col < ne1; col++) {
+                    double acc = 0;
+                    if (wide) for (int64_t q = 0; q < n; q++) acc += (double) x(r, q) * B[col * n + q]; // (M B)(r, col)
+                    else      for (int64_t q = 0; q < n; q++) acc += (double) B[q * n + r] * x(q, col); // (B M)(r, col)
+                    Y[col * ne0 + r] = (float) acc;
+                }
+            std::copy(Y.begin(), Y.end(), X);
+        }
+    }
+    out += ne0 * ne1 * k;
+    }
+}
