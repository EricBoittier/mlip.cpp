+// a static graph that is computed again and again (an optimizer step): CUDA
+// graph capture for the cgraph whose first node is `first_node`, even when
+// GGML_CUDA_DISABLE_GRAPHS turns capture off for every other graph (looked
+// up with ggml_backend_reg_get_proc_address, no ggml-cuda.h dependency)
+static void ggml_backend_cuda_graph_allow(ggml_backend_t backend, const void * first_node) {
+#ifdef USE_CUDA_GRAPH
+    ggml_backend_cuda_context * cuda_ctx = (ggml_backend_cuda_context *) backend->context;
+    cuda_ctx->cuda_graph(first_node)->allowed = true;
+#else
+    GGML_UNUSED(backend);
+    GGML_UNUSED(first_node);
+#endif
+}
+
 static void * ggml_backend_cuda_reg_get_proc_address(ggml_backend_reg_t reg, const char * name) {
     GGML_UNUSED(reg);
     if (strcmp(name, "ggml_backend_split_buffer_type") == 0) {
@@ -5158,6 +5172,9 @@ static void * ggml_backend_cuda_reg_get_proc_address(ggml_backend_reg_t reg, con
     if (strcmp(name, "ggml_backend_get_features") == 0) {
         return (void *)ggml_backend_cuda_get_features;
     }
+    if (strcmp(name, "ggml_backend_cuda_graph_allow") == 0) {
+        return (void *)ggml_backend_cuda_graph_allow;
+    }
     return nullptr;
 }
 
