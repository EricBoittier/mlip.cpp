 // ggml_compute_forward_swiglu
 
+// sigmoid(a) * b, or sigmoid'(a) * b (split form, f32)
+static void ggml_compute_forward_siglu_f32(
+        const ggml_compute_params * params,
+        ggml_tensor * dst, bool back) {
+    const ggml_tensor * src0 = dst->src[0];
+    const ggml_tensor * src1 = dst->src[1];
+    GGML_ASSERT(src1 && "siglu: split form only");
+    GGML_ASSERT(src0->type == GGML_TYPE_F32 && src1->type == GGML_TYPE_F32 && dst->type == GGML_TYPE_F32);
+    GGML_ASSERT(ggml_is_contiguous_1(src0) && ggml_is_contiguous_1(src1) && ggml_is_contiguous_1(dst));
+    const int nc = src0->ne[0];
+    const int nr = ggml_nrows(src0);
+    GGML_ASSERT(dst->ne[0] == nc && src1->ne[0] == nc && ggml_nrows(dst) == nr);
+    const int dr = (nr + params->nth - 1)/params->nth;
+    const int ir0 = dr*params->ith, ir1 = MIN(ir0 + dr, nr);
+    for (int i1 = ir0; i1 < ir1; i1++) {
+        const float * a = (const float *) ((const char *) src0->data + i1*src0->nb[1]);
+        const float * b = (const float *) ((const char *) src1->data + i1*src1->nb[1]);
+        float * y = (float *) ((char *) dst->data + i1*dst->nb[1]);
+        for (int k = 0; k < nc; k++) {
+            const float s = 1.0f/(1.0f + expf(-a[k]));
+            y[k] = (back ? s*(1.0f - s) : s)*b[k];
+        }
+    }
+}
