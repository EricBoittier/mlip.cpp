+    if (dst->op_params[GGML_MAX_OP_PARAMS / sizeof(int32_t) - 1] == 1) {
+        ggml_cuda_op_bin_bcast<bin_bcast_cuda<op_div_rn>>(dst->src[0], dst->src[1], dst, dst->src[0]->data, dst->src[1]->data, dst->data, ctx.stream());
+        return;
+    }
     ggml_cuda_op_bin_bcast<bin_bcast_cuda<op_div>>(dst->src[0], dst->src[1], dst, dst->src[0]->data, dst->src[1]->data, dst->data, ctx.stream());
 }
 
