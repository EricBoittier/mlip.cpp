+// mlip.cpp: under -use_fast_math a / b is the approximate (2 ulp) division; __fdiv_rn is IEEE round-to-nearest
+// whatever the flags (the CPU's division). Used when the op carries the precise flag (op_params[last] = 1)
+static __device__ __forceinline__ float op_div_rn(const float a, const float b) {
+    return __fdiv_rn(a, b);
+}
