+
+// ggml_compute_forward_pet_attn_jvp and its gradients (reference: one thread
+// per sequence). Per sequence, head h and query row i, over the keys j:
+//   S = scale q.k + b, P = softmax(S), dS = scale (dq.k + q.dk) + db, c = sum P dS,
+//   tangent do = sum P (dS - c) v + sum P dv, dlse = c.
+// Given G = dL/d do and g = dL/d dlse, with gv = G.v, gdv = G.dv, D = sum P gv:
+//   dL/d dS = Gam = P (gv - D + g),
+//   dL/d P  = Pi  = dS (gv - D + g) - c gv + gdv,  dL/d S = Sig = P (Pi - sum P Pi),
+// and S, dS are bilinear in q, k, dq, dk (plus the biases).
+
+namespace {
+struct pet_jvp_seq {
+    const float * x, * dx; // qkv, dqkv of the sequence ([L][3][D]); dx may be null
+    int64_t D, d;
+    int     h;
+    const float * row(const float * t, int64_t j, int s) const { return t + (j*3 + s)*D + h*d; }
+    float dot(const float * a, const float * b) const {
+        float s = 0.0f;
+        for (int64_t c = 0; c < d; c++) s += a[c]*b[c];
+        return s;
+    }
+    // P and dS of query row i (bias rows b, db; db may be null); returns c
+    float probs(int64_t i, int64_t L, float scale, const float * b, const float * db, float * P, float * dS) const {
+        const float * q = row(x, i, 0), * dq = dx ? row(dx, i, 0) : nullptr;
+        float mx = -INFINITY;
+        for (int64_t j = 0; j < L; j++) {
+            const float * k = row(x, j, 1);
+            P[j] = scale*dot(q, k) + b[j];
+            mx = std::max(mx, P[j]);
+            float t = db ? db[j] : 0.0f;
+            if (dx) t += scale*(dot(dq, k) + dot(q, row(dx, j, 1)));
+            dS[j] = t;
+        }
+        double sum = 0.0;
+        for (int64_t j = 0; j < L; j++) P[j] = expf(P[j] - mx), sum += P[j];
+        float c = 0.0f;
+        for (int64_t j = 0; j < L; j++) P[j] /= (float) sum, c += P[j]*dS[j];
+        return c;
+    }
+    // Gam and Sig of row i given its gradient G (and g), from P, dS, c
+    void adjoints(int64_t L, const float * P, const float * dS, float c, const float * G, float g,
+                  float * Gam, float * Sig) const {
+        float Dd = 0.0f, E = 0.0f;
+        for (int64_t j = 0; j < L; j++) Sig[j] = dot(G, row(x, j, 2)), Dd += P[j]*Sig[j];
+        for (int64_t j = 0; j < L; j++) {
+            const float gv = Sig[j], gdv = dx ? dot(G, row(dx, j, 2)) : 0.0f;
+            Gam[j] = P[j]*(gv - Dd + g);
+            Sig[j] = dS[j]*(gv - Dd + g) - c*gv + gdv; // Pi for now
+            E += P[j]*Sig[j];
+        }
+        for (int64_t j = 0; j < L; j++) Sig[j] = P[j]*(Sig[j] - E);
+    }
+};
+
+const float * pet_jvp_rows(const ggml_tensor * t, int64_t n) {
+    return t ? (const float *) ((const char *) t->data + n*t->nb[3]) : nullptr;
+}
+const float * pet_jvp_bias(const ggml_tensor * t, int64_t n, int64_t i) {
+    return t ? (const float *) ((const char *) t->data + n*t->nb[3] + i*t->nb[1]) : nullptr;
+}
+} // namespace
+
+void ggml_compute_forward_pet_attn_jvp(const ggml_compute_params * params, ggml_tensor * dst) {
+    const ggml_tensor * qkv = dst->src[0], * bias = dst->src[1], * dqkv = dst->src[2], * dbias = dst->src[3];
+    const int   H     = ggml_get_op_params_i32(dst, 0);
+    const float scale = ggml_get_op_params_f32(dst, 1);
+    const int64_t D = qkv->ne[0], d = D / H, L = qkv->ne[2], N = qkv->ne[3];
+
+    std::vector<float> P(L), dS(L);
+    for (int64_t n = params->ith; n < N; n += params->nth) {
+        for (int h = 0; h < H; h++) {
+            const pet_jvp_seq s{pet_jvp_rows(qkv, n), pet_jvp_rows(dqkv, n), D, d, h};
+            for (int64_t i = 0; i < L; i++) {
+                const float c = s.probs(i, L, scale, pet_jvp_bias(bias, n, i), pet_jvp_bias(dbias, n, i), P.data(), dS.data());
+                float * out = (float *) ((char *) dst->data + n*dst->nb[2] + i*dst->nb[1]);
+                float * o = out + h*d;
+                for (int64_t k = 0; k < d; k++) o[k] = 0.0f;
+                for (int64_t j = 0; j < L; j++) {
+                    const float w = P[j]*(dS[j] - c);
+                    const float * v = s.row(s.x, j, 2);
+                    for (int64_t k = 0; k < d; k++) o[k] += w*v[k];
+                    if (s.dx) {
+                        const float * dv = s.row(s.dx, j, 2);
+                        for (int64_t k = 0; k < d; k++) o[k] += P[j]*dv[k];
+                    }
+                }
+                out[D + h] = c;
+            }
+        }
+    }
+}
+
+// slots q, k, v, dq, dk, dv of dst [D, 6, L, N]
+void ggml_compute_forward_pet_attn_jvp_back(const ggml_compute_params * params, ggml_tensor * dst) {
+    const ggml_tensor * qkv = dst->src[0], * bias = dst->src[1], * grad = dst->src[2];
+    const ggml_tensor * dqkv = dst->src[3], * dbias = dst->src[4];
+    const int   H     = ggml_get_op_params_i32(dst, 0);
+    const float scale = ggml_get_op_params_f32(dst, 1);
+    const int64_t D = qkv->ne[0], d = D / H, L = qkv->ne[2], N = qkv->ne[3];
+
+    std::vector<float> P(L), dS(L), Gam(L), Sig(L);
+    for (int64_t n = params->ith; n < N; n += params->nth) {
+        auto out = [&](int64_t i, int slot) { return (float *) ((char *) dst->data + n*dst->nb[3] + i*dst->nb[2] + slot*dst->nb[1]); };
+        for (int64_t i = 0; i < L; i++)
+            for (int slot = 0; slot < 6; slot++) memset(out(i, slot), 0, D*sizeof(float));
+        for (int h = 0; h < H; h++) {
+            const pet_jvp_seq s{pet_jvp_rows(qkv, n), pet_jvp_rows(dqkv, n), D, d, h};
+            for (int64_t i = 0; i < L; i++) {
+                const float c = s.probs(i, L, scale, pet_jvp_bias(bias, n, i), pet_jvp_bias(dbias, n, i), P.data(), dS.data());
+                const float * gi = (const float *) ((const char *) grad->data + n*grad->nb[2] + i*grad->nb[1]);
+                s.adjoints(L, P.data(), dS.data(), c, gi + h*d, gi[D + h], Gam.data(), Sig.data());
+                const float * q = s.row(s.x, i, 0), * dq = s.dx ? s.row(s.dx, i, 0) : nullptr, * G = gi + h*d;
+                float * gq = out(i, 0) + h*d, * gdq = out(i, 3) + h*d;
+                for (int64_t j = 0; j < L; j++) {
+                    const float * k = s.row(s.x, j, 1), * dk = s.dx ? s.row(s.dx, j, 1) : nullptr;
+                    float * gk = out(j, 1) + h*d, * gv = out(j, 2) + h*d, * gdk = out(j, 4) + h*d, * gdv = out(j, 5) + h*d;
+                    const float a = scale*Sig[j], b = scale*Gam[j], w = P[j]*(dS[j] - c);
+                    for (int64_t k2 = 0; k2 < d; k2++) {
+                        gq[k2]  += a*k[k2] + (dk ? b*dk[k2] : 0.0f);
+                        gdq[k2] += b*k[k2];
+                        gk[k2]  += a*q[k2] + (dq ? b*dq[k2] : 0.0f);
+                        gdk[k2] += b*q[k2];
+                        gv[k2]  += w*G[k2];
+                        gdv[k2] += P[j]*G[k2];
+                    }
+                }
+            }
+        }
+    }
+}
+
+// planes bias, dbias of dst [L, L, 2, N], summed over the heads
+void ggml_compute_forward_pet_attn_jvp_back_bias(const ggml_compute_params * params, ggml_tensor * dst) {
+    const ggml_tensor * qkv = dst->src[0], * bias = dst->src[1], * grad = dst->src[2];
+    const ggml_tensor * dqkv = dst->src[3], * dbias = dst->src[4];
+    const int   H     = ggml_get_op_params_i32(dst, 0);
+    const float scale = ggml_get_op_params_f32(dst, 1);
+    const int64_t D = qkv->ne[0], d = D / H, L = qkv->ne[2], N = qkv->ne[3];
+
+    std::vector<float> P(L), dS(L), Gam(L), Sig(L);
+    for (int64_t n = params->ith; n < N; n += params->nth) {
+        for (int64_t i = 0; i < L; i++) {
+            float * gb  = (float *) ((char *) dst->data + n*dst->nb[3] + i*dst->nb[1]);
+            float * gdb = (float *) ((char *) dst->data + n*dst->nb[3] + dst->nb[2] + i*dst->nb[1]);
+            for (int64_t j = 0; j < L; j++) gb[j] = gdb[j] = 0.0f;
+            const float * gi = (const float *) ((const char *) grad->data + n*grad->nb[2] + i*grad->nb[1]);
+            for (int h = 0; h < H; h++) {
+                const pet_jvp_seq s{pet_jvp_rows(qkv, n), pet_jvp_rows(dqkv, n), D, d, h};
+                const float c = s.probs(i, L, scale, pet_jvp_bias(bias, n, i), pet_jvp_bias(dbias, n, i), P.data(), dS.data());
+                s.adjoints(L, P.data(), dS.data(), c, gi + h*d, gi[D + h], Gam.data(), Sig.data());
+                for (int64_t j = 0; j < L; j++) gb[j] += Sig[j], gdb[j] += Gam[j];
+            }
+        }
+    }
+}
