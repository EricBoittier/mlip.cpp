+// ggml_pet_attn_jvp: src (qkv, bias, dqkv, dbias), dqkv / dbias may be NULL;
+// its gradients: src (qkv, bias, grad, dqkv, dbias)
+
+struct ggml_tensor * ggml_pet_attn_jvp(
+        struct ggml_context * ctx,
+        struct ggml_tensor  * qkv,
+        struct ggml_tensor  * bias,
+        struct ggml_tensor  * dqkv,
+        struct ggml_tensor  * dbias,
+        int                   n_head,
+        float                 scale) {
+    GGML_ASSERT(qkv->type == GGML_TYPE_F32 && bias->type == GGML_TYPE_F32);
+    GGML_ASSERT(ggml_is_contiguous(qkv) && ggml_is_contiguous(bias));
+    GGML_ASSERT(qkv->ne[1] == 3 && n_head > 0 && qkv->ne[0] % n_head == 0);
+    GGML_ASSERT(bias->ne[0] == qkv->ne[2] && bias->ne[1] == qkv->ne[2] && bias->ne[2] == 1 && bias->ne[3] == qkv->ne[3]);
+    GGML_ASSERT(!dqkv  || (dqkv->type  == GGML_TYPE_F32 && ggml_is_contiguous(dqkv)  && ggml_are_same_shape(dqkv, qkv)));
+    GGML_ASSERT(!dbias || (dbias->type == GGML_TYPE_F32 && ggml_is_contiguous(dbias) && ggml_are_same_shape(dbias, bias)));
+
+    struct ggml_tensor * result = ggml_new_tensor_3d(ctx, GGML_TYPE_F32, qkv->ne[0] + n_head, qkv->ne[2], qkv->ne[3]);
+
+    int32_t params[2] = { n_head, 0 };
+    memcpy(params + 1, &scale, sizeof(float));
+    ggml_set_op_params(result, params, sizeof(params));
+
+    result->op     = GGML_OP_PET_ATTN_JVP;
+    result->src[0] = qkv;
+    result->src[1] = bias;
+    result->src[2] = dqkv;
+    result->src[3] = dbias;
+
+    return result;
+}
+
+static struct ggml_tensor * ggml_pet_attn_jvp_back_impl(
+        struct ggml_context * ctx,
+        struct ggml_tensor  * jvp,
+        struct ggml_tensor  * grad,
+        bool                  bias) {
+    GGML_ASSERT(jvp->op == GGML_OP_PET_ATTN_JVP);
+    GGML_ASSERT(ggml_are_same_shape(jvp, grad) && grad->type == GGML_TYPE_F32 && ggml_is_contiguous(grad));
+    const struct ggml_tensor * qkv = jvp->src[0];
+
+    struct ggml_tensor * result = bias
+        ? ggml_new_tensor_4d(ctx, GGML_TYPE_F32, qkv->ne[2], qkv->ne[2], 2, qkv->ne[3])
+        : ggml_new_tensor_4d(ctx, GGML_TYPE_F32, qkv->ne[0], 6, qkv->ne[2], qkv->ne[3]);
+
+    ggml_set_op_params(result, jvp->op_params, 2*sizeof(int32_t));
+
+    result->op     = bias ? GGML_OP_PET_ATTN_JVP_BACK_BIAS : GGML_OP_PET_ATTN_JVP_BACK;
+    result->src[0] = jvp->src[0];
+    result->src[1] = jvp->src[1];
+    result->src[2] = grad;
+    result->src[3] = jvp->src[2];
+    result->src[4] = jvp->src[3];
+
+    return result;
+}
+
+struct ggml_tensor * ggml_pet_attn_jvp_back(
+        struct ggml_context * ctx,
+        struct ggml_tensor  * jvp,
+        struct ggml_tensor  * grad) {
+    return ggml_pet_attn_jvp_back_impl(ctx, jvp, grad, false);
+}
+
+struct ggml_tensor * ggml_pet_attn_jvp_back_bias(
+        struct ggml_context * ctx,
+        struct ggml_tensor  * jvp,
+        struct ggml_tensor  * grad) {
+    return ggml_pet_attn_jvp_back_impl(ctx, jvp, grad, true);
+}
