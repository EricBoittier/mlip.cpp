+// narrow rows (2 ne00 <= CUDA_GET_ROWS_BLOCK_SIZE): k_get_rows_float gives every row a block
+// of CUDA_GET_ROWS_BLOCK_SIZE threads of which only ne00 are active (16 of 256 for PET's
+// [16, edges x ...] gathers); here one block gathers blockDim.x / ne00 rows
+template<typename src0_t, typename dst_t>
+static __global__ void k_get_rows_float_narrow(
+        const src0_t * __restrict__ src0, const int32_t * __restrict__ src1, dst_t * __restrict__ dst,
+        const int64_t ne00, const int64_t ne10, const int64_t ne11, const int64_t ne12,
+        const size_t s1, const size_t s2, const size_t s3,
+        const size_t nb01, const size_t nb02, const size_t nb03,
+        const size_t s10, const size_t s11, const size_t s12) {
+    const int64_t rpb = blockDim.x / ne00;
+    const int64_t r   = threadIdx.x / ne00;
+    const int64_t i00 = threadIdx.x - r*ne00;
+    const int64_t i10 = (int64_t) blockIdx.x*rpb + r;
+    if (r >= rpb || i10 >= ne10) {
+        return;
+    }
+    for (int64_t z = blockIdx.z; z < ne11*ne12; z += gridDim.z) {
+        const int64_t i11 = z / ne12;
+        const int64_t i12 = z % ne12;
+        const int i01 = src1[i10*s10 + i11*s11 + i12*s12];
+        const src0_t * src0_row = (const src0_t *)((const char *) src0 + i01*nb01 + i11*nb02 + i12*nb03);
+        dst[i10*s1 + i11*s2 + i12*s3 + i00] = ggml_cuda_cast<dst_t>(src0_row[i00]);
+    }
+}
