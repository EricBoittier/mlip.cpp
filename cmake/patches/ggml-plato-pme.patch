+// order-p B-spline weights M_p(t + p - 1 - s) of the stencil floor(u) - p/2 + 1 + s
+// (s = 0 .. p - 1) and their derivatives w.r.t. u; order 4: plato_bspline
+inline void plato_bspline_p(float u, int64_t K, int p, int64_t * idx, float * w, float * dw) {
+    if (p == 4) { plato_bspline(u, K, idx, w, dw); return; }
+    const float fl = floorf(u), t = u - fl;
+    const int64_t i0 = (int64_t) fl;
+    float c[12], prev[12];
+    c[0] = 1.0f;
+    for (int n = 1; n < p; n++) { // c[k] = M_{n+1}(t + k), k = 0 .. n
+        if (n == p - 1) for (int k = 0; k < n; k++) prev[k] = c[k];
+        float nw[12];
+        for (int k = 0; k <= n; k++) {
+            const float x = t + (float) k;
+            float v = 0.0f;
+            if (k < n) v += x*c[k];
+            if (k >= 1) v += ((float) (n + 1) - x)*c[k - 1];
+            nw[k] = v/(float) n;
+        }
+        for (int k = 0; k <= n; k++) c[k] = nw[k];
+    }
+    for (int q = 0; q < p; q++) {
+        const int k = p - 1 - q;
+        w[q] = c[k];
+        dw[q] = (k <= p - 2 ? prev[k] : 0.0f) - (k >= 1 ? prev[k - 1] : 0.0f);
+        idx[q] = (((i0 + q - (p/2 - 1)) % K) + K) % K;
+    }
+}
