+template <int NV>
+__device__ __forceinline__ void plato_block_sum(double (&v)[NV]) { // result in thread 0
+    __shared__ double red[NV][32];
+    const int lane = threadIdx.x % 32, warp = threadIdx.x / 32;
+#pragma unroll
+    for (int j = 0; j < NV; j++) {
+        for (int o = 16; o > 0; o >>= 1) v[j] += __shfl_xor_sync(0xffffffff, v[j], o);
+        if (lane == 0) red[j][warp] = v[j];
+    }
+    __syncthreads();
+    if (warp == 0) {
+#pragma unroll
+        for (int j = 0; j < NV; j++) {
+            double x = lane < (int) (blockDim.x / 32) ? red[j][lane] : 0.0;
+            for (int o = 16; o > 0; o >>= 1) x += __shfl_xor_sync(0xffffffff, x, o);
+            v[j] = x;
+        }
+    }
+}
