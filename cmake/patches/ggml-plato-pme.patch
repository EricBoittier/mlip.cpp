+// phi(k^2) = w(|k|) exp(-sigma^2 k^2 / 2) / k^2 and d phi / d k^2 (ggml_plato_pme)
+inline void plato_pme_phi(double k2, double s2, double kc, double wd, double & phi, double & dphi) {
+    phi = 0.0, dphi = 0.0;
+    if (k2 <= 0.0) return;
+    const double k = std::sqrt(k2), x = (k - (kc - wd))/wd;
+    if (x >= 1.0) return;
+    double w = 1.0, dw = 0.0; // d w / d |k|
+    if (x > 0.0) w = 0.5*(1.0 + std::cos(M_PI*x)), dw = -0.5*M_PI*std::sin(M_PI*x)/wd;
+    const double e = std::exp(-0.5*s2*k2)/k2;
+    phi = w*e;
+    dphi = dw/(2.0*k)*e - w*e*(0.5*s2 + 1.0/k2);
+}
+
+struct plato_pme_args {
+    int64_t M0, M1, M2, Mh, G;
+    double s2, kc, wd;
+    bool shared;
+    plato_pme_args(const ggml_tensor * op, const ggml_tensor * rk, const ggml_tensor * A) {
+        const int32_t * ip = (const int32_t *) op->op_params;
+        float fp[3];
+        memcpy(fp, ip + 3, sizeof(fp));
+        M0 = ip[0], M1 = ip[1], M2 = ip[2], Mh = M2/2 + 1, G = rk->ne[3];
+        s2 = double(fp[0])*fp[0], kc = fp[1], wd = fp[2];
+        shared = ggml_nelements(A) == 9;
+    }
+};
+
+inline int64_t plato_freq(int64_t i, int64_t M) { return i <= (M - 1)/2 ? i : i - M; }
+
+} // namespace
