+    const float * x = (const float *) rk->data, * Af = (const float *) dst->src[1]->data, * tab = (const float *) dst->src[2]->data;
+    const float * de = (const float *) dst->src[3]->data;
+    float * drk = (float *) dst->data, * dA = drk + ggml_nelements(rk);
+    for (int64_t u = params->ith; u < P.M0*P.G; u += params->nth) {
+        const int64_t i0 = u % P.M0, g = u / P.M0;
+        const float * A = Af + (P.shared ? 0 : 9*g);
+        const double m0 = (double) plato_freq(i0, P.M0), t0 = tab[i0], d = de[g*P.M0 + i0];
+        double a[6] = {0, 0, 0, 0, 0, 0}; // 00 11 22 01 02 12
+        for (int64_t i1 = 0; i1 < P.M1; i1++) {
+            const double m1 = (double) plato_freq(i1, P.M1), t01 = t0*tab[P.M0 + i1];
+            const int64_t o = 2*P.Mh*(i1 + P.M1*(i0 + P.M0*g));
+            for (int64_t i2 = 0; i2 < P.Mh; i2++) {
+                const double m2 = (double) i2;
+                const double k2 = A[0]*m0*m0 + A[4]*m1*m1 + A[8]*m2*m2 + (A[1] + A[3])*m0*m1 + (A[2] + A[6])*m0*m2 + (A[5] + A[7])*m1*m2;
+                double phi, dphi;
+                plato_pme_phi(k2, P.s2, P.kc, P.wd, phi, dphi);
+                const double re = x[o + 2*i2], im = x[o + 2*i2 + 1], f = d*t01*tab[P.M0 + P.M1 + i2];
+                drk[o + 2*i2] = (float) (2.0*f*phi*re), drk[o + 2*i2 + 1] = (float) (2.0*f*phi*im);
+                if (dphi == 0.0) continue;
+                const double c = f*dphi*(re*re + im*im);
+                a[0] += c*m0*m0, a[1] += c*m1*m1, a[2] += c*m2*m2, a[3] += c*m0*m1, a[4] += c*m0*m2, a[5] += c*m1*m2;
+            }
+        }
+        float * o9 = dA + 9*(g*P.M0 + i0); // d / d A_ab, symmetric halves
+        o9[0] = (float) a[0], o9[4] = (float) a[1], o9[8] = (float) a[2];
+        o9[1] = o9[3] = (float) a[3], o9[2] = o9[6] = (float) a[4], o9[5] = o9[7] = (float) a[5];
+    }
+}
