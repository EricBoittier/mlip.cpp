+// ggml_plato_pme: phi(k^2) and d phi / d k^2 (as the CPU), in float with the sums in double
+__device__ __forceinline__ void plato_pme_phi_cu(float k2, float s2, float kc, float wd, float & phi, float & dphi) {
+    phi = 0.0f, dphi = 0.0f;
+    if (k2 <= 0.0f) return;
+    const float k = sqrtf(k2), x = (k - (kc - wd)) / wd;
+    if (x >= 1.0f) return;
+    float w = 1.0f, dw = 0.0f;
+    if (x > 0.0f) {
+        float sn, cs;
+        sincospif(x, &sn, &cs);
+        w = 0.5f * (1.0f + cs), dw = -0.5f * (float) M_PI * sn / wd;
+    }
+    const float e = expf(-0.5f * s2 * k2) / k2;
+    phi = w * e;
+    dphi = dw / (2.0f * k) * e - w * e * (0.5f * s2 + 1.0f / k2);
+}
