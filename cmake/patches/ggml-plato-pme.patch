+void ggml_compute_forward_plato_pme(const ggml_compute_params * params, ggml_tensor * dst) {
+    const ggml_tensor * rk = dst->src[0];
+    const plato_pme_args P(dst, rk, dst->src[1]);
+    const float * x = (const float *) rk->data, * Af = (const float *) dst->src[1]->data, * tab = (const float *) dst->src[2]->data;
+    float * out = (float *) dst->data;
+    for (int64_t u = params->ith; u < P.M0*P.G; u += params->nth) {
+        const int64_t i0 = u % P.M0, g = u / P.M0;
+        const float * A = Af + (P.shared ? 0 : 9*g);
+        const double m0 = (double) plato_freq(i0, P.M0), t0 = tab[i0];
+        double acc = 0.0;
+        for (int64_t i1 = 0; i1 < P.M1; i1++) {
+            const double m1 = (double) plato_freq(i1, P.M1), t01 = t0*tab[P.M0 + i1];
+            const float * row = x + 2*P.Mh*(i1 + P.M1*(i0 + P.M0*g));
+            for (int64_t i2 = 0; i2 < P.Mh; i2++) {
+                const double m2 = (double) i2;
+                const double k2 = A[0]*m0*m0 + A[4]*m1*m1 + A[8]*m2*m2 + (A[1] + A[3])*m0*m1 + (A[2] + A[6])*m0*m2 + (A[5] + A[7])*m1*m2;
+                double phi, dphi;
+                plato_pme_phi(k2, P.s2, P.kc, P.wd, phi, dphi);
+                if (phi == 0.0) continue;
+                const double re = row[2*i2], im = row[2*i2 + 1];
+                acc += t01*tab[P.M0 + P.M1 + i2]*phi*(re*re + im*im);
+            }
+        }
+        out[g*P.M0 + i0] = (float) acc;
+    }
+}
