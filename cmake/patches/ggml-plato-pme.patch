+    double acc[1] = {0.0};
+    for (int e = threadIdx.x; e < P.M1 * P.Mh; e += blockDim.x) {
+        const int i1 = e / P.Mh, i2 = e % P.Mh;
+        const float m1 = (float) plato_freq_cu(i1, P.M1), m2 = (float) i2;
+        const float k2 = a00 + a11 * m1 * m1 + a22 * m2 * m2 + a01 * m1 + a02 * m2 + a12 * m1 * m2;
