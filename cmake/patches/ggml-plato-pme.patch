+// order-P B-spline (P even, 6..12): weights M_P(t + P - 1 - s) of the points floor(u) - P/2 + 1 + s
+template <int P>
+__device__ __forceinline__ void plato_bspline_p_cu(float u, int K, int * idx, float * w, float * dw) {
+    const float fl = floorf(u), t = u - fl;
+    const int i0 = (int) fl;
+    float c[P], prev[P];
+    c[0] = 1.0f;
+#pragma unroll
+    for (int n = 1; n < P; n++) {
+        if (n == P - 1) {
+#pragma unroll
+            for (int k = 0; k < P - 1; k++) prev[k] = c[k];
+        }
+        c[n] = 0.0f;
+#pragma unroll
+        for (int k = n; k >= 0; k--) { // in place, high to low
+            const float x = t + (float) k;
+            float v = k < n ? x * c[k] : 0.0f;
+            if (k >= 1) v += ((float) (n + 1) - x) * c[k - 1];
+            c[k] = v / (float) n;
+        }
+    }
+#pragma unroll
+    for (int q = 0; q < P; q++) {
+        const int k = P - 1 - q;
+        w[q] = c[k];
+        if (dw) dw[q] = (k <= P - 2 ? prev[k] : 0.0f) - (k >= 1 ? prev[k - 1] : 0.0f);
+        idx[q] = (((i0 + q - (P / 2 - 1)) % K) + K) % K;
+    }
+}
