+// a thread per (atom, x, y), the z line in a loop
+template <int P>
+__global__ void plato_spread_p_k(const float * __restrict__ v, const float * __restrict__ frac, const int * __restrict__ blk,
+                                 float * __restrict__ rho, int n, int C, int M0, int M1, int M2) {
+    const int64_t e = (int64_t) blockIdx.x * blockDim.x + threadIdx.x;
+    if (e >= (int64_t) n * P * P) return;
+    const int a = (int) (e / (P * P)), s = (int) (e % (P * P)), x = s / P, y = s % P;
+    int ix[P], iy[P], iz[P];
+    float wx[P], wy[P], wz[P];
+    plato_bspline_p_cu<P>(frac[3 * a + 0] * (float) M0, M0, ix, wx, nullptr);
+    plato_bspline_p_cu<P>(frac[3 * a + 1] * (float) M1, M1, iy, wy, nullptr);
+    plato_bspline_p_cu<P>(frac[3 * a + 2] * (float) M2, M2, iz, wz, nullptr);
+    const float wxy = wx[x] * wy[y];
+    const int64_t row = ((int64_t) ix[x] * M1 + iy[y]) * M2, M = (int64_t) M0 * M1 * M2;
+    const int64_t c0 = (int64_t) (blk ? blk[a] : 0) * C;
+    for (int c = 0; c < C; c++) {
+        float * r = rho + (c0 + c) * M + row;
+        const float va = wxy * v[(int64_t) a * C + c];
+#pragma unroll
+        for (int z = 0; z < P; z++) atomicAdd(r + iz[z], va * wz[z]);
+    }
+}
+
+// a thread per (atom, channel)
+template <int P>
+__global__ void plato_gather_p_k(const float * __restrict__ phi, const float * __restrict__ frac, const int * __restrict__ blk,
+                                 float * __restrict__ out, int n, int C, int M0, int M1, int M2, int deriv) {
+    const int64_t e = (int64_t) blockIdx.x * blockDim.x + threadIdx.x;
+    if (e >= (int64_t) n * C) return;
+    const int a = (int) (e / C), c = (int) (e % C);
+    int ix[P], iy[P], iz[P];
+    float wx[P], wy[P], wz[P], dx[P], dy[P], dz[P];
+    plato_bspline_p_cu<P>(frac[3 * a + 0] * (float) M0, M0, ix, wx, dx);
+    plato_bspline_p_cu<P>(frac[3 * a + 1] * (float) M1, M1, iy, wy, dy);
+    plato_bspline_p_cu<P>(frac[3 * a + 2] * (float) M2, M2, iz, wz, dz);
+    const float * m = phi + ((int64_t) (blk ? blk[a] : 0) * C + c) * M0 * M1 * M2;
+    float acc = 0.0f, g0 = 0.0f, g1 = 0.0f, g2 = 0.0f;
+    for (int x = 0; x < P; x++)
+        for (int y = 0; y < P; y++) {
+            const float * row = m + ((int64_t) ix[x] * M1 + iy[y]) * M2;
+            float sw = 0.0f, sd = 0.0f;
+#pragma unroll
+            for (int z = 0; z < P; z++) {
+                const float p = row[iz[z]];
+                sw += wz[z] * p;
+                sd += dz[z] * p;
+            }
+            if (!deriv) acc += wx[x] * wy[y] * sw;
+            else {
+                g0 += dx[x] * wy[y] * sw;
+                g1 += wx[x] * dy[y] * sw;
+                g2 += wx[x] * wy[y] * sd;
+            }
+        }
+    if (!deriv) out[(int64_t) a * C + c] = acc;
+    else {
+        out[((int64_t) a * 3 + 0) * C + c] = g0 * (float) M0;
+        out[((int64_t) a * 3 + 1) * C + c] = g1 * (float) M1;
+        out[((int64_t) a * 3 + 2) * C + c] = g2 * (float) M2;
+    }
+}
