+// mlip.cpp: F32 MUL_MAT accumulating in double when flagged precise (op_params[last] = 1; graph_model.cpp
+// mark_precise_math under MLIPCPP_PRECISE_MATMUL, a diagnostic): one thread per output element, the K products
+// (exact in double) summed in order, one rounding. dst[i0, i1, i2, i3] = sum_k src0[k, i0, i2 / r2, i3 / r3] *
+// src1[k, i1, i2, i3], any strides (the cuBLAS / mmf paths' reduction order and split-K are out of the picture).
+static __global__ void mul_mat_f32_f64acc(const char * __restrict__ x, const char * __restrict__ y, float * __restrict__ dst,
+        const int64_t K, const int64_t ne0, const int64_t ne1, const int64_t ne2, const int64_t ne3,
+        const int64_t r2, const int64_t r3,
+        const size_t nb00, const size_t nb01, const size_t nb02, const size_t nb03,
+        const size_t nb10, const size_t nb11, const size_t nb12, const size_t nb13,
+        const size_t nbd1, const size_t nbd2, const size_t nbd3) {
+    const int64_t idx = (int64_t) blockIdx.x * blockDim.x + threadIdx.x;
+    const int64_t total = ne0 * ne1 * ne2 * ne3;
+    if (idx >= total) {
+        return;
+    }
+    const int64_t i0 = idx % ne0, i1 = (idx / ne0) % ne1, i2 = (idx / (ne0 * ne1)) % ne2, i3 = idx / (ne0 * ne1 * ne2);
+    const char * a = x + i0 * nb01 + (i2 / r2) * nb02 + (i3 / r3) * nb03;
+    const char * b = y + i1 * nb11 + i2 * nb12 + i3 * nb13;
+    double s = 0.0;
+    for (int64_t k = 0; k < K; k++) {
+        s += (double) *(const float *) (a + k * nb00) * (double) *(const float *) (b + k * nb10);
+    }
+    *(float *) ((char *) dst + i0 * sizeof(float) + i1 * nbd1 + i2 * nbd2 + i3 * nbd3) = (float) s;
+}
