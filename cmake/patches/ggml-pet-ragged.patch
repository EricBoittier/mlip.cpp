+// ggml_compute_forward_pet_attn_ragged (reference: one thread per sequence)
+
+struct pet_ragged_seq {
+    int64_t N, D, H, T;
+    const int32_t * off;
+    int64_t len(int64_t i) const { return 1 + off[i + 1] - off[i]; }
+    int64_t row(int64_t i, int64_t t) const { return t == 0 ? i : N + off[i] + t - 1; }
+    float bias(const float * b, int64_t r) const { return r < N ? 0.0f : b[r - N]; }
+};
+
+static pet_ragged_seq pet_ragged_dims(const ggml_tensor * qkv, const ggml_tensor * off, int H) {
+    return {ggml_nelements(off) - 1, qkv->ne[0] / 3, H, qkv->ne[1], (const int32_t *) off->data};
+}
