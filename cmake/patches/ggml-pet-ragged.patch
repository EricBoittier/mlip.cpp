+// ggml_compute_forward_pet_bump: [E, 2] = (fc, log(max(fc, eps)))
+
+static constexpr float PET_PI = 3.14159265358979323846f;
+
+static inline float pet_bump_t(float d, float pc, float width, float & c, bool & inside) {
+    const float s = (d - pc + width) / width;
+    inside = s > 1e-6f && s < 1.0f - 1e-6f;
+    c = std::min(std::max(s, 1e-6f), 1.0f - 1e-6f);
+    return 1.0f / tanf(PET_PI * c);
+}
+
+void ggml_compute_forward_pet_bump(const ggml_compute_params * params, ggml_tensor * dst) {
+    const float * d  = (const float *) dst->src[0]->data;
+    const float * pc = (const float *) dst->src[1]->data;
+    const float width = ggml_get_op_params_f32(dst, 0), eps = ggml_get_op_params_f32(dst, 1);
+    const int64_t E = dst->ne[0];
+    float * out = (float *) dst->data;
+    for (int64_t e = params->ith; e < E; e += params->nth) {
+        float c;
+        bool inside;
+        const float fc = 0.5f*(1.0f + tanhf(pet_bump_t(d[e], pc[e], width, c, inside)));
+        out[e] = fc, out[E + e] = logf(std::max(fc, eps));
+    }
+}
+
+// ggml_compute_forward_pet_bump_back: [E, 2] = (dL/dd, dL/dpc)
+
+void ggml_compute_forward_pet_bump_back(const ggml_compute_params * params, ggml_tensor * dst) {
+    const float * d  = (const float *) dst->src[0]->data;
+    const float * pc = (const float *) dst->src[1]->data;
+    const float * g  = (const float *) dst->src[2]->data;
+    const float width = ggml_get_op_params_f32(dst, 0), eps = ggml_get_op_params_f32(dst, 1);
+    const int64_t E = dst->ne[0];
+    float * out = (float *) dst->data;
+    for (int64_t e = params->ith; e < E; e += params->nth) {
+        float c;
+        bool inside;
+        const float th = tanhf(pet_bump_t(d[e], pc[e], width, c, inside));
+        const float fc = 0.5f*(1.0f + th);
+        const float sn = sinf(PET_PI * c);
+        // dfc/ds = 0.5 (1 - tanh^2) * d cot(pi c)/dc, zero where the clamp holds
+        const float dfc = inside ? 0.5f*(1.0f - th*th)*(-PET_PI/(sn*sn)) : 0.0f;
+        const float gfc = g[e] + (fc > eps ? g[E + e]/fc : 0.0f);
+        const float dd = gfc*dfc/width;
+        out[e] = dd, out[E + e] = -dd;
+    }
+}
+
+// ggml_compute_forward_pet_attn_ragged (reference: one thread per sequence)
+
+struct pet_ragged_seq {
+    int64_t N, D, H, T;
+    const int32_t * off;
+    int64_t len(int64_t i) const { return 1 + off[i + 1] - off[i]; }
+    int64_t row(int64_t i, int64_t t) const { return t == 0 ? i : N + off[i] + t - 1; }
+    float bias(const float * b, int64_t r) const { return r < N ? 0.0f : b[r - N]; }
+};
+
+static pet_ragged_seq pet_ragged_dims(const ggml_tensor * qkv, const ggml_tensor * off, int H) {
+    return {ggml_nelements(off) - 1, qkv->ne[0] / 3, H, qkv->ne[1], (const int32_t *) off->data};
+}
+
+void ggml_compute_forward_pet_attn_ragged(const ggml_compute_params * params, ggml_tensor * dst) {
+    const ggml_tensor * qkv = dst->src[0];
+    const float * bias = (const float *) dst->src[1]->data;
+    const int   H     = ggml_get_op_params_i32(dst, 0);
+    const float scale = ggml_get_op_params_f32(dst, 2);
+    const pet_ragged_seq q = pet_ragged_dims(qkv, dst->src[2], H);
+    const int64_t D = q.D, d = D / H, T = q.T;
+    const float * x = (const float *) qkv->data;
+    float * out = (float *) dst->data, * lse = out + D*T;
+    if (params->ith == 0) { // tokens in no sequence
+        for (int64_t r = q.N + q.off[q.N]; r < T; r++) {
+            memset(out + r*D, 0, D*sizeof(float));
+            for (int h = 0; h < H; h++) lse[r*H + h] = 0.0f;
+        }
+    }
+    std::vector<float> p;
+    for (int64_t i = params->ith; i < q.N; i += params->nth) {
+        const int64_t L = q.len(i);
+        p.resize(L);
+        for (int64_t t = 0; t < L; t++) {
+            const int64_t rt = q.row(i, t);
+            for (int h = 0; h < H; h++) {
+                const float * qr = x + rt*3*D + h*d;
+                float mx = -INFINITY;
+                for (int64_t u = 0; u < L; u++) {
+                    const int64_t ru = q.row(i, u);
+                    const float * k = x + ru*3*D + D + h*d;
+                    float s = 0.0f;
+                    for (int64_t c = 0; c < d; c++) s += qr[c]*k[c];
+                    p[u] = scale*s + q.bias(bias, ru);
+                    mx = std::max(mx, p[u]);
+                }
+                double sum = 0.0;
+                for (int64_t u = 0; u < L; u++) p[u] = expf(p[u] - mx), sum += p[u];
+                float * o = out + rt*D + h*d;
+                for (int64_t c = 0; c < d; c++) o[c] = 0.0f;
+                for (int64_t u = 0; u < L; u++) {
+                    const float * v = x + q.row(i, u)*3*D + 2*D + h*d;
+                    const float w = p[u] / (float) sum;
+                    for (int64_t c = 0; c < d; c++) o[c] += w*v[c];
+                }
+                lse[rt*H + h] = mx + (float) log(sum);
+            }
+        }
+    }
+}
+
+// ggml_compute_forward_pet_attn_ragged_back: [3D * T] dqkv, then [H * T] per-head dbias
+
+void ggml_compute_forward_pet_attn_ragged_back(const ggml_compute_params * params, ggml_tensor * dst) {
+    const ggml_tensor * qkv = dst->src[0];
+    const float * bias = (const float *) dst->src[1]->data;
+    const float * res  = (const float *) dst->src[3]->data;
+    const float * grad = (const float *) dst->src[4]->data;
+    const int   H     = ggml_get_op_params_i32(dst, 0);
+    const float scale = ggml_get_op_params_f32(dst, 2);
+    const pet_ragged_seq q = pet_ragged_dims(qkv, dst->src[2], H);
+    const int64_t D = q.D, d = D / H, T = q.T;
+    const float * x = (const float *) qkv->data, * lse = res + D*T;
+    float * dx = (float *) dst->data, * db = dx + 3*D*T;
+    if (params->ith == 0) {
+        for (int64_t r = q.N + q.off[q.N]; r < T; r++) {
+            memset(dx + r*3*D, 0, 3*D*sizeof(float));
+            memset(db + r*H, 0, H*sizeof(float));
+        }
+    }
+    for (int64_t i = params->ith; i < q.N; i += params->nth) {
+        const int64_t L = q.len(i);
+        for (int64_t t = 0; t < L; t++) {
+            const int64_t r = q.row(i, t);
+            memset(dx + r*3*D, 0, 3*D*sizeof(float));
+            memset(db + r*H, 0, H*sizeof(float));
+        }
+        for (int h = 0; h < H; h++) {
+            for (int64_t t = 0; t < L; t++) {
+                const int64_t rt = q.row(i, t);
+                const float * qr = x + rt*3*D + h*d;
+                const float * o  = res + rt*D + h*d;
+                const float * dO = grad + rt*D + h*d;
+                const float l = lse[rt*H + h];
+                float Di = 0.0f;
+                for (int64_t c = 0; c < d; c++) Di += dO[c]*o[c];
+                float * dq = dx + rt*3*D + h*d;
+                for (int64_t u = 0; u < L; u++) {
+                    const int64_t ru = q.row(i, u);
+                    const float * k = x + ru*3*D + D + h*d;
+                    const float * v = x + ru*3*D + 2*D + h*d;
+                    float s = 0.0f, dp = 0.0f;
+                    for (int64_t c = 0; c < d; c++) s += qr[c]*k[c], dp += dO[c]*v[c];
+                    const float p  = expf(scale*s + q.bias(bias, ru) - l);
+                    const float ds = p*(dp - Di);
+                    float * dk = dx + ru*3*D + D + h*d;
+                    float * dv = dx + ru*3*D + 2*D + h*d;
+                    for (int64_t c = 0; c < d; c++) dq[c] += scale*ds*k[c], dk[c] += scale*ds*qr[c], dv[c] += p*dO[c];
+                    db[ru*H + h] += ds;
+                }
+            }
+        }
+    }
+}
+
+// ggml_compute_forward_pet_layer_norm: (x - mean) / sqrt(var + eps) * w + b, per row
+
+void ggml_compute_forward_pet_layer_norm(const ggml_compute_params * params, ggml_tensor * dst) {
+    const ggml_tensor * x = dst->src[0];
+    const float * w = (const float *) dst->src[1]->data, * b = (const float *) dst->src[2]->data;
+    const float eps = ggml_get_op_params_f32(dst, 0);
+    const int64_t d = x->ne[0], rows = ggml_nrows(x);
+    for (int64_t r = params->ith; r < rows; r += params->nth) {
+        const float * xr = (const float *) x->data + r*d;
+        float * y = (float *) dst->data + r*d;
+        double mean = 0.0, var = 0.0;
+        for (int64_t c = 0; c < d; c++) mean += xr[c];
+        mean /= d;
+        for (int64_t c = 0; c < d; c++) var += (xr[c] - mean)*(xr[c] - mean);
+        const float rstd = (float) (1.0/sqrt(var/d + eps));
+        for (int64_t c = 0; c < d; c++) y[c] = (xr[c] - (float) mean)*rstd*w[c] + b[c];
+    }
+}
+
+// ggml_compute_forward_pet_layer_norm_back: dx = rstd (g w - mean(g w) - xhat mean(g w xhat))
+
+void ggml_compute_forward_pet_layer_norm_back(const ggml_compute_params * params, ggml_tensor * dst) {
+    const ggml_tensor * x = dst->src[0];
+    const float * w = (const float *) dst->src[1]->data, * g = (const float *) dst->src[2]->data;
+    const float eps = ggml_get_op_params_f32(dst, 0);
+    const int64_t d = x->ne[0], rows = ggml_nrows(x);
+    for (int64_t r = params->ith; r < rows; r += params->nth) {
+        const float * xr = (const float *) x->data + r*d, * gr = g + r*d;
+        float * dx = (float *) dst->data + r*d;
+        double mean = 0.0, var = 0.0;
+        for (int64_t c = 0; c < d; c++) mean += xr[c];
+        mean /= d;
+        for (int64_t c = 0; c < d; c++) var += (xr[c] - mean)*(xr[c] - mean);
+        const double rstd = 1.0/sqrt(var/d + eps);
+        double sg = 0.0, sgx = 0.0;
+        for (int64_t c = 0; c < d; c++) {
+            const double gw = (double) gr[c]*w[c];
+            sg += gw, sgx += gw*(xr[c] - mean)*rstd;
+        }
+        sg /= d, sgx /= d;
+        for (int64_t c = 0; c < d; c++)
+            dx[c] = (float) (rstd*((double) gr[c]*w[c] - sg - (xr[c] - mean)*rstd*sgx));
+    }
+}
+
+// ggml_compute_forward_pet_pair_norm: row e = LayerNorm([x[e]; x[rev[e]]]) * w + b
+
+static void pet_pair_stats(const float * a, const float * b, int64_t d, float eps, double & mean, double & rstd) {
+    mean = 0.0;
+    for (int64_t c = 0; c < d; c++) mean += a[c] + b[c];
+    mean /= 2*d;
+    double var = 0.0;
+    for (int64_t c = 0; c < d; c++) var += (a[c] - mean)*(a[c] - mean) + (b[c] - mean)*(b[c] - mean);
+    rstd = 1.0/sqrt(var/(2*d) + eps);
+}
+
+void ggml_compute_forward_pet_pair_norm(const ggml_compute_params * params, ggml_tensor * dst) {
+    const ggml_tensor * x = dst->src[0];
+    const int32_t * rev = (const int32_t *) dst->src[1]->data;
+    const float * w = (const float *) dst->src[2]->data, * bias = (const float *) dst->src[3]->data;
+    const float eps = ggml_get_op_params_f32(dst, 0);
+    const int64_t d = x->ne[0], E = x->ne[1];
+    for (int64_t e = params->ith; e < E; e += params->nth) {
+        const float * a = (const float *) x->data + e*d, * b = (const float *) x->data + (int64_t) rev[e]*d;
+        double mean, rstd;
+        pet_pair_stats(a, b, d, eps, mean, rstd);
+        float * y = (float *) dst->data + e*2*d;
+        for (int64_t c = 0; c < d; c++) {
+            y[c]     = (float) ((a[c] - mean)*rstd)*w[c] + bias[c];
+            y[d + c] = (float) ((b[c] - mean)*rstd)*w[d + c] + bias[d + c];
+        }
+    }
+}
+
+// ggml_compute_forward_pet_pair_norm_back: x[e] is the first half of pair e and the
+// second half of pair rev[e] (same numbers, so the same mean and rstd)
+
+void ggml_compute_forward_pet_pair_norm_back(const ggml_compute_params * params, ggml_tensor * dst) {
+    const ggml_tensor * x = dst->src[0];
+    const int32_t * rev = (const int32_t *) dst->src[1]->data;
+    const float * w = (const float *) dst->src[2]->data, * g = (const float *) dst->src[3]->data;
+    const float eps = ggml_get_op_params_f32(dst, 0);
+    const int64_t d = x->ne[0], E = x->ne[1];
+    for (int64_t e = params->ith; e < E; e += params->nth) {
+        const int64_t r = rev[e];
+        const float * a = (const float *) x->data + e*d, * b = (const float *) x->data + r*d;
+        double mean, rstd;
+        pet_pair_stats(a, b, d, eps, mean, rstd);
+        // pair e = [a; b] with gradient ge; pair r = [b; a] with gradient gr
+        const float * ge = g + e*2*d, * gr = g + r*2*d;
+        double se = 0.0, sxe = 0.0, sr = 0.0, sxr = 0.0;
+        for (int64_t c = 0; c < d; c++) {
+            const double xa = (a[c] - mean)*rstd, xb = (b[c] - mean)*rstd;
+            const double e0 = (double) ge[c]*w[c], e1 = (double) ge[d + c]*w[d + c];
+            const double r0 = (double) gr[c]*w[c], r1 = (double) gr[d + c]*w[d + c];
+            se += e0 + e1, sxe += e0*xa + e1*xb;
+            sr += r0 + r1, sxr += r0*xb + r1*xa;
+        }
+        se /= 2*d, sxe /= 2*d, sr /= 2*d, sxr /= 2*d;
+        float * dx = (float *) dst->data + e*d;
+        for (int64_t c = 0; c < d; c++) {
+            const double xa = (a[c] - mean)*rstd;
+            const double first  = rstd*((double) ge[c]*w[c] - se - xa*sxe);         // pair e, first half
+            const double second = rstd*((double) gr[d + c]*w[d + c] - sr - xa*sxr); // pair r, second half
+            dx[c] = (float) (first + second);
+        }
+    }
+}
