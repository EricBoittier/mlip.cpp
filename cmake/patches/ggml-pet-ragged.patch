+// ggml_compute_forward_pet_bump: [E, 2] = (fc, log(max(fc, eps)))
+
+static constexpr float PET_PI = 3.14159265358979323846f;
+
+static inline float pet_bump_t(float d, float pc, float width, float & c, bool & inside) {
+    const float s = (d - pc + width) / width;
+    inside = s > 1e-6f && s < 1.0f - 1e-6f;
+    c = std::min(std::max(s, 1e-6f), 1.0f - 1e-6f);
+    return 1.0f / tanf(PET_PI * c);
+}
+
+void ggml_compute_forward_pet_bump(const ggml_compute_params * params, ggml_tensor * dst) {
+    const float * d  = (const float *) dst->src[0]->data;
+    const float * pc = (const float *) dst->src[1]->data;
+    const float width = ggml_get_op_params_f32(dst, 0), eps = ggml_get_op_params_f32(dst, 1);
+    const int64_t E = dst->ne[0];
+    float * out = (float *) dst->data;
+    for (int64_t e = params->ith; e < E; e += params->nth) {
+        float c;
+        bool inside;
+        const float fc = 0.5f*(1.0f + tanhf(pet_bump_t(d[e], pc[e], width, c, inside)));
+        out[e] = fc, out[E + e] = logf(std::max(fc, eps));
+    }
+}
+
+// ggml_compute_forward_pet_bump_back: [E, 2] = (dL/dd, dL/dpc)
+
+void ggml_compute_forward_pet_bump_back(const ggml_compute_params * params, ggml_tensor * dst) {
+    const float * d  = (const float *) dst->src[0]->data;
+    const float * pc = (const float *) dst->src[1]->data;
+    const float * g  = (const float *) dst->src[2]->data;
+    const float width = ggml_get_op_params_f32(dst, 0), eps = ggml_get_op_params_f32(dst, 1);
+    const int64_t E = dst->ne[0];
+    float * out = (float *) dst->data;
+    for (int64_t e = params->ith; e < E; e += params->nth) {
+        float c;
+        bool inside;
+        const float th = tanhf(pet_bump_t(d[e], pc[e], width, c, inside));
+        const float fc = 0.5f*(1.0f + th);
+        const float sn = sinf(PET_PI * c);
+        // dfc/ds = 0.5 (1 - tanh^2) * d cot(pi c)/dc, zero where the clamp holds
+        const float dfc = inside ? 0.5f*(1.0f - th*th)*(-PET_PI/(sn*sn)) : 0.0f;
+        const float gfc = g[e] + (fc > eps ? g[E + e]/fc : 0.0f);
+        const float dd = gfc*dfc/width;
+        out[e] = dd, out[E + e] = -dd;
+    }
+}
