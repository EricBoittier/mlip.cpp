+bool ggml_cuda_pet_attn_ragged_supported(const ggml_tensor * op) {
+    const ggml_tensor * qkv = op->src[0];
+    const int H = ggml_get_op_params_i32(op, 0), max_len = ggml_get_op_params_i32(op, 1);
