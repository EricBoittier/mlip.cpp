+// ggml_compute_forward_pet_pair_norm: row e = LayerNorm([x[e]; x[rev[e]]]) * w + b
+
+static void pet_pair_stats(const float * a, const float * b, int64_t d, float eps, double & mean, double & rstd) {
+    mean = 0.0;
+    for (int64_t c = 0; c < d; c++) mean += a[c] + b[c];
+    mean /= 2*d;
+    double var = 0.0;
+    for (int64_t c = 0; c < d; c++) var += (a[c] - mean)*(a[c] - mean) + (b[c] - mean)*(b[c] - mean);
+    rstd = 1.0/sqrt(var/(2*d) + eps);
+}
+
+void ggml_compute_forward_pet_pair_norm(const ggml_compute_params * params, ggml_tensor * dst) {
+    const ggml_tensor * x = dst->src[0];
+    const int32_t * rev = (const int32_t *) dst->src[1]->data;
+    const float * w = (const float *) dst->src[2]->data, * bias = (const float *) dst->src[3]->data;
+    const float eps = ggml_get_op_params_f32(dst, 0);
+    const int64_t d = x->ne[0], E = x->ne[1];
+    for (int64_t e = params->ith; e < E; e += params->nth) {
+        const float * a = (const float *) x->data + e*d, * b = (const float *) x->data + (int64_t) rev[e]*d;
+        double mean, rstd;
+        pet_pair_stats(a, b, d, eps, mean, rstd);
+        float * y = (float *) dst->data + e*2*d;
+        for (int64_t c = 0; c < d; c++) {
+            y[c]     = (float) ((a[c] - mean)*rstd)*w[c] + bias[c];
+            y[d + c] = (float) ((b[c] - mean)*rstd)*w[d + c] + bias[d + c];
+        }
+    }
+}
+
+// ggml_compute_forward_pet_pair_norm_back: x[e] is the first half of pair e and the
+// second half of pair rev[e] (same numbers, so the same mean and rstd)
+
+void ggml_compute_forward_pet_pair_norm_back(const ggml_compute_params * params, ggml_tensor * dst) {
+    const ggml_tensor * x = dst->src[0];
+    const int32_t * rev = (const int32_t *) dst->src[1]->data;
+    const float * w = (const float *) dst->src[2]->data, * g = (const float *) dst->src[3]->data;
+    const float * acc = dst->src[4] ? (const float *) dst->src[4]->data : nullptr; // a residual's gradient, or none
+    const float eps = ggml_get_op_params_f32(dst, 0);
+    const int64_t d = x->ne[0], E = x->ne[1];
+    for (int64_t e = params->ith; e < E; e += params->nth) {
+        const int64_t r = rev[e];
+        const float * a = (const float *) x->data + e*d, * b = (const float *) x->data + r*d;
+        double mean, rstd;
+        pet_pair_stats(a, b, d, eps, mean, rstd);
+        // pair e = [a; b] with gradient ge; pair r = [b; a] with gradient gr
+        const float * ge = g + e*2*d, * gr = g + r*2*d;
+        double se = 0.0, sxe = 0.0, sr = 0.0, sxr = 0.0;
+        for (int64_t c = 0; c < d; c++) {
+            const double xa = (a[c] - mean)*rstd, xb = (b[c] - mean)*rstd;
+            const double e0 = (double) ge[c]*w[c], e1 = (double) ge[d + c]*w[d + c];
+            const double r0 = (double) gr[c]*w[c], r1 = (double) gr[d + c]*w[d + c];
+            se += e0 + e1, sxe += e0*xa + e1*xb;
+            sr += r0 + r1, sxr += r0*xb + r1*xa;
+        }
+        se /= 2*d, sxe /= 2*d, sr /= 2*d, sxr /= 2*d;
+        float * dx = (float *) dst->data + e*d;
+        for (int64_t c = 0; c < d; c++) {
+            const double xa = (a[c] - mean)*rstd;
+            const double first  = rstd*((double) ge[c]*w[c] - se - xa*sxe);         // pair e, first half
+            const double second = rstd*((double) gr[d + c]*w[d + c] - sr - xa*sxr); // pair r, second half
+            const float v = (float) (first + second);
+            dx[c] = acc ? v + acc[e*d + c] : v;
+        }
+    }
+}
