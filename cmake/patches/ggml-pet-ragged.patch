+// ggml_pet_bump
+
+struct ggml_tensor * ggml_pet_bump(
+        struct ggml_context * ctx,
+        struct ggml_tensor  * d,
+        struct ggml_tensor  * pc,
+        float                 width,
+        float                 eps) {
+    GGML_ASSERT(d->type == GGML_TYPE_F32 && pc->type == GGML_TYPE_F32);
+    GGML_ASSERT(ggml_is_contiguous(d) && ggml_is_contiguous(pc) && ggml_nelements(d) == ggml_nelements(pc));
+
+    struct ggml_tensor * result = ggml_new_tensor_2d(ctx, GGML_TYPE_F32, ggml_nelements(d), 2);
+
+    float params[2] = { width, eps };
+    ggml_set_op_params(result, params, sizeof(params));
+
+    result->op     = GGML_OP_PET_BUMP;
+    result->src[0] = d;
+    result->src[1] = pc;
+
+    return result;
+}
+
+// gradients of ggml_pet_bump's result (grad [E, 2]) w.r.t. d and pc: [E, 2]
+static struct ggml_tensor * ggml_pet_bump_back(
+        struct ggml_context * ctx,
+        struct ggml_tensor  * d,
+        struct ggml_tensor  * pc,
+        struct ggml_tensor  * grad,
+        float                 width,
+        float                 eps) {
+    GGML_ASSERT(ggml_is_contiguous(grad) && grad->ne[0] == ggml_nelements(d) && grad->ne[1] == 2);
+
+    struct ggml_tensor * result = ggml_new_tensor_2d(ctx, GGML_TYPE_F32, ggml_nelements(d), 2);
+
+    float params[2] = { width, eps };
+    ggml_set_op_params(result, params, sizeof(params));
+
+    result->op     = GGML_OP_PET_BUMP_BACK;
+    result->src[0] = d;
+    result->src[1] = pc;
+    result->src[2] = grad;
+
+    return result;
+}
+
+// ggml_pet_layer_norm
+
+struct ggml_tensor * ggml_pet_layer_norm(
+        struct ggml_context * ctx,
+        struct ggml_tensor  * x,
+        struct ggml_tensor  * weight,
+        struct ggml_tensor  * bias,
+        float                 eps) {
+    GGML_ASSERT(x->type == GGML_TYPE_F32 && weight->type == GGML_TYPE_F32 && bias->type == GGML_TYPE_F32);
+    GGML_ASSERT(ggml_is_contiguous(x) && ggml_is_contiguous(weight) && ggml_is_contiguous(bias));
+    GGML_ASSERT(ggml_nelements(weight) == x->ne[0] && ggml_nelements(bias) == x->ne[0]);
+
+    struct ggml_tensor * result = ggml_new_tensor(ctx, GGML_TYPE_F32, GGML_MAX_DIMS, x->ne);
+
+    ggml_set_op_params(result, &eps, sizeof(eps));
+
+    result->op     = GGML_OP_PET_LAYER_NORM;
+    result->src[0] = x;
+    result->src[1] = weight;
+    result->src[2] = bias;
+
+    return result;
+}
+
+static struct ggml_tensor * ggml_pet_layer_norm_back(
+        struct ggml_context * ctx,
+        struct ggml_tensor  * x,
+        struct ggml_tensor  * weight,
+        struct ggml_tensor  * grad,
+        float                 eps) {
+    GGML_ASSERT(ggml_is_contiguous(grad) && ggml_are_same_shape(x, grad));
+
+    struct ggml_tensor * result = ggml_new_tensor(ctx, GGML_TYPE_F32, GGML_MAX_DIMS, x->ne);
+
+    ggml_set_op_params(result, &eps, sizeof(eps));
+
+    result->op     = GGML_OP_PET_LAYER_NORM_BACK;
+    result->src[0] = x;
+    result->src[1] = weight;
+    result->src[2] = grad;
+
+    return result;
+}
+
+// ggml_pet_glu
+
+struct ggml_tensor * ggml_pet_glu(
+        struct ggml_context * ctx,
+        struct ggml_tensor  * h) {
+    GGML_ASSERT(h->type == GGML_TYPE_F32 && ggml_is_contiguous(h) && h->ne[0] % 2 == 0);
+
+    struct ggml_tensor * result = ggml_new_tensor_4d(ctx, GGML_TYPE_F32, h->ne[0]/2, h->ne[1], h->ne[2], h->ne[3]);
+
+    result->op     = GGML_OP_PET_GLU;
+    result->src[0] = h;
+
+    return result;
+}
+
+static struct ggml_tensor * ggml_pet_glu_back(
+        struct ggml_context * ctx,
+        struct ggml_tensor  * h,
+        struct ggml_tensor  * grad) {
+    GGML_ASSERT(ggml_is_contiguous(grad) && 2*grad->ne[0] == h->ne[0] && ggml_nrows(grad) == ggml_nrows(h));
+
+    struct ggml_tensor * result = ggml_new_tensor(ctx, GGML_TYPE_F32, GGML_MAX_DIMS, h->ne);
+
+    result->op     = GGML_OP_PET_GLU_BACK;
+    result->src[0] = h;
+    result->src[1] = grad;
+
+    return result;
+}
+
+// ggml_pet_rms_norm
+
+struct ggml_tensor * ggml_pet_rms_norm(
+        struct ggml_context * ctx,
+        struct ggml_tensor  * x,
+        struct ggml_tensor  * weight,
+        float                 eps) {
+    GGML_ASSERT(x->type == GGML_TYPE_F32 && weight->type == GGML_TYPE_F32);
+    GGML_ASSERT(ggml_is_contiguous(x) && ggml_is_contiguous(weight) && ggml_nelements(weight) == x->ne[0]);
+
+    struct ggml_tensor * result = ggml_new_tensor(ctx, GGML_TYPE_F32, GGML_MAX_DIMS, x->ne);
+
+    ggml_set_op_params(result, &eps, sizeof(eps));
+
+    result->op     = GGML_OP_PET_RMS_NORM;
+    result->src[0] = x;
+    result->src[1] = weight;
+
+    return result;
+}
+
+struct ggml_tensor * ggml_pet_add_rms_norm(
+        struct ggml_context * ctx,
+        struct ggml_tensor  * x,
+        struct ggml_tensor  * y,
+        struct ggml_tensor  * weight,
+        float                 eps) {
+    struct ggml_tensor * result = ggml_pet_rms_norm(ctx, ggml_add(ctx, x, y), weight, eps);
+    ggml_set_op_params_i32(result, 1, 1); // the CUDA backend may run the ADD of src[0] and this in one kernel
+    // read by that kernel: sources here too (not used otherwise, no gradient), so the allocator keeps them
+    // until the result is allocated, which then cannot overlap them (not src[2]: ggml_compute_backward
+    // checks the gradients of src[0..2])
+    result->src[3] = x;
+    result->src[4] = y;
+    return result;
+}
+
+// acc (or NULL): added to the gradient w.r.t. x
+static struct ggml_tensor * ggml_pet_rms_norm_back(
+        struct ggml_context * ctx,
+        struct ggml_tensor  * x,
+        struct ggml_tensor  * weight,
+        struct ggml_tensor  * grad,
+        struct ggml_tensor  * acc,
+        float                 eps) {
+    GGML_ASSERT(ggml_is_contiguous(grad) && ggml_are_same_shape(x, grad));
+    GGML_ASSERT(!acc || (acc->type == GGML_TYPE_F32 && ggml_is_contiguous(acc) && ggml_are_same_shape(x, acc)));
+
+    struct ggml_tensor * result = ggml_new_tensor(ctx, GGML_TYPE_F32, GGML_MAX_DIMS, x->ne);
+
+    ggml_set_op_params(result, &eps, sizeof(eps));
+
+    result->op     = GGML_OP_PET_RMS_NORM_BACK;
+    result->src[0] = x;
+    result->src[1] = weight;
+    result->src[2] = grad;
+    result->src[3] = acc;
+
+    return result;
+}
+
+// ggml_pet_pair_norm
+
+struct ggml_tensor * ggml_pet_pair_norm(
+        struct ggml_context * ctx,
+        struct ggml_tensor  * x,
+        struct ggml_tensor  * rev,
+        struct ggml_tensor  * weight,
+        struct ggml_tensor  * bias,
+        float                 eps) {
+    GGML_ASSERT(x->type == GGML_TYPE_F32 && rev->type == GGML_TYPE_I32 && weight->type == GGML_TYPE_F32 && bias->type == GGML_TYPE_F32);
+    GGML_ASSERT(ggml_is_contiguous(x) && ggml_is_contiguous(rev) && ggml_is_contiguous(weight) && ggml_is_contiguous(bias));
+    GGML_ASSERT(ggml_n_dims(x) <= 2 && ggml_nelements(rev) == x->ne[1]);
+    GGML_ASSERT(ggml_nelements(weight) == 2*x->ne[0] && ggml_nelements(bias) == 2*x->ne[0]);
+
+    struct ggml_tensor * result = ggml_new_tensor_2d(ctx, GGML_TYPE_F32, 2*x->ne[0], x->ne[1]);
+
+    ggml_set_op_params(result, &eps, sizeof(eps));
+
+    result->op     = GGML_OP_PET_PAIR_NORM;
+    result->src[0] = x;
+    result->src[1] = rev;
+    result->src[2] = weight;
+    result->src[3] = bias;
+
+    return result;
+}
+
+static struct ggml_tensor * ggml_pet_pair_norm_back(
+        struct ggml_context * ctx,
+        struct ggml_tensor  * x,
+        struct ggml_tensor  * rev,
+        struct ggml_tensor  * weight,
+        struct ggml_tensor  * grad,
+        struct ggml_tensor  * acc,
+        float                 eps) {
+    GGML_ASSERT(ggml_is_contiguous(grad) && grad->ne[0] == 2*x->ne[0] && grad->ne[1] == x->ne[1]);
+    GGML_ASSERT(!acc || (acc->type == GGML_TYPE_F32 && ggml_is_contiguous(acc) && ggml_are_same_shape(x, acc)));
+
+    struct ggml_tensor * result = ggml_new_tensor(ctx, GGML_TYPE_F32, GGML_MAX_DIMS, x->ne);
+
+    ggml_set_op_params(result, &eps, sizeof(eps));
+
+    result->op     = GGML_OP_PET_PAIR_NORM_BACK;
+    result->src[0] = x;
+    result->src[1] = rev;
+    result->src[2] = weight;
+    result->src[3] = grad;
+    result->src[4] = acc;
+
+    return result;
+}
+
+struct ggml_tensor * ggml_pet_pair_norm_acc(
+        struct ggml_context * ctx,
+        struct ggml_tensor  * x,
+        struct ggml_tensor  * rev,
+        struct ggml_tensor  * weight,
+        struct ggml_tensor  * bias,
+        float                 eps) {
+    struct ggml_tensor * result = ggml_pet_pair_norm(ctx, x, rev, weight, bias, eps);
+    ggml_set_op_params_i32(result, 1, 1); // the backward sums the residual's gradient
+    return result;
+}
+
+// ggml_pet_attn_ragged
+
+struct ggml_tensor * ggml_pet_attn_ragged(
+        struct ggml_context * ctx,
+        struct ggml_tensor  * qkv,
+        struct ggml_tensor  * bias,
+        struct ggml_tensor  * off,
+        int                   n_head,
+        int                   max_len,
+        float                 scale) {
+    GGML_ASSERT(qkv->type == GGML_TYPE_F32 && bias->type == GGML_TYPE_F32 && off->type == GGML_TYPE_I32);
+    GGML_ASSERT(ggml_is_contiguous(qkv) && ggml_is_contiguous(bias) && ggml_is_contiguous(off));
+    GGML_ASSERT(ggml_n_dims(qkv) <= 2 && n_head > 0 && qkv->ne[0] % (3*n_head) == 0 && max_len > 0);
+    const int64_t D = qkv->ne[0] / 3, T = qkv->ne[1];
+    GGML_ASSERT(ggml_nelements(off) >= 1 && ggml_nelements(off) - 1 <= T && ggml_nelements(bias) == T - (ggml_nelements(off) - 1));
+
+    // [D, T] outputs, then the [H, T] log-sum-exps as further columns of D: the
+    // outputs are a box of the result (their gradient is a PAD of it)
+    struct ggml_tensor * result = ggml_new_tensor_2d(ctx, GGML_TYPE_F32, D, T + (n_head*T + D - 1)/D);
+
+    int32_t params[3] = { n_head, max_len, 0 };
+    memcpy(params + 2, &scale, sizeof(float));
+    ggml_set_op_params(result, params, sizeof(params));
+
+    result->op     = GGML_OP_PET_ATTN_RAGGED;
+    result->src[0] = qkv;
+    result->src[1] = bias;
+    result->src[2] = off;
+
+    return result;
+}
+
+// gradients of ggml_pet_attn_ragged (given its result and the gradient of
+// that): [3D * T] w.r.t. qkv, then [H * T] per-head gradients w.r.t. bias
+static struct ggml_tensor * ggml_pet_attn_ragged_back(
+        struct ggml_context * ctx,
+        struct ggml_tensor  * attn,
+        struct ggml_tensor  * grad) {
+    GGML_ASSERT(ggml_is_contiguous(grad) && ggml_are_same_shape(grad, attn));
+    struct ggml_tensor * qkv = attn->src[0];
+    const int32_t n_head = ggml_get_op_params_i32(attn, 0);
+
+    struct ggml_tensor * result = ggml_new_tensor_1d(ctx, GGML_TYPE_F32, (qkv->ne[0] + n_head)*qkv->ne[1]);
+
+    ggml_set_op_params(result, attn->op_params, 3*sizeof(int32_t));
+
+    result->op     = GGML_OP_PET_ATTN_RAGGED_BACK;
+    result->src[0] = qkv;
+    result->src[1] = attn->src[1];
+    result->src[2] = attn->src[2];
+    result->src[3] = attn;
+    result->src[4] = grad;
+
+    return result;
+}
