+
+    uint32_t qa[MT][KS][4], ga[MT][KS][4];
+    rg_load_a<d, MT>(qa, qkv,  sq, 3*D, h*d, q0, lane);
+    rg_load_a<d, MT>(ga, grad, sq, D,   h*d, q0, lane);
+    float ls[MT][2], Di[MT][2], dq[MT][ND][4];
+#pragma unroll
+    for (int mt = 0; mt < MT; mt++) {
+#pragma unroll
+        for (int u = 0; u < 2; u++) {
+            const int i = q0 + mt*16 + g + u*8;
+            float s = 0.0f;
+            if (i < L) {
+                const int64_t row = sq.row(i);
+                const float * gr = grad + row*D + h*d, * orow = res + row*D + h*d;
+#pragma unroll
+                for (int c = 2*tq; c < d; c += 8) s += gr[c]*orow[c] + gr[c + 1]*orow[c + 1];
+            }
+            s += __shfl_xor_sync(0xffffffff, s, 1);
+            s += __shfl_xor_sync(0xffffffff, s, 2);
+            Di[mt][u] = s;
+            ls[mt][u] = i < L ? lse[sq.row(i)*H + h] : 0.0f;
+        }
+#pragma unroll
+        for (int dn = 0; dn < ND; dn++) dq[mt][dn][0] = dq[mt][dn][1] = dq[mt][dn][2] = dq[mt][dn][3] = 0.0f;
+    }
+
+    for (int k0 = 0; k0 < L; k0 += RG_TS) {
+        const int nk = min(RG_TS, L - k0);
+        rg_stage<d>(Ks, qkv, sq, k0, nk, 3*D,   D + h0*d, HB, t, blockDim.x);
+        rg_stage<d>(Vs, qkv, sq, k0, nk, 3*D, 2*D + h0*d, HB, t, blockDim.x);
+        for (int e = t; e < RG_TS; e += blockDim.x) Bs[e] = e < nk ? rg_bias(bias, sq.row(k0 + e), N) : 0.0f;
+        __syncthreads();
+        const __nv_bfloat16 * Kh = Ks + w*RG_TS*SD, * Vh = Vs + w*RG_TS*SD;
+        uint32_t kb[NS][KS][2], vb[NS][KS][2], kt[RG_TS/16][ND][2];
+#pragma unroll
+        for (int nt = 0; nt < NS; nt += 2)
+#pragma unroll
+            for (int ks = 0; ks < KS; ks++) {
+                uint32_t r[4];
+                rg_ldsm_b2<false>(r, Kh + nt*8*SD + ks*16, SD, lane);
+                kb[nt][ks][0] = r[0], kb[nt][ks][1] = r[1], kb[nt + 1][ks][0] = r[2], kb[nt + 1][ks][1] = r[3];
+                rg_ldsm_b2<false>(r, Vh + nt*8*SD + ks*16, SD, lane);
+                vb[nt][ks][0] = r[0], vb[nt][ks][1] = r[1], vb[nt + 1][ks][0] = r[2], vb[nt + 1][ks][1] = r[3];
+            }
+#pragma unroll
+        for (int j = 0; j < RG_TS/16; j++)
+#pragma unroll
+            for (int dn = 0; dn < ND; dn += 2) {
+                uint32_t r[4];
+                rg_ldsm_b2<true>(r, Kh + j*16*SD + dn*8, SD, lane);
+                kt[j][dn][0] = r[0], kt[j][dn][1] = r[1], kt[j][dn + 1][0] = r[2], kt[j][dn + 1][1] = r[3];
+            }
+#pragma unroll
+        for (int mt = 0; mt < MT; mt++) {
+            float s[NS][4], dp[NS][4];
+#pragma unroll
+            for (int nt = 0; nt < NS; nt++) {
+#pragma unroll
+                for (int f = 0; f < 4; f++) s[nt][f] = dp[nt][f] = 0.0f;
+#pragma unroll
+                for (int ks = 0; ks < KS; ks++) {
+                    rg_mma(s[nt],  qa[mt][ks], kb[nt][ks][0], kb[nt][ks][1]);
+                    rg_mma(dp[nt], ga[mt][ks], vb[nt][ks][0], vb[nt][ks][1]);
+                }
+#pragma unroll
+                for (int f = 0; f < 4; f++) {
+                    const int kk = nt*8 + 2*tq + (f & 1);
+                    const float p = kk < nk ? __expf(scale*s[nt][f] + Bs[kk] - ls[mt][f >> 1]) : 0.0f;
+                    s[nt][f] = p*(dp[nt][f] - Di[mt][f >> 1]);
+                }
+            }
+#pragma unroll
+            for (int j = 0; j < RG_TS/16; j++) {
+                const uint32_t da[4] = {
+                    rg_pack(s[2*j][0], s[2*j][1]), rg_pack(s[2*j][2], s[2*j][3]),
+                    rg_pack(s[2*j + 1][0], s[2*j + 1][1]), rg_pack(s[2*j + 1][2], s[2*j + 1][3])};
+#pragma unroll
+                for (int dn = 0; dn < ND; dn++) rg_mma(dq[mt][dn], da, kt[j][dn][0], kt[j][dn][1]);
+            }
+        }
+        __syncthreads();
+    }
+#pragma unroll
+    for (int mt = 0; mt < MT; mt++)
+#pragma unroll
+        for (int u = 0; u < 2; u++) {
+            const int i = q0 + mt*16 + g + u*8;
+            if (i >= L) continue;
+            float * po = dx + sq.row(i)*3*D + h*d;
+#pragma unroll
+            for (int dn = 0; dn < ND; dn++) {
+                po[dn*8 + 2*tq]     = scale*dq[mt][dn][2*u];
+                po[dn*8 + 2*tq + 1] = scale*dq[mt][dn][2*u + 1];
+            }
+        }
+}
+
+// dk = scale * sum_q p (dp - Di) q, dv = sum_q p dO, db = sum_q dS; per warp: one
+// head, 16*MT keys (the transposed products: rows are keys, columns streamed queries)
+template <int d, int MT>
+static __global__ void __launch_bounds__(256) rg_bwd_dkv(
+        const float * __restrict__ qkv, const float * __restrict__ bias, const int32_t * __restrict__ off,
+        const float * __restrict__ res, const float * __restrict__ lse, const float * __restrict__ grad,
+        float * __restrict__ dx, float * __restrict__ db, const int N, const int H, const int HB, const float scale) {
+    constexpr int SD = d + 8, KS = d/16, ND = d/8, NS = RG_TS/8, TK = 16*MT;
+    extern __shared__ float4 sm4[];
+    __nv_bfloat16 * Qs  = reinterpret_cast<__nv_bfloat16 *>(sm4);
+    __nv_bfloat16 * dOs = Qs + HB*RG_TS*SD;
+    float         * Ls  = reinterpret_cast<float *>(dOs + HB*RG_TS*SD); // [HB][TS]
+    float         * Ds  = Ls + HB*RG_TS;                                // [HB][TS]
+
+    const int n = blockIdx.x;
+    const rg_seq sq{n, (int64_t) N + off[n], 1 + off[n + 1] - off[n]};
+    const int L = sq.L, k0 = blockIdx.y*TK;
+    if (k0 >= L) return;
+    const int D = H*d, t = threadIdx.x, w = t >> 5, lane = t & 31, g = lane >> 2, tq = lane & 3;
+    const int h0 = blockIdx.z*HB, h = h0 + w;
+
+    uint32_t ka[MT][KS][4], va[MT][KS][4];
+    rg_load_a<d, MT>(ka, qkv, sq, 3*D,   D + h*d, k0, lane);
+    rg_load_a<d, MT>(va, qkv, sq, 3*D, 2*D + h*d, k0, lane);
+    float dk[MT][ND][4], dv[MT][ND][4], bk[MT][2], dbk[MT][2];
+#pragma unroll
+    for (int mt = 0; mt < MT; mt++) {
+#pragma unroll
+        for (int dn = 0; dn < ND; dn++)
+#pragma unroll
+            for (int f = 0; f < 4; f++) dk[mt][dn][f] = dv[mt][dn][f] = 0.0f;
+#pragma unroll
+        for (int u = 0; u < 2; u++) {
+            const int j = k0 + mt*16 + g + u*8;
+            bk[mt][u] = j < L ? rg_bias(bias, sq.row(j), N) : 0.0f, dbk[mt][u] = 0.0f;
+        }
+    }
+
+    for (int q0 = 0; q0 < L; q0 += RG_TS) {
+        const int nq = min(RG_TS, L - q0);
+        rg_stage<d>(Qs,  qkv,  sq, q0, nq, 3*D, h0*d, HB, t, blockDim.x);
+        rg_stage<d>(dOs, grad, sq, q0, nq, D,   h0*d, HB, t, blockDim.x);
+        for (int e = t; e < HB*RG_TS; e += blockDim.x) {
+            const int hb = e / RG_TS, qq = e % RG_TS;
+            float lq = 0.0f, s = 0.0f;
+            if (qq < nq) {
+                const int64_t row = sq.row(q0 + qq);
+                const float * gr = grad + row*D + (h0 + hb)*d, * orow = res + row*D + (h0 + hb)*d;
+                for (int c = 0; c < d; c++) s += gr[c]*orow[c];
+                lq = lse[row*H + h0 + hb];
+            }
+            Ls[e] = lq, Ds[e] = s;
+        }
+        __syncthreads();
+        const __nv_bfloat16 * Qh = Qs + w*RG_TS*SD, * Gh = dOs + w*RG_TS*SD;
+        const float * Lh = Ls + w*RG_TS, * Dh = Ds + w*RG_TS;
+        uint32_t qb[NS][KS][2], gb[NS][KS][2], qt[RG_TS/16][ND][2], gt[RG_TS/16][ND][2];
+#pragma unroll
+        for (int nt = 0; nt < NS; nt += 2)
+#pragma unroll
+            for (int ks = 0; ks < KS; ks++) {
+                uint32_t r[4];
+                rg_ldsm_b2<false>(r, Qh + nt*8*SD + ks*16, SD, lane);
+                qb[nt][ks][0] = r[0], qb[nt][ks][1] = r[1], qb[nt + 1][ks][0] = r[2], qb[nt + 1][ks][1] = r[3];
+                rg_ldsm_b2<false>(r, Gh + nt*8*SD + ks*16, SD, lane);
+                gb[nt][ks][0] = r[0], gb[nt][ks][1] = r[1], gb[nt + 1][ks][0] = r[2], gb[nt + 1][ks][1] = r[3];
+            }
+#pragma unroll
+        for (int j = 0; j < RG_TS/16; j++)
+#pragma unroll
+            for (int dn = 0; dn < ND; dn += 2) {
+                uint32_t r[4];
+                rg_ldsm_b2<true>(r, Qh + j*16*SD + dn*8, SD, lane);
+                qt[j][dn][0] = r[0], qt[j][dn][1] = r[1], qt[j][dn + 1][0] = r[2], qt[j][dn + 1][1] = r[3];
+                rg_ldsm_b2<true>(r, Gh + j*16*SD + dn*8, SD, lane);
+                gt[j][dn][0] = r[0], gt[j][dn][1] = r[1], gt[j][dn + 1][0] = r[2], gt[j][dn + 1][1] = r[3];
+            }
+#pragma unroll
+        for (int mt = 0; mt < MT; mt++) {
+            float p[NS][4], ds[NS][4];
+#pragma unroll
+            for (int nt = 0; nt < NS; nt++) {
+#pragma unroll
+                for (int f = 0; f < 4; f++) p[nt][f] = ds[nt][f] = 0.0f;
+#pragma unroll
+                for (int ks = 0; ks < KS; ks++) {
+                    rg_mma(p[nt],  ka[mt][ks], qb[nt][ks][0], qb[nt][ks][1]);
+                    rg_mma(ds[nt], va[mt][ks], gb[nt][ks][0], gb[nt][ks][1]);
+                }
+#pragma unroll
+                for (int f = 0; f < 4; f++) {
+                    const int qq = nt*8 + 2*tq + (f & 1);
+                    const float pv = qq < nq ? __expf(scale*p[nt][f] + bk[mt][f >> 1] - Lh[qq]) : 0.0f;
+                    p[nt][f]  = pv;
+                    ds[nt][f] = pv*(ds[nt][f] - Dh[qq]);
+                    dbk[mt][f >> 1] += ds[nt][f];
+                }
+            }
+#pragma unroll
+            for (int j = 0; j < RG_TS/16; j++) {
+                const uint32_t pa[4] = {
+                    rg_pack(p[2*j][0], p[2*j][1]), rg_pack(p[2*j][2], p[2*j][3]),
+                    rg_pack(p[2*j + 1][0], p[2*j + 1][1]), rg_pack(p[2*j + 1][2], p[2*j + 1][3])};
+                const uint32_t da[4] = {
+                    rg_pack(ds[2*j][0], ds[2*j][1]), rg_pack(ds[2*j][2], ds[2*j][3]),
+                    rg_pack(ds[2*j + 1][0], ds[2*j + 1][1]), rg_pack(ds[2*j + 1][2], ds[2*j + 1][3])};
+#pragma unroll
+                for (int dn = 0; dn < ND; dn++) {
+                    rg_mma(dv[mt][dn], pa, gt[j][dn][0], gt[j][dn][1]);
+                    rg_mma(dk[mt][dn], da, qt[j][dn][0], qt[j][dn][1]);
+                }
+            }
+        }
+        __syncthreads();
+    }
+#pragma unroll
+    for (int mt = 0; mt < MT; mt++)
+#pragma unroll
+        for (int u = 0; u < 2; u++) {
+            float b = dbk[mt][u];
+            b += __shfl_xor_sync(0xffffffff, b, 1);
+            b += __shfl_xor_sync(0xffffffff, b, 2);
+            const int j = k0 + mt*16 + g + u*8;
+            if (j >= L) continue;
+            const int64_t row = sq.row(j);
+            float * po = dx + row*3*D + h*d;
+#pragma unroll
+            for (int dn = 0; dn < ND; dn++) {
+                po[D + dn*8 + 2*tq]       = scale*dk[mt][dn][2*u];
+                po[D + dn*8 + 2*tq + 1]   = scale*dk[mt][dn][2*u + 1];
+                po[2*D + dn*8 + 2*tq]     = dv[mt][dn][2*u];
+                po[2*D + dn*8 + 2*tq + 1] = dv[mt][dn][2*u + 1];
+            }
+            if (tq == 0) db[row*H + h] = b;
+        }
+}
+
+// rows [N + off[N], T) belong to no sequence: zero their `w` floats of a and `hb` floats of b
+static __global__ void rg_zero_tail(const int32_t * __restrict__ off, const int N, const int64_t T,
+        float * __restrict__ a, const int w, float * __restrict__ b, const int hb) {
+    const int64_t r = (int64_t) N + off[N] + blockIdx.x;
+    if (r >= T) return;
+    for (int c = threadIdx.x; c < w; c += blockDim.x) a[r*w + c] = 0.0f;
+    for (int c = threadIdx.x; c < hb; c += blockDim.x) b[r*hb + c] = 0.0f;
+}
+
+static size_t rg_smem(int HB, int d, bool dkv) {
+    return 2*(size_t) HB*RG_TS*(d + 8)*2 + (dkv ? 2*(size_t) HB*RG_TS*4 : (size_t) RG_TS*4);
+}
+
+// heads per block: the largest divisor of H <= 8 whose tiles fit
+static int rg_heads(int H, int d) {
+    for (int HB = std::min(H, 8); HB >= 1; HB--)
+        if (H % HB == 0 && rg_smem(HB, d, true) <= RG_SMEM) return HB;
+    return 0;
+}
+
+template <int d, int MT>
+static void rg_launch_mt(ggml_backend_cuda_context & ctx, ggml_tensor * dst, int which, int HB) {
+    const ggml_tensor * qkv = dst->src[0];
+    const int H = ggml_get_op_params_i32(dst, 0), max_len = ggml_get_op_params_i32(dst, 1);
+    const float scale = ggml_get_op_params_f32(dst, 2);
+    const int N = (int) (ggml_nelements(dst->src[2]) - 1);
+    const int64_t D = qkv->ne[0] / 3, T = qkv->ne[1];
+    const float * q = (const float *) qkv->data, * b = (const float *) dst->src[1]->data;
+    const int32_t * off = (const int32_t *) dst->src[2]->data;
+    const dim3 grid((unsigned) N, (max_len + 16*MT - 1)/(16*MT), H/HB), block(32*HB);
+    cudaStream_t stream = ctx.stream();
+    if (which == 0) {
+        float * out = (float *) dst->data, * lse = out + D*T;
+        rg_fwd<d, MT><<<grid, block, rg_smem(HB, d, false), stream>>>(q, b, off, out, lse, N, H, HB, scale);
+    } else {
+        const float * res = (const float *) dst->src[3]->data, * lse = res + D*T, * grad = (const float *) dst->src[4]->data;
+        float * dx = (float *) dst->data, * db = dx + 3*D*T;
+        if (which == 1) rg_bwd_dq <d, MT><<<grid, block, rg_smem(HB, d, false), stream>>>(q, b, off, res, lse, grad, dx, N, H, HB, scale);
+        else            rg_bwd_dkv<d, MT><<<grid, block, rg_smem(HB, d, true),  stream>>>(q, b, off, res, lse, grad, dx, db, N, H, HB, scale);
+    }
+}
+
+template <int d>
+static void rg_launch(ggml_backend_cuda_context & ctx, ggml_tensor * dst, bool back) {
+    const ggml_tensor * qkv = dst->src[0];
+    const int H = ggml_get_op_params_i32(dst, 0), max_len = ggml_get_op_params_i32(dst, 1);
+    const int N = (int) (ggml_nelements(dst->src[2]) - 1);
+    const int64_t D = qkv->ne[0] / 3, T = qkv->ne[1], tail = T - N;
+    const int HB = rg_heads(H, d);
+    cudaStream_t stream = ctx.stream();
+    const int32_t * off = (const int32_t *) dst->src[2]->data;
+    if (tail > 0) {
+        float * a = (float *) dst->data;
+        if (!back) rg_zero_tail<<<(unsigned) tail, 128, 0, stream>>>(off, N, T, a, (int) D, a + D*T, H);
+        else       rg_zero_tail<<<(unsigned) tail, 128, 0, stream>>>(off, N, T, a, (int) (3*D), a + 3*D*T, H);
+    }
+    if (N > 0) {
+        // rows per warp: 32 (MT 2) for sequences longer than 16 tokens
+        for (int which = back ? 1 : 0; which <= (back ? 2 : 0); which++) {
+            if (max_len > 16) rg_launch_mt<d, 2>(ctx, dst, which, HB);
+            else              rg_launch_mt<d, 1>(ctx, dst, which, HB);
+        }
+    }
+    CUDA_CHECK(cudaGetLastError());
+}
+
+bool ggml_cuda_pet_attn_ragged_bf16(ggml_backend_cuda_context & ctx, ggml_tensor * dst, bool back) {
+    static const bool on = [] { const char * e = getenv("GGML_PET_RAGGED_BF16"); return e && atoi(e) != 0; }();
+    if (!on) return false;
+    const int H = ggml_get_op_params_i32(dst, 0);
+    const int64_t d = dst->src[0]->ne[0] / 3 / H;
+    if ((d != 16 && d != 32 && d != 64) || !ampere_mma_available(ggml_cuda_info().devices[ctx.device].cc) ||
+        rg_heads(H, (int) d) == 0)
+        return false;
+    switch (d) {
+        case 16: rg_launch<16>(ctx, dst, back); break;
+        case 32: rg_launch<32>(ctx, dst, back); break;
+        case 64: rg_launch<64>(ctx, dst, back); break;
+    }
+    return true;
+}
