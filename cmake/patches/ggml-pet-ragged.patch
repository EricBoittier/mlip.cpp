+
+static void pet_ragged_dispatch(ggml_backend_cuda_context & ctx, ggml_tensor * dst, bool back) {
+    if (ggml_cuda_pet_attn_ragged_bf16(ctx, dst, back)) return; // GGML_PET_RAGGED_BF16=1 (pet-ragged-bf16.cu)
+    const pet_ragged_args a = pet_ragged_get(dst);
+    switch (a.D / a.H) {
+        case 8:  pet_ragged_launch<8>(ctx, dst, back);  break;
+        case 16: pet_ragged_launch<16>(ctx, dst, back); break;
+        case 32: pet_ragged_launch<32>(ctx, dst, back); break;
+        case 64: pet_ragged_launch<64>(ctx, dst, back); break;
+        default: GGML_ABORT("pet_attn_ragged: unsupported head size");
+    }
+}
+
+void ggml_cuda_op_pet_attn_ragged(ggml_backend_cuda_context & ctx, ggml_tensor * dst) { pet_ragged_dispatch(ctx, dst, false); }
+void ggml_cuda_op_pet_attn_ragged_back(ggml_backend_cuda_context & ctx, ggml_tensor * dst) { pet_ragged_dispatch(ctx, dst, true); }
