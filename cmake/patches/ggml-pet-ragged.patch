+template <int d, int MT>
+static __global__ void __launch_bounds__(256) rg_fwd(
+        const float * __restrict__ qkv, const float * __restrict__ bias, const int32_t * __restrict__ off,
+        float * __restrict__ out, float * __restrict__ lse, const int N, const int H, const int HB, const float scale) {
