+// ggml_compute_forward_pet_glu: row [v; g] -> v * sigmoid(g)
+
+void ggml_compute_forward_pet_glu(const ggml_compute_params * params, ggml_tensor * dst) {
+    const ggml_tensor * h = dst->src[0];
+    const int64_t f = dst->ne[0], rows = ggml_nrows(dst);
+    for (int64_t r = params->ith; r < rows; r += params->nth) {
+        const float * v = (const float *) h->data + r*2*f, * g = v + f;
+        float * y = (float *) dst->data + r*f;
+        for (int64_t c = 0; c < f; c++) y[c] = (1.0f/(1.0f + expf(-g[c])))*v[c];
+    }
+}
+
+// ggml_compute_forward_pet_glu_back: [dy sigmoid(g); dy v sigmoid(g) (1 - sigmoid(g))]
+
+void ggml_compute_forward_pet_glu_back(const ggml_compute_params * params, ggml_tensor * dst) {
+    const ggml_tensor * h = dst->src[0];
+    const float * dy = (const float *) dst->src[1]->data;
+    const int64_t f = dst->ne[0]/2, rows = ggml_nrows(dst);
+    for (int64_t r = params->ith; r < rows; r += params->nth) {
+        const float * v = (const float *) h->data + r*2*f, * g = v + f, * dyr = dy + r*f;
+        float * dv = (float *) dst->data + r*2*f, * dg = dv + f;
+        for (int64_t c = 0; c < f; c++) {
+            const float s = 1.0f/(1.0f + expf(-g[c]));
+            dv[c] = s*dyr[c];
+            dg[c] = (s*(1.0f - s))*(dyr[c]*v[c]);
+        }
+    }
+}
