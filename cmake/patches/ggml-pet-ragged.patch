+    for (int i = 0; i < GGML_MAX_SRC && op->src[i]; i++)
+        if (!ggml_is_contiguous(op->src[i])) return false;
+    if (qkv->type != GGML_TYPE_F32 || ggml_nelements(op->src[2]) - 1 > INT32_MAX || max_len > (1 << 20)) return false;
+    return (d == 8 || d == 16 || d == 32 || d == 64) && H <= 256;
