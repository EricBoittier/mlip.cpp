+#include "pet-ragged.cuh"
+#include <cstring>
+
+// ---- bump cutoff ----
+
+static constexpr float PET_PI = 3.14159265358979323846f;
+
+static __device__ __forceinline__ float pet_bump_t(const float d, const float pc, const float width, float & c, bool & inside) {
+    const float s = (d - pc + width) / width;
+    inside = s > 1e-6f && s < 1.0f - 1e-6f;
+    c = fminf(fmaxf(s, 1e-6f), 1.0f - 1e-6f);
+    return 1.0f / tanf(PET_PI * c);
+}
+
+static __global__ void pet_bump_kernel(const float * __restrict__ d, const float * __restrict__ pc, float * __restrict__ out,
+        const int64_t E, const float width, const float eps) {
+    const int64_t e = (int64_t) blockIdx.x*blockDim.x + threadIdx.x;
+    if (e >= E) return;
+    float c;
+    bool inside;
+    const float fc = 0.5f*(1.0f + tanhf(pet_bump_t(d[e], pc[e], width, c, inside)));
+    out[e] = fc, out[E + e] = logf(fmaxf(fc, eps));
+}
+
+static __global__ void pet_bump_back_kernel(const float * __restrict__ d, const float * __restrict__ pc, const float * __restrict__ g,
+        float * __restrict__ out, const int64_t E, const float width, const float eps) {
+    const int64_t e = (int64_t) blockIdx.x*blockDim.x + threadIdx.x;
+    if (e >= E) return;
+    float c;
+    bool inside;
+    const float th = tanhf(pet_bump_t(d[e], pc[e], width, c, inside));
+    const float fc = 0.5f*(1.0f + th);
+    const float sn = sinf(PET_PI*c);
+    const float dfc = inside ? 0.5f*(1.0f - th*th)*(-PET_PI/(sn*sn)) : 0.0f;
+    const float gfc = g[e] + (fc > eps ? g[E + e]/fc : 0.0f);
+    const float dd = gfc*dfc/width;
+    out[e] = dd, out[E + e] = -dd;
+}
+
+void ggml_cuda_op_pet_bump(ggml_backend_cuda_context & ctx, ggml_tensor * dst) {
+    const int64_t E = dst->ne[0];
+    if (E == 0) return;
+    pet_bump_kernel<<<(E + 255) / 256, 256, 0, ctx.stream()>>>((const float *) dst->src[0]->data, (const float *) dst->src[1]->data,
+        (float *) dst->data, E, ggml_get_op_params_f32(dst, 0), ggml_get_op_params_f32(dst, 1));
+    CUDA_CHECK(cudaGetLastError());
+}
+
+void ggml_cuda_op_pet_bump_back(ggml_backend_cuda_context & ctx, ggml_tensor * dst) {
+    const int64_t E = dst->ne[0];
+    if (E == 0) return;
+    pet_bump_back_kernel<<<(E + 255) / 256, 256, 0, ctx.stream()>>>((const float *) dst->src[0]->data, (const float *) dst->src[1]->data,
+        (const float *) dst->src[2]->data, (float *) dst->data, E, ggml_get_op_params_f32(dst, 0), ggml_get_op_params_f32(dst, 1));
+    CUDA_CHECK(cudaGetLastError());
+}
+
+// ---- layer norm: one block per row ----
+
+// sum over the block of a and b (any blockDim.x that is a multiple of 32, at most 1024)
+static __device__ __forceinline__ float2 block_sum2(float a, float b) {
+    __shared__ float2 part[32];
+#pragma unroll
+    for (int o = 16; o > 0; o >>= 1) a += __shfl_xor_sync(0xffffffffu, a, o), b += __shfl_xor_sync(0xffffffffu, b, o);
+    const int lane = threadIdx.x % 32, warp = threadIdx.x / 32, nw = blockDim.x / 32;
+    __syncthreads(); // part may still be read by a previous call
+    if (lane == 0) part[warp] = make_float2(a, b);
+    __syncthreads();
+    float2 t = lane < nw ? part[lane] : make_float2(0.0f, 0.0f);
+#pragma unroll
+    for (int o = 16; o > 0; o >>= 1) t.x += __shfl_xor_sync(0xffffffffu, t.x, o), t.y += __shfl_xor_sync(0xffffffffu, t.y, o);
+    return t;
+}
+
+static __global__ void pet_layer_norm_kernel(const float * __restrict__ x, const float * __restrict__ w, const float * __restrict__ b,
+        float * __restrict__ y, const int d, const float eps) {
+    const int64_t row = blockIdx.x;
+    const float * xr = x + row*d;
+    float s = 0.0f;
+    for (int c = threadIdx.x; c < d; c += blockDim.x) s += xr[c];
+    const float mean = block_sum2(s, 0.0f).x / d;
+    float v = 0.0f;
+    for (int c = threadIdx.x; c < d; c += blockDim.x) v += (xr[c] - mean)*(xr[c] - mean);
+    const float rstd = rsqrtf(block_sum2(v, 0.0f).x / d + eps);
+    for (int c = threadIdx.x; c < d; c += blockDim.x) y[row*d + c] = (xr[c] - mean)*rstd*w[c] + b[c];
+}
+
+static __global__ void pet_layer_norm_back_kernel(const float * __restrict__ x, const float * __restrict__ w, const float * __restrict__ g,
+        float * __restrict__ dx, const int d, const float eps) {
+    const int64_t row = blockIdx.x;
+    const float * xr = x + row*d, * gr = g + row*d;
+    float s = 0.0f;
+    for (int c = threadIdx.x; c < d; c += blockDim.x) s += xr[c];
+    const float mean = block_sum2(s, 0.0f).x / d;
+    float v = 0.0f;
+    for (int c = threadIdx.x; c < d; c += blockDim.x) v += (xr[c] - mean)*(xr[c] - mean);
+    const float rstd = rsqrtf(block_sum2(v, 0.0f).x / d + eps);
+    float sg = 0.0f, sgx = 0.0f;
+    for (int c = threadIdx.x; c < d; c += blockDim.x) {
+        const float gw = gr[c]*w[c];
+        sg += gw, sgx += gw*(xr[c] - mean)*rstd;
+    }
+    const float2 t = block_sum2(sg, sgx);
+    const float mg = t.x / d, mgx = t.y / d;
+    for (int c = threadIdx.x; c < d; c += blockDim.x)
+        dx[row*d + c] = rstd*(gr[c]*w[c] - mg - (xr[c] - mean)*rstd*mgx);
+}
+
+static int pet_layer_norm_threads(int d) {
+    int t = 32;
+    while (t < 256 && t < d) t *= 2;
+    return t;
+}
+
+void ggml_cuda_op_pet_layer_norm(ggml_backend_cuda_context & ctx, ggml_tensor * dst) {
+    const ggml_tensor * x = dst->src[0];
+    const int64_t rows = ggml_nrows(x);
+    if (rows == 0) return;
+    const int d = (int) x->ne[0];
+    pet_layer_norm_kernel<<<(unsigned) rows, pet_layer_norm_threads(d), 0, ctx.stream()>>>((const float *) x->data,
+        (const float *) dst->src[1]->data, (const float *) dst->src[2]->data, (float *) dst->data, d, ggml_get_op_params_f32(dst, 0));
+    CUDA_CHECK(cudaGetLastError());
+}
+
+void ggml_cuda_op_pet_layer_norm_back(ggml_backend_cuda_context & ctx, ggml_tensor * dst) {
+    const ggml_tensor * x = dst->src[0];
+    const int64_t rows = ggml_nrows(x);
+    if (rows == 0) return;
+    const int d = (int) x->ne[0];
+    pet_layer_norm_back_kernel<<<(unsigned) rows, pet_layer_norm_threads(d), 0, ctx.stream()>>>((const float *) x->data,
+        (const float *) dst->src[1]->data, (const float *) dst->src[2]->data, (float *) dst->data, d, ggml_get_op_params_f32(dst, 0));
+    CUDA_CHECK(cudaGetLastError());
+}
+
+// ---- ragged attention ----
+// The register-blocked layout of pet-attn.cu's v2 kernels (a thread owns R
+// rows of one head; a block holds G row groups x H heads and streams the
+// other side of its sequence in tiles of TS rows through shared memory, rows
+// padded to d + 4 floats), over sequences of different lengths: block
+// (n, y) holds rows [y TP, (y + 1) TP) of sequence n, and returns at once
+// when the sequence is shorter. Token t of sequence n is row n (t = 0) or
+// row N + off[n] + t - 1. The bias belongs to the key alone.
+
+static constexpr int MAX_SMEM = 48*1024;
+
+struct pet_seq {
+    int64_t n, e0;
+    int L;
+    __device__ __forceinline__ int64_t row(const int t) const { return t == 0 ? n : e0 + t - 1; }
+};
+
+// edge keys carry a bias, central keys none: bias is [T - N], rows N .. T
+static __device__ __forceinline__ float key_bias(const float * __restrict__ bias, const int64_t row, const int N) {
+    return row < N ? 0.0f : bias[row - N];
+}
+
+static __device__ __forceinline__ pet_seq pet_sequence(const int32_t * __restrict__ off, const int N) {
+    const int n = blockIdx.x;
+    return {n, (int64_t) N + off[n], 1 + off[n + 1] - off[n]};
+}
+
+template <int d>
+static __device__ __forceinline__ void load_row(const float * __restrict__ s, float (&r)[d]) {
+#pragma unroll
+    for (int c = 0; c < d; c += 4) {
+        const float4 v = *reinterpret_cast<const float4 *>(s + c);
+        r[c] = v.x, r[c + 1] = v.y, r[c + 2] = v.z, r[c + 3] = v.w;
+    }
+}
+
+// tokens [k0, k0 + nk) of sequence `q`, columns [col, col + D) of rows of
+// `stride` floats, into shared F32 [nk][H][P]
+static __device__ __forceinline__ void stage_tokens(float * __restrict__ dst, const float * __restrict__ src, const pet_seq & q,
+        const int k0, const int nk, const int64_t stride, const int col, const int D, const int d, const int P, const int t, const int nt) {
+    const int H = D / d, D4 = D / 4;
+    for (int e = t; e < nk*D4; e += nt) {
+        const int r = e / D4, c = (e % D4)*4;
+        *reinterpret_cast<float4 *>(dst + (r*H + c / d)*P + c % d) =
+            *reinterpret_cast<const float4 *>(src + q.row(k0 + r)*stride + col + c);
+    }
+}
+
+template <int d, int R>
+static __global__ void pet_attn_ragged_fwd(
+        const float * __restrict__ qkv, const float * __restrict__ bias, const int32_t * __restrict__ off,
+        float * __restrict__ out, float * __restrict__ lse, const int N, const int H, const int TP, const int TS, const float scale) {
+    extern __shared__ float4 sm4[];
+    float * sm = reinterpret_cast<float *>(sm4);
+    const int D = H*d, P = d + 4, G = TP / R;
+    float * Ks = sm;            // [TS][H][P]
+    float * Vs = Ks + TS*H*P;   // [TS][H][P]
+    float * Bs = Vs + TS*H*P;   // [TS]
+
+    const pet_seq sq = pet_sequence(off, N);
+    const int L = sq.L, q0 = blockIdx.y*TP;
+    if (q0 >= L) return;
+    const int t = threadIdx.x, h = t % H, g = t / H;
+
+    float q[R][d], acc[R][d], m[R], l[R];
+#pragma unroll
+    for (int r = 0; r < R; r++) {
+        const int i = q0 + g + r*G;
+        m[r] = -INFINITY, l[r] = 0.0f;
+        const float * src = qkv + sq.row(i < L ? i : 0)*3*D + h*d;
+#pragma unroll
+        for (int c = 0; c < d; c++) q[r][c] = i < L ? scale*src[c] : 0.0f, acc[r][c] = 0.0f;
+    }
+
+    for (int k0 = 0; k0 < L; k0 += TS) {
+        const int nk = min(TS, L - k0);
+        stage_tokens(Ks, qkv, sq, k0, nk, 3*D,   D, D, d, P, t, blockDim.x);
+        stage_tokens(Vs, qkv, sq, k0, nk, 3*D, 2*D, D, d, P, t, blockDim.x);
+        for (int e = t; e < nk; e += blockDim.x) Bs[e] = key_bias(bias, sq.row(k0 + e), N);
+        __syncthreads();
+        for (int kk = 0; kk < nk; kk++) {
+            float kr[d], vr[d];
+            load_row<d>(Ks + (kk*H + h)*P, kr);
+            load_row<d>(Vs + (kk*H + h)*P, vr);
+            const float b = Bs[kk];
+#pragma unroll
+            for (int r = 0; r < R; r++) {
+                float s = b;
+#pragma unroll
+                for (int c = 0; c < d; c++) s += q[r][c]*kr[c];
+                if (s > m[r]) {
+                    const float corr = __expf(m[r] - s);
+                    l[r] *= corr;
+#pragma unroll
+                    for (int c = 0; c < d; c++) acc[r][c] *= corr;
+                    m[r] = s;
+                }
+                const float p = __expf(s - m[r]);
+                l[r] += p;
+#pragma unroll
+                for (int c = 0; c < d; c++) acc[r][c] += p*vr[c];
+            }
+        }
+        __syncthreads();
+    }
+#pragma unroll
+    for (int r = 0; r < R; r++) {
+        const int i = q0 + g + r*G;
+        if (i >= L) continue;
+        const int64_t row = sq.row(i);
+        float * o = out + row*D + h*d;
+#pragma unroll
+        for (int c = 0; c < d; c++) o[c] = acc[r][c]/l[r];
+        lse[row*H + h] = m[r] + logf(l[r]);
+    }
+}
+
+template <int d, int R>
+static __global__ void pet_attn_ragged_bwd_dq(
+        const float * __restrict__ qkv, const float * __restrict__ bias, const int32_t * __restrict__ off,
+        const float * __restrict__ res, const float * __restrict__ lse, const float * __restrict__ grad, float * __restrict__ dx,
+        const int N, const int H, const int TP, const int TS, const float scale) {
+    extern __shared__ float4 sm4[];
+    float * sm = reinterpret_cast<float *>(sm4);
+    const int D = H*d, P = d + 4, G = TP / R;
+    float * Ks = sm;
+    float * Vs = Ks + TS*H*P;
+    float * Bs = Vs + TS*H*P;   // [TS]
+
+    const pet_seq sq = pet_sequence(off, N);
+    const int L = sq.L, q0 = blockIdx.y*TP;
+    if (q0 >= L) return;
+    const int t = threadIdx.x, h = t % H, g = t / H;
+
+    float q[R][d], dO[R][d], dq[R][d], Di[R], ls[R];
+#pragma unroll
+    for (int r = 0; r < R; r++) {
+        const int i = q0 + g + r*G;
+        const bool ok = i < L;
+        const int64_t row = sq.row(ok ? i : 0);
+        Di[r] = 0.0f;
+#pragma unroll
+        for (int c = 0; c < d; c++) {
+            q[r][c]  = ok ? qkv[row*3*D + h*d + c] : 0.0f;
+            dO[r][c] = ok ? grad[row*D + h*d + c] : 0.0f;
+            Di[r]   += dO[r][c]*(ok ? res[row*D + h*d + c] : 0.0f);
+            dq[r][c] = 0.0f;
+        }
+        ls[r] = ok ? lse[row*H + h] : 0.0f;
+    }
+
+    for (int k0 = 0; k0 < L; k0 += TS) {
+        const int nk = min(TS, L - k0);
+        stage_tokens(Ks, qkv, sq, k0, nk, 3*D,   D, D, d, P, t, blockDim.x);
+        stage_tokens(Vs, qkv, sq, k0, nk, 3*D, 2*D, D, d, P, t, blockDim.x);
+        for (int e = t; e < nk; e += blockDim.x) Bs[e] = key_bias(bias, sq.row(k0 + e), N);
+        __syncthreads();
+        for (int kk = 0; kk < nk; kk++) {
+            float kr[d], vr[d];
+            load_row<d>(Ks + (kk*H + h)*P, kr);
+            load_row<d>(Vs + (kk*H + h)*P, vr);
+            const float b = Bs[kk];
+#pragma unroll
+            for (int r = 0; r < R; r++) {
+                float s = 0.0f, dp = 0.0f;
+#pragma unroll
+                for (int c = 0; c < d; c++) s += q[r][c]*kr[c], dp += dO[r][c]*vr[c];
+                const float p  = __expf(scale*s + b - ls[r]);
+                const float ds = p*(dp - Di[r]);
+#pragma unroll
+                for (int c = 0; c < d; c++) dq[r][c] += ds*kr[c];
+            }
+        }
+        __syncthreads();
+    }
+#pragma unroll
+    for (int r = 0; r < R; r++) {
+        const int i = q0 + g + r*G;
+        if (i >= L) continue;
+        float * o = dx + sq.row(i)*3*D + h*d;
+#pragma unroll
+        for (int c = 0; c < d; c++) o[c] = scale*dq[r][c];
+    }
+}
+
+template <int d, int R>
+static __global__ void pet_attn_ragged_bwd_dkv(
+        const float * __restrict__ qkv, const float * __restrict__ bias, const int32_t * __restrict__ off,
+        const float * __restrict__ res, const float * __restrict__ lse, const float * __restrict__ grad,
+        float * __restrict__ dx, float * __restrict__ db, const int N, const int H, const int TP, const int TS, const float scale) {
+    extern __shared__ float4 sm4[];
+    float * sm = reinterpret_cast<float *>(sm4);
+    const int D = H*d, P = d + 4, G = TP / R;
+    float * Qs  = sm;             // [TS][H][P]
+    float * dOs = Qs + TS*H*P;    // [TS][H][P]
+    float * Ls  = dOs + TS*H*P;   // [TS][H]
+    float * Ds  = Ls + TS*H;      // [TS][H]
+
+    const pet_seq sq = pet_sequence(off, N);
+    const int L = sq.L, k0 = blockIdx.y*TP;
+    if (k0 >= L) return;
+    const int t = threadIdx.x, h = t % H, g = t / H;
+
+    float k[R][d], v[R][d], dk[R][d], dv[R][d], bj[R], dbj[R];
+#pragma unroll
+    for (int r = 0; r < R; r++) {
+        const int j = k0 + g + r*G;
+        const bool ok = j < L;
+        const int64_t row = sq.row(ok ? j : 0);
+#pragma unroll
+        for (int c = 0; c < d; c++) {
+            k[r][c] = ok ? qkv[row*3*D +   D + h*d + c] : 0.0f;
+            v[r][c] = ok ? qkv[row*3*D + 2*D + h*d + c] : 0.0f;
+            dk[r][c] = dv[r][c] = 0.0f;
+        }
+        bj[r] = ok ? key_bias(bias, row, N) : 0.0f, dbj[r] = 0.0f;
+    }
+
+    for (int q0 = 0; q0 < L; q0 += TS) {
+        const int nq = min(TS, L - q0);
+        stage_tokens(Qs,  qkv,  sq, q0, nq, 3*D, 0, D, d, P, t, blockDim.x);
+        stage_tokens(dOs, grad, sq, q0, nq,   D, 0, D, d, P, t, blockDim.x);
+        for (int e = t; e < nq*H; e += blockDim.x) Ls[e] = lse[sq.row(q0 + e / H)*H + e % H];
+        __syncthreads();
+        for (int e = t; e < nq*H; e += blockDim.x) {
+            const int qq = e / H, hh = e % H;
+            const float * o = res + sq.row(q0 + qq)*D + hh*d;
+            float s = 0.0f;
+            for (int c = 0; c < d; c++) s += dOs[(qq*H + hh)*P + c]*o[c];
+            Ds[e] = s;
+        }
+        __syncthreads();
+        for (int qq = 0; qq < nq; qq++) {
+            float qr[d], gr[d];
+            load_row<d>(Qs  + (qq*H + h)*P, qr);
+            load_row<d>(dOs + (qq*H + h)*P, gr);
+            const float lq = Ls[qq*H + h], dq = Ds[qq*H + h];
+#pragma unroll
+            for (int r = 0; r < R; r++) {
+                float s = 0.0f, dp = 0.0f;
+#pragma unroll
+                for (int c = 0; c < d; c++) s += qr[c]*k[r][c], dp += gr[c]*v[r][c];
+                const float p  = __expf(scale*s + bj[r] - lq);
+                const float ds = p*(dp - dq);
+                dbj[r] += ds;
+#pragma unroll
+                for (int c = 0; c < d; c++) dv[r][c] += p*gr[c], dk[r][c] += ds*qr[c];
+            }
+        }
+        __syncthreads();
+    }
+#pragma unroll
+    for (int r = 0; r < R; r++) {
+        const int j = k0 + g + r*G;
+        if (j >= L) continue;
+        const int64_t row = sq.row(j);
+        float * o = dx + row*3*D;
+#pragma unroll
+        for (int c = 0; c < d; c++) o[D + h*d + c] = scale*dk[r][c], o[2*D + h*d + c] = dv[r][c];
+        db[row*H + h] = dbj[r];
+    }
+}
+
+// ---- short sequences (max_len <= 64): one block per (sequence, head) ----
+// The whole sequence of one head is staged in shared memory once: q, k, v
+// (and dO), the L x L probabilities and their gradients. A thread owns a
+// query row (scores, softmax, output; dq), then a key row (dk, dv, the bias
+// gradient). Rows are padded to d + 1 floats: a thread's own row and the
+// rows read by all threads at once hit distinct banks.
+
+static constexpr int SHORT_L = 64;
+
+template <int d>
+static __device__ __forceinline__ void stage_head(float * __restrict__ dst, const float * __restrict__ src, const pet_seq & q,
+        const int L, const int64_t stride, const int col) {
+    for (int e = threadIdx.x; e < L*d; e += blockDim.x) {
+        const int r = e / d, c = e % d;
+        dst[r*(d + 1) + c] = src[q.row(r)*stride + col + c];
+    }
+}
+
+template <int d>
+static __global__ void pet_attn_ragged_fwd_short(
+        const float * __restrict__ qkv, const float * __restrict__ bias, const int32_t * __restrict__ off,
+        float * __restrict__ out, float * __restrict__ lse, const int N, const int H, const float scale) {
+    __shared__ float Qs[SHORT_L*(d + 1)], Ks[SHORT_L*(d + 1)], Vs[SHORT_L*(d + 1)], Bs[SHORT_L];
+    const pet_seq sq = pet_sequence(off, N);
+    const int L = sq.L, h = blockIdx.y, D = H*d, t = threadIdx.x;
+    stage_head<d>(Qs, qkv, sq, L, 3*D, h*d);
+    stage_head<d>(Ks, qkv, sq, L, 3*D, D + h*d);
+    stage_head<d>(Vs, qkv, sq, L, 3*D, 2*D + h*d);
+    for (int u = t; u < L; u += blockDim.x) Bs[u] = key_bias(bias, sq.row(u), N);
+    __syncthreads();
+    if (t >= L) return;
+    float q[d], acc[d], m = -INFINITY, l = 0.0f;
+#pragma unroll
+    for (int c = 0; c < d; c++) q[c] = scale*Qs[t*(d + 1) + c], acc[c] = 0.0f;
+    for (int u = 0; u < L; u++) {
+        const float * k = Ks + u*(d + 1);
+        float s = Bs[u];
+#pragma unroll
+        for (int c = 0; c < d; c++) s += q[c]*k[c];
+        if (s > m) {
+            const float corr = __expf(m - s);
+            l *= corr;
+#pragma unroll
+            for (int c = 0; c < d; c++) acc[c] *= corr;
+            m = s;
+        }
+        const float p = __expf(s - m);
+        l += p;
+        const float * v = Vs + u*(d + 1);
+#pragma unroll
+        for (int c = 0; c < d; c++) acc[c] += p*v[c];
+    }
+    const int64_t row = sq.row(t);
+    float * o = out + row*D + h*d;
+#pragma unroll
+    for (int c = 0; c < d; c++) o[c] = acc[c]/l;
+    lse[row*H + h] = m + logf(l);
+}
+
+template <int d>
+static __global__ void pet_attn_ragged_bwd_short(
+        const float * __restrict__ qkv, const float * __restrict__ bias, const int32_t * __restrict__ off,
+        const float * __restrict__ res, const float * __restrict__ lse, const float * __restrict__ grad,
+        float * __restrict__ dx, float * __restrict__ db, const int N, const int H, const float scale) {
+    extern __shared__ float sm[];
+    constexpr int P = d + 1, PL = SHORT_L + 1;
+    float * Qs = sm, * Ks = Qs + SHORT_L*P, * Vs = Ks + SHORT_L*P, * Gs = Vs + SHORT_L*P; // [L][d + 1]
+    float * Ps = Gs + SHORT_L*P, * Ss = Ps + SHORT_L*PL;                                 // [L][L + 1]
+    float * Bs = Ss + SHORT_L*PL;                                                       // [L]
+    const pet_seq sq = pet_sequence(off, N);
+    const int L = sq.L, h = blockIdx.y, D = H*d, t = threadIdx.x;
+    stage_head<d>(Qs, qkv, sq, L, 3*D, h*d);
+    stage_head<d>(Ks, qkv, sq, L, 3*D, D + h*d);
+    stage_head<d>(Vs, qkv, sq, L, 3*D, 2*D + h*d);
+    stage_head<d>(Gs, grad, sq, L, D, h*d);
+    for (int u = t; u < L; u += blockDim.x) Bs[u] = key_bias(bias, sq.row(u), N);
+    __syncthreads();
+    // query row t: probabilities, their gradients, dq
+    if (t < L) {
+        const int64_t row = sq.row(t);
+        const float * q = Qs + t*P, * g = Gs + t*P, * o = res + row*D + h*d;
+        float Di = 0.0f;
+#pragma unroll
+        for (int c = 0; c < d; c++) Di += g[c]*o[c];
+        const float l = lse[row*H + h];
+        float dq[d];
+#pragma unroll
+        for (int c = 0; c < d; c++) dq[c] = 0.0f;
+        for (int u = 0; u < L; u++) {
+            const float * k = Ks + u*P, * v = Vs + u*P;
+            float s = 0.0f, dp = 0.0f;
+#pragma unroll
+            for (int c = 0; c < d; c++) s += q[c]*k[c], dp += g[c]*v[c];
+            const float p = __expf(scale*s + Bs[u] - l), ds = p*(dp - Di);
+            Ps[t*PL + u] = p, Ss[t*PL + u] = ds;
+#pragma unroll
+            for (int c = 0; c < d; c++) dq[c] += ds*k[c];
+        }
+        float * o2 = dx + row*3*D + h*d;
+#pragma unroll
+        for (int c = 0; c < d; c++) o2[c] = scale*dq[c];
+    }
+    __syncthreads();
+    // key row t: dk, dv, the bias gradient
+    if (t < L) {
+        float dk[d], dv[d], dbt = 0.0f;
+#pragma unroll
+        for (int c = 0; c < d; c++) dk[c] = dv[c] = 0.0f;
+        for (int i = 0; i < L; i++) {
+            const float p = Ps[i*PL + t], ds = Ss[i*PL + t];
+            const float * q = Qs + i*P, * g = Gs + i*P;
+            dbt += ds;
+#pragma unroll
+            for (int c = 0; c < d; c++) dk[c] += ds*q[c], dv[c] += p*g[c];
+        }
+        const int64_t row = sq.row(t);
+        float * o2 = dx + row*3*D;
+#pragma unroll
+        for (int c = 0; c < d; c++) o2[D + h*d + c] = scale*dk[c], o2[2*D + h*d + c] = dv[c];
+        db[row*H + h] = dbt;
+    }
+}
+
+// ---- short sequences, low shared memory (the default for max_len <= 64) ----
+// As above, but only the side a thread reads from all rows is staged: K, V for
+// the forward and for dq; then Q, dO (over the same buffers) for dk, dv. A
+// thread keeps its own rows in registers, the probabilities are recomputed
+// in the second pass instead of stored, and the buffers are sized by max_len
+// instead of 64: ~11 KB instead of 25 / 67 KB at max_len 43, head size 32.
+
+template <int d>
+static __global__ void pet_attn_ragged_fwd_short2(
+        const float * __restrict__ qkv, const float * __restrict__ bias, const int32_t * __restrict__ off,
+        float * __restrict__ out, float * __restrict__ lse, const int N, const int H, const float scale, const int Lm) {
+    extern __shared__ float sm[];
+    constexpr int P = d + 1;
+    float * Ks = sm, * Vs = Ks + Lm*P, * Bs = Vs + Lm*P;
+    const pet_seq sq = pet_sequence(off, N);
+    const int L = sq.L, h = blockIdx.y, D = H*d, t = threadIdx.x;
+    stage_head<d>(Ks, qkv, sq, L, 3*D, D + h*d);
+    stage_head<d>(Vs, qkv, sq, L, 3*D, 2*D + h*d);
+    for (int u = t; u < L; u += blockDim.x) Bs[u] = key_bias(bias, sq.row(u), N);
+    __syncthreads();
+    if (t >= L) return;
+    const int64_t row = sq.row(t);
+    float q[d], acc[d], m = -INFINITY, l = 0.0f;
+    load_row<d>(qkv + row*3*D + h*d, q);
+#pragma unroll
+    for (int c = 0; c < d; c++) q[c] *= scale, acc[c] = 0.0f;
+    for (int u = 0; u < L; u++) {
+        const float * k = Ks + u*P;
+        float s = Bs[u];
+#pragma unroll
+        for (int c = 0; c < d; c++) s += q[c]*k[c];
+        if (s > m) {
+            const float corr = __expf(m - s);
+            l *= corr;
+#pragma unroll
+            for (int c = 0; c < d; c++) acc[c] *= corr;
+            m = s;
+        }
+        const float p = __expf(s - m);
+        l += p;
+        const float * v = Vs + u*P;
+#pragma unroll
+        for (int c = 0; c < d; c++) acc[c] += p*v[c];
+    }
+    float * o = out + row*D + h*d;
+#pragma unroll
+    for (int c = 0; c < d; c += 4) *reinterpret_cast<float4 *>(o + c) = make_float4(acc[c]/l, acc[c + 1]/l, acc[c + 2]/l, acc[c + 3]/l);
+    lse[row*H + h] = m + logf(l);
+}
+
+template <int d>
+static __global__ void pet_attn_ragged_bwd_short2(
+        const float * __restrict__ qkv, const float * __restrict__ bias, const int32_t * __restrict__ off,
+        const float * __restrict__ res, const float * __restrict__ lse, const float * __restrict__ grad,
+        float * __restrict__ dx, float * __restrict__ db, const int N, const int H, const float scale, const int Lm) {
+    extern __shared__ float sm[];
+    constexpr int P = d + 1;
+    float * As = sm, * Cs = As + Lm*P, * Bs = Cs + Lm*P, * Ls = Bs + Lm, * Ds = Ls + Lm;
+    const pet_seq sq = pet_sequence(off, N);
+    const int L = sq.L, h = blockIdx.y, D = H*d, t = threadIdx.x;
+    stage_head<d>(As, qkv, sq, L, 3*D, D + h*d);     // K
+    stage_head<d>(Cs, qkv, sq, L, 3*D, 2*D + h*d);   // V
+    for (int u = t; u < L; u += blockDim.x) Bs[u] = key_bias(bias, sq.row(u), N);
+    __syncthreads();
+    const int64_t row = t < L ? sq.row(t) : 0;
+    // query row t: dq
+    if (t < L) {
+        float q[d], g[d], dq[d], Di = 0.0f;
+        load_row<d>(qkv + row*3*D + h*d, q);
+        load_row<d>(grad + row*D + h*d, g);
+        {
+            float o[d];
+            load_row<d>(res + row*D + h*d, o);
+#pragma unroll
+            for (int c = 0; c < d; c++) Di += g[c]*o[c], dq[c] = 0.0f;
+        }
+        const float l = lse[row*H + h];
+        Ls[t] = l, Ds[t] = Di;
+        for (int u = 0; u < L; u++) {
+            const float * k = As + u*P, * v = Cs + u*P;
+            float s = 0.0f, dp = 0.0f;
+#pragma unroll
+            for (int c = 0; c < d; c++) s += q[c]*k[c], dp += g[c]*v[c];
+            const float ds = __expf(scale*s + Bs[u] - l)*(dp - Di);
+#pragma unroll
+            for (int c = 0; c < d; c++) dq[c] += ds*k[c];
+        }
+        float * o2 = dx + row*3*D + h*d;
+#pragma unroll
+        for (int c = 0; c < d; c += 4) *reinterpret_cast<float4 *>(o2 + c) = make_float4(scale*dq[c], scale*dq[c + 1], scale*dq[c + 2], scale*dq[c + 3]);
+    }
+    // key row t: its k, v into registers, then Q, dO over the K, V buffers
+    float k[d], v[d];
+    if (t < L) {
+#pragma unroll
+        for (int c = 0; c < d; c++) k[c] = As[t*P + c], v[c] = Cs[t*P + c];
+    }
+    __syncthreads();
+    stage_head<d>(As, qkv, sq, L, 3*D, h*d);         // Q
+    stage_head<d>(Cs, grad, sq, L, D, h*d);          // dO
+    __syncthreads();
+    if (t >= L) return;
+    float dk[d], dv[d], dbt = 0.0f;
+#pragma unroll
+    for (int c = 0; c < d; c++) dk[c] = dv[c] = 0.0f;
+    const float bt = Bs[t];
+    for (int i = 0; i < L; i++) {
+        const float * q = As + i*P, * g = Cs + i*P;
+        float s = 0.0f, dp = 0.0f;
+#pragma unroll
+        for (int c = 0; c < d; c++) s += q[c]*k[c], dp += g[c]*v[c];
+        const float p = __expf(scale*s + bt - Ls[i]), ds = p*(dp - Ds[i]);
+        dbt += ds;
+#pragma unroll
+        for (int c = 0; c < d; c++) dk[c] += ds*q[c], dv[c] += p*g[c];
+    }
+    float * o2 = dx + row*3*D;
+#pragma unroll
+    for (int c = 0; c < d; c += 4) {
+        *reinterpret_cast<float4 *>(o2 + D + h*d + c) = make_float4(scale*dk[c], scale*dk[c + 1], scale*dk[c + 2], scale*dk[c + 3]);
+        *reinterpret_cast<float4 *>(o2 + 2*D + h*d + c) = make_float4(dv[c], dv[c + 1], dv[c + 2], dv[c + 3]);
+    }
+    db[row*H + h] = dbt;
+}
+
+template <int d>
+static size_t pet_attn_short_bwd_smem() {
+    return (4*(size_t) SHORT_L*(d + 1) + 2*(size_t) SHORT_L*(SHORT_L + 1) + SHORT_L)*sizeof(float);
+}
+
+// rows [N + off[N], T) belong to no sequence: zero their `w` floats of a and `h` floats of b
+static __global__ void pet_ragged_zero_tail(const int32_t * __restrict__ off, const int N, const int64_t T,
+        float * __restrict__ a, const int w, float * __restrict__ b, const int hb) {
+    const int64_t r = (int64_t) N + off[N] + blockIdx.x;
+    if (r >= T) return;
+    for (int c = threadIdx.x; c < w; c += blockDim.x) a[r*w + c] = 0.0f;
+    for (int c = threadIdx.x; c < hb; c += blockDim.x) b[r*hb + c] = 0.0f;
+}
+
+struct pet_ragged_shape { int TP, TS; size_t smem; };
+
+static pet_ragged_shape pet_ragged_shape_for(int H, int d, int R, int L, bool dkv) {
+    const int G = std::max(1, std::min(256 / H, (L + R - 1) / R)), TP = G*R;
+    auto smem = [&](int TS) {
+        return (2*(size_t) TS*H*(d + 4) + (dkv ? 2*(size_t) TS*H : (size_t) TS))*sizeof(float);
+    };
+    int TS = 32;
+    while (TS > 1 && (TS / 2 >= L || smem(TS) > MAX_SMEM)) TS /= 2;
+    return {TP, TS, smem(TS)};
+}
+
+struct pet_ragged_args {
+    const float * qkv, * bias;
+    const int32_t * off;
+    int N, H, max_len;
+    int64_t D, T;
+    float scale;
+};
+
+static pet_ragged_args pet_ragged_get(const ggml_tensor * dst) {
+    const ggml_tensor * qkv = dst->src[0];
+    pet_ragged_args a;
+    a.qkv = (const float *) qkv->data;
+    a.bias = (const float *) dst->src[1]->data;
+    a.off = (const int32_t *) dst->src[2]->data;
+    a.N = (int) (ggml_nelements(dst->src[2]) - 1);
+    a.H = ggml_get_op_params_i32(dst, 0);
+    a.max_len = ggml_get_op_params_i32(dst, 1);
+    a.scale = ggml_get_op_params_f32(dst, 2);
+    a.D = qkv->ne[0] / 3, a.T = qkv->ne[1];
+    return a;
+}
+
+template <int d>
+static void pet_ragged_launch(ggml_backend_cuda_context & ctx, ggml_tensor * dst, bool back) {
+    constexpr int RF = 64 / d > 1 ? 64 / d : 1; // forward: q, acc in registers
+    constexpr int RB = 32 / d > 1 ? 32 / d : 1; // backward: three row arrays
