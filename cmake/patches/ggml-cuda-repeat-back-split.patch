+// repeat_back with the reduction split over blockIdx.y: k_repeat_back gives
+// each dst element a single thread that sums the whole repeated range
+// serially, i.e. 128 threads for a bias gradient of a [128, m, n] tensor.
+// Here ~64k threads share the work and combine with one atomicAdd each.
+static __global__ void k_repeat_back_split_f32(
+        const float * __restrict__ src, float * __restrict__ dst,
+        const int64_t ne0, const int64_t ne1, const int64_t ne2, const int64_t ne3,
+        const int64_t r0, const int64_t r1, const int64_t r2,
+        const size_t s00, const size_t s01, const size_t s02, const size_t s03,
+        const int64_t E, const int64_t R, const int64_t chunk) {
+    const int64_t d = int64_t(blockIdx.x)*blockDim.x + threadIdx.x;
+    if (d >= E) {
+        return;
+    }
+    int64_t t = d;
+    const int64_t i0 = t % ne0; t /= ne0;
+    const int64_t i1 = t % ne1; t /= ne1;
+    const int64_t i2 = t % ne2;
+    const int64_t i3 = t / ne2;
+    const int64_t rb = int64_t(blockIdx.y)*chunk;
+    const int64_t re = rb + chunk < R ? rb + chunk : R;
+    float sum = 0.0f;
+    for (int64_t r = rb; r < re; r++) {
+        int64_t u = r;
+        const int64_t k0 = u % r0; u /= r0;
+        const int64_t k1 = u % r1; u /= r1;
+        const int64_t k2 = u % r2;
+        const int64_t k3 = u / r2;
+        sum += src[(i0 + k0*ne0)*s00 + (i1 + k1*ne1)*s01 + (i2 + k2*ne2)*s02 + (i3 + k3*ne3)*s03];
+    }
+    atomicAdd(dst + d, sum);
+}
