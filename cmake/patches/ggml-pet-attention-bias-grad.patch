+struct ggml_tensor * ggml_pet_attn_back_bias(
+        struct ggml_context * ctx,
+        struct ggml_tensor  * qkv,
+        struct ggml_tensor  * bias,
+        struct ggml_tensor  * result,
+        struct ggml_tensor  * grad,
+        int                   n_head,
+        float                 scale) {
+    GGML_ASSERT(ggml_are_same_shape(result, grad) && grad->type == GGML_TYPE_F32);
+    GGML_ASSERT(result->ne[0] == qkv->ne[0] + n_head);
+
+    struct ggml_tensor * dbias = ggml_new_tensor(ctx, GGML_TYPE_F32, GGML_MAX_DIMS, bias->ne);
+
+    int32_t params[2] = { n_head, 0 };
+    memcpy(params + 1, &scale, sizeof(float));
+    ggml_set_op_params(dbias, params, sizeof(params));
+
+    dbias->op     = GGML_OP_PET_ATTN_BACK_BIAS;
+    dbias->src[0] = qkv;
+    dbias->src[1] = bias;
+    dbias->src[2] = result;
+    dbias->src[3] = grad;
+
+    return dbias;
+}
