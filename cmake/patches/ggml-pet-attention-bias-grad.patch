+// ggml_compute_forward_pet_attn_back_bias: dbias[n][i][j] = sum_h p (dp - D_i)
+
+void ggml_compute_forward_pet_attn_back_bias(const ggml_compute_params * params, ggml_tensor * dst) {
+    const ggml_tensor * qkv  = dst->src[0];
+    const ggml_tensor * bias = dst->src[1];
+    const ggml_tensor * res  = dst->src[2];
+    const ggml_tensor * grad = dst->src[3];
+    const int   H     = ggml_get_op_params_i32(dst, 0);
+    const float scale = ggml_get_op_params_f32(dst, 1);
+    const int64_t D = qkv->ne[0], d = D / H, L = qkv->ne[2], N = qkv->ne[3];
+
+    std::vector<float> x32;
+    for (int64_t n = params->ith; n < N; n += params->nth) {
+        const float * x = pet_attn_qkv_f32(qkv, n, x32);
+        auto in = [&](int64_t i, int s) { return x + (i*3 + s)*D; };
+        auto r  = [&](const ggml_tensor * t, int64_t i) { return (const float *) ((const char *) t->data + n*t->nb[2] + i*t->nb[1]); };
+        for (int64_t i = 0; i < L; i++) {
+            const float * b  = (const float *) ((const char *) bias->data + n*bias->nb[3] + i*bias->nb[1]);
+            float       * db = (float *) ((char *) dst->data + n*dst->nb[3] + i*dst->nb[1]);
+            for (int64_t j = 0; j < L; j++) db[j] = 0.0f;
+            for (int h = 0; h < H; h++) {
+                const float * q  = in(i, 0) + h*d;
+                const float * o  = r(res, i) + h*d;
+                const float * dO = r(grad, i) + h*d;
+                const float lse  = r(res, i)[D + h];
+                float Di = 0.0f;
+                for (int64_t c = 0; c < d; c++) Di += dO[c]*o[c];
+                for (int64_t j = 0; j < L; j++) {
+                    const float * k = in(j, 1) + h*d;
+                    const float * v = in(j, 2) + h*d;
+                    float s = 0.0f, dp = 0.0f;
+                    for (int64_t c = 0; c < d; c++) s += q[c]*k[c], dp += dO[c]*v[c];
+                    db[j] += expf(scale*s + b[j] - lse)*(dp - Di);
+                }
+            }
+        }
+    }
+}
