+
+// GGML_OP_PET_ATTN_BACK_BIAS: one block per (query row i, sequence n), the
+// threads over the keys j; P is recomputed from the stored log-sum-exps,
+//   dbias[n][i][j] = sum_h p_hij (dO_hi . v_hj - dO_hi . o_hi)
+template <int d, typename T>
+static __global__ void pet_attn_bwd_bias(
+        const T * __restrict__ qkv, const float * __restrict__ bias, const float * __restrict__ res,
+        const float * __restrict__ grad, float * __restrict__ dbias, const int H, const int L, const float scale) {
+    extern __shared__ float sm[];
+    const int D = H*d, i = blockIdx.x;
+    const int64_t n = blockIdx.y;
+    float * q = sm, * dO = sm + D, * lse = sm + 2*D, * Di = lse + H;
+    const T * x = qkv + n*L*3*D;
+    const float * ri = res  + (n*L + i)*(D + H);
+    const float * gi = grad + (n*L + i)*(D + H);
+    for (int c = threadIdx.x; c < D; c += blockDim.x) q[c] = ld_f(x + (int64_t) i*3*D + c), dO[c] = gi[c];
+    for (int h = threadIdx.x; h < H; h += blockDim.x) lse[h] = ri[D + h];
+    __syncthreads();
+    for (int h = threadIdx.x; h < H; h += blockDim.x) {
+        float s = 0.0f;
+#pragma unroll
+        for (int c = 0; c < d; c++) s += dO[h*d + c]*ri[h*d + c];
+        Di[h] = s;
+    }
+    __syncthreads();
+    const float * b  = bias  + (n*L + i)*L;
+    float       * db = dbias + (n*L + i)*L;
+    for (int j = threadIdx.x; j < L; j += blockDim.x) {
+        const T * k = x + ((int64_t) j*3 + 1)*D, * v = k + D;
+        float acc = 0.0f;
+        for (int h = 0; h < H; h++) {
+            float s = 0.0f, dp = 0.0f;
+#pragma unroll
+            for (int c = 0; c < d; c++) s += q[h*d + c]*ld_f(k + h*d + c), dp += dO[h*d + c]*ld_f(v + h*d + c);
+            acc += expf(scale*s + b[j] - lse[h])*(dp - Di[h]);
+        }
+        db[j] = acc;
+    }
+}
+
+template <int d, typename T>
+static void pet_attn_launch_bias(ggml_backend_cuda_context & ctx, ggml_tensor * dst) {
+    const ggml_tensor * qkv = dst->src[0];
+    const int   H     = ggml_get_op_params_i32(dst, 0);
+    const float scale = ggml_get_op_params_f32(dst, 1);
+    const int   L     = (int) qkv->ne[2];
+    const int64_t N   = qkv->ne[3];
+    if (N == 0 || L == 0) return;
+    const size_t smem = (2*(size_t) H*d + 2*H)*sizeof(float);
+    GGML_ASSERT(smem <= MAX_SMEM && N <= 65535);
+    const int threads = std::min(128, (L + 31)/32*32);
+    pet_attn_bwd_bias<d, T><<<dim3((unsigned) L, (unsigned) N), threads, smem, ctx.stream()>>>(
+        (const T *) qkv->data, (const float *) dst->src[1]->data, (const float *) dst->src[2]->data,
+        (const float *) dst->src[3]->data, (float *) dst->data, H, L, scale);
+    CUDA_CHECK(cudaGetLastError());
+}
+
+template <typename T>
+static void pet_attn_bias_dispatch_t(ggml_backend_cuda_context & ctx, ggml_tensor * dst) {
+    const int H = ggml_get_op_params_i32(dst, 0), d = (int) (dst->src[0]->ne[0] / H);
+    switch (d) {
+        case  8: pet_attn_launch_bias< 8, T>(ctx, dst); break;
+        case 16: pet_attn_launch_bias<16, T>(ctx, dst); break;
+        case 32: pet_attn_launch_bias<32, T>(ctx, dst); break;
+        case 64: pet_attn_launch_bias<64, T>(ctx, dst); break;
+        default: GGML_ABORT("pet_attn_back_bias: unsupported head size");
+    }
+}
+
+void ggml_cuda_op_pet_attn_back_bias(ggml_backend_cuda_context & ctx, ggml_tensor * dst) {
+    if (dst->src[0]->type == GGML_TYPE_F16) pet_attn_bias_dispatch_t<half>(ctx, dst);
+    else                                    pet_attn_bias_dispatch_t<float>(ctx, dst);
+}
