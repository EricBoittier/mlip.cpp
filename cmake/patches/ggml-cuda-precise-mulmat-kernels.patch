+// mlip.cpp: TILED variants of the precise F32 MUL_MAT (opt-in, MLIPCPP_PRECISE_MATMUL_KERNEL; the default stays
+// mul_mat_f32_f64acc above). A 32 x 32 output tile per block (256 threads, 4 outputs each), the operands staged
+// through shared memory in K-slices of 32, so the global loads coalesce along k. Modes:
+//   0 "tiled": the SAME per-element sum as mul_mat_f32_f64acc (k = 0 .. K-1 in order into one double, products
+//     exact in double): bit-identical results, only the memory traffic differs;
+//   1 "chunk": an fp32 fmaf partial per K-slice of 32 (in order), the slices summed in double (fp64 only in the
+//     final cross-chunk reduction);
+//   2 "dot2": compensated fp32 throughout (Ogita-Rump-Oishi Dot2: TwoProduct by fmaf, TwoSum, explicit _rn
+//     intrinsics so -use_fast_math cannot contract or reassociate), no double at all.
+#define MLIPCPP_PMM_T 32
+template <int mode>
+static __global__ void mul_mat_f32_precise_tiled(const char * __restrict__ x, const char * __restrict__ y, float * __restrict__ dst,
+        const int64_t K, const int64_t ne0, const int64_t ne1, const int64_t ne2,
+        const int64_t r2, const int64_t r3,
+        const size_t nb00, const size_t nb01, const size_t nb02, const size_t nb03,
+        const size_t nb10, const size_t nb11, const size_t nb12, const size_t nb13,
+        const size_t nbd1, const size_t nbd2, const size_t nbd3) {
+    constexpr int T = MLIPCPP_PMM_T;
+    __shared__ float As[T][T + 1];  // As[k][i0 - tile]
+    __shared__ float Bs[T][T + 1];  // Bs[k][i1 - tile]
+    const int tx = threadIdx.x, ty = threadIdx.y;  // 32 x 8
+    const int64_t i0b = (int64_t) blockIdx.x * T, i1b = (int64_t) blockIdx.y * T;
+    const int64_t i2 = blockIdx.z % ne2, i3 = blockIdx.z / ne2;
+    const char * xa = x + (i2 / r2) * nb02 + (i3 / r3) * nb03;
+    const char * yb = y + i2 * nb12 + i3 * nb13;
+    double acc[4] = {0.0, 0.0, 0.0, 0.0};
+    float  hi[4] = {0.f, 0.f, 0.f, 0.f}, lo[4] = {0.f, 0.f, 0.f, 0.f};
+    for (int64_t k0 = 0; k0 < K; k0 += T) {
+        const int64_t k = k0 + tx;
+        #pragma unroll
+        for (int r = 0; r < 4; r++) {
+            const int row = ty + 8 * r;
+            const int64_t i0 = i0b + row, i1 = i1b + row;
+            As[tx][row] = (k < K && i0 < ne0) ? *(const float *) (xa + k * nb00 + i0 * nb01) : 0.0f;
+            Bs[tx][row] = (k < K && i1 < ne1) ? *(const float *) (yb + k * nb10 + i1 * nb11) : 0.0f;
+        }
+        __syncthreads();
+        const int kn = (int) ((K - k0) < T ? (K - k0) : T);
+        #pragma unroll
+        for (int r = 0; r < 4; r++) {
+            const int c = ty + 8 * r;
+            if (mode == 0) {
+                double s = acc[r];
+                for (int kk = 0; kk < kn; kk++) {
+                    s += (double) As[kk][tx] * (double) Bs[kk][c];
+                }
+                acc[r] = s;
+            } else if (mode == 1) {
+                float s = 0.0f;
+                for (int kk = 0; kk < kn; kk++) {
+                    s = fmaf(As[kk][tx], Bs[kk][c], s);
+                }
+                acc[r] += (double) s;
+            } else {
+                float s = hi[r], e = lo[r];
+                for (int kk = 0; kk < kn; kk++) {
+                    const float a = As[kk][tx], b = Bs[kk][c];
+                    const float p = __fmul_rn(a, b);
+                    const float pe = fmaf(a, b, -p);
+                    const float t = __fadd_rn(s, p);
+                    const float z = __fsub_rn(t, s);
+                    const float se = __fadd_rn(__fsub_rn(s, __fsub_rn(t, z)), __fsub_rn(p, z));
+                    e = __fadd_rn(e, __fadd_rn(se, pe));
+                    s = t;
+                }
+                hi[r] = s; lo[r] = e;
+            }
+        }
+        __syncthreads();
+    }
+    const int64_t i0 = i0b + tx;
+    if (i0 >= ne0) {
+        return;
+    }
+    #pragma unroll
+    for (int r = 0; r < 4; r++) {
+        const int64_t i1 = i1b + ty + 8 * r;
+        if (i1 < ne1) {
+            const float v = mode == 2 ? __fadd_rn(hi[r], lo[r]) : (float) acc[r];
+            *(float *) ((char *) dst + i0 * sizeof(float) + i1 * nbd1 + i2 * nbd2 + i3 * nbd3) = v;
+        }
+    }
+}
+
+// MLIPCPP_PRECISE_MATMUL_KERNEL: unset / "naive" -> -1 (mul_mat_f32_f64acc), "tiled" 0, "chunk" 1, "dot2" 2
+static int mlipcpp_precise_mm_kernel() {
+    static const int mode = [] {
+        const char * e = getenv("MLIPCPP_PRECISE_MATMUL_KERNEL");
+        if (!e) return -1;
+        if (!strcmp(e, "tiled")) return 0;
+        if (!strcmp(e, "chunk")) return 1;
+        if (!strcmp(e, "dot2")) return 2;
+        return -1;
+    }();
+    return mode;
+}
