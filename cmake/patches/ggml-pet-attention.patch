+
+    dqkv->op     = GGML_OP_PET_ATTN_BACK;
+    dqkv->src[0] = qkv;
+    dqkv->src[1] = bias;
+    dqkv->src[2] = result;
+    dqkv->src[3] = grad;
+
+    return dqkv;
+}
