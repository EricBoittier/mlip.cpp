+
+// ggml_compute_forward_pet_attn (reference: one thread per sequence)
+
+// sequence n of a contiguous qkv [D, 3, L, N] as F32 (F16 converted into buf)
+static const float * pet_attn_qkv_f32(const ggml_tensor * qkv, int64_t n, std::vector<float> & buf) {
+    const int64_t m = qkv->ne[0]*qkv->ne[1]*qkv->ne[2];
+    if (qkv->type == GGML_TYPE_F32) return (const float *) ((const char *) qkv->data + n*qkv->nb[3]);
+    buf.resize(m);
+    ggml_cpu_fp16_to_fp32((const ggml_fp16_t *) ((const char *) qkv->data + n*qkv->nb[3]), buf.data(), m);
+    return buf.data();
+}
+
+void ggml_compute_forward_pet_attn(const ggml_compute_params * params, ggml_tensor * dst) {
+    const ggml_tensor * qkv  = dst->src[0];
+    const ggml_tensor * bias = dst->src[1];
+    const int   H     = ggml_get_op_params_i32(dst, 0);
+    const float scale = ggml_get_op_params_f32(dst, 1);
+    const int64_t D = qkv->ne[0], d = D / H, L = qkv->ne[2], N = qkv->ne[3];
+
+    std::vector<float> p(L), x32;
+    for (int64_t n = params->ith; n < N; n += params->nth) {
+        const float * x = pet_attn_qkv_f32(qkv, n, x32);
+        auto row = [&](int64_t i, int s) { return x + (i*3 + s)*D; };
+        for (int64_t i = 0; i < L; i++) {
+            const float * b = (const float *) ((const char *) bias->data + n*bias->nb[3] + i*bias->nb[1]);
+            float * out = (float *) ((char *) dst->data + n*dst->nb[2] + i*dst->nb[1]);
+            for (int h = 0; h < H; h++) {
+                const float * q = row(i, 0) + h*d;
+                float mx = -INFINITY;
+                for (int64_t j = 0; j < L; j++) {
+                    const float * k = row(j, 1) + h*d;
+                    float s = 0.0f;
+                    for (int64_t c = 0; c < d; c++) s += q[c]*k[c];
+                    p[j] = scale*s + b[j];
+                    mx = std::max(mx, p[j]);
+                }
+                double sum = 0.0;
+                for (int64_t j = 0; j < L; j++) p[j] = expf(p[j] - mx), sum += p[j];
+                float * o = out + h*d;
+                for (int64_t c = 0; c < d; c++) o[c] = 0.0f;
+                for (int64_t j = 0; j < L; j++) {
+                    const float * v = row(j, 2) + h*d;
+                    const float w = p[j] / (float) sum;
+                    for (int64_t c = 0; c < d; c++) o[c] += w*v[c];
+                }
+                out[D + h] = mx + (float) log(sum);
+            }
+        }
+    }
+}
+
+// ggml_compute_forward_pet_attn_back: dq, dk, dv into the q, k, v slots of dst
+
+void ggml_compute_forward_pet_attn_back(const ggml_compute_params * params, ggml_tensor * dst) {
+    const ggml_tensor * qkv  = dst->src[0];
+    const ggml_tensor * bias = dst->src[1];
+    const ggml_tensor * res  = dst->src[2];
+    const ggml_tensor * grad = dst->src[3];
+    const int   H     = ggml_get_op_params_i32(dst, 0);
+    const float scale = ggml_get_op_params_f32(dst, 1);
+    const int64_t D = qkv->ne[0], d = D / H, L = qkv->ne[2], N = qkv->ne[3];
+
+    std::vector<float> x32;
+    for (int64_t n = params->ith; n < N; n += params->nth) {
+        const float * x = pet_attn_qkv_f32(qkv, n, x32);
+        auto in  = [&](int64_t i, int s) { return x + (i*3 + s)*D; };
+        auto out = [&](int64_t i, int s) { return (float *) ((char *) dst->data + n*dst->nb[3] + i*dst->nb[2] + s*dst->nb[1]); };
+        auto r   = [&](const ggml_tensor * t, int64_t i) { return (const float *) ((const char *) t->data + n*t->nb[2] + i*t->nb[1]); };
+        for (int64_t i = 0; i < L; i++)
+            for (int s = 0; s < 3; s++) memset(out(i, s), 0, D*sizeof(float));
+        for (int h = 0; h < H; h++) {
+            for (int64_t i = 0; i < L; i++) {
+                const float * q  = in(i, 0) + h*d;
+                const float * o  = r(res, i) + h*d;
+                const float * dO = r(grad, i) + h*d;
+                const float lse  = r(res, i)[D + h];
+                const float * b  = (const float *) ((const char *) bias->data + n*bias->nb[3] + i*bias->nb[1]);
+                float Di = 0.0f;
+                for (int64_t c = 0; c < d; c++) Di += dO[c]*o[c];
+                float * dq = out(i, 0) + h*d;
+                for (int64_t j = 0; j < L; j++) {
+                    const float * k = in(j, 1) + h*d;
+                    const float * v = in(j, 2) + h*d;
+                    float s = 0.0f, dp = 0.0f;
+                    for (int64_t c = 0; c < d; c++) s += q[c]*k[c], dp += dO[c]*v[c];
+                    const float p  = expf(scale*s + b[j] - lse);
+                    const float ds = p*(dp - Di)*scale;
+                    float * dk = out(j, 1) + h*d;
+                    float * dv = out(j, 2) + h*d;
+                    for (int64_t c = 0; c < d; c++) dq[c] += ds*k[c], dk[c] += ds*q[c], dv[c] += p*dO[c];
+                }
+            }
+        }
+    }
+}
