+// ggml_pet_attn
+
+struct ggml_tensor * ggml_pet_attn(
+        struct ggml_context * ctx,
+        struct ggml_tensor  * qkv,
+        struct ggml_tensor  * bias,
+        int                   n_head,
+        float                 scale) {
+    GGML_ASSERT((qkv->type == GGML_TYPE_F32 || qkv->type == GGML_TYPE_F16) && bias->type == GGML_TYPE_F32);
+    GGML_ASSERT(ggml_is_contiguous(qkv) && ggml_is_contiguous(bias));
+    GGML_ASSERT(qkv->ne[1] == 3 && n_head > 0 && qkv->ne[0] % n_head == 0);
+    GGML_ASSERT(bias->ne[0] == qkv->ne[2] && bias->ne[1] == qkv->ne[2] && bias->ne[2] == 1 && bias->ne[3] == qkv->ne[3]);
+
+    struct ggml_tensor * result = ggml_new_tensor_3d(ctx, GGML_TYPE_F32, qkv->ne[0] + n_head, qkv->ne[2], qkv->ne[3]);
+
+    int32_t params[2] = { n_head, 0 };
+    memcpy(params + 1, &scale, sizeof(float));
+    ggml_set_op_params(result, params, sizeof(params));
+
+    result->op     = GGML_OP_PET_ATTN;
+    result->src[0] = qkv;
+    result->src[1] = bias;
+
+    return result;
+}
+
+struct ggml_tensor * ggml_pet_attn_back(
+        struct ggml_context * ctx,
+        struct ggml_tensor  * qkv,
+        struct ggml_tensor  * bias,
+        struct ggml_tensor  * result,
+        struct ggml_tensor  * grad,
+        int                   n_head,
+        float                 scale) {
+    GGML_ASSERT(ggml_are_same_shape(result, grad) && grad->type == GGML_TYPE_F32);
+    GGML_ASSERT(result->ne[0] == qkv->ne[0] + n_head);
+
+    struct ggml_tensor * dqkv = ggml_new_tensor(ctx, GGML_TYPE_F32, GGML_MAX_DIMS, qkv->ne); // F32 also for F16 qkv
+
+    int32_t params[2] = { n_head, 0 };
+    memcpy(params + 1, &scale, sizeof(float));
+    ggml_set_op_params(dqkv, params, sizeof(params));
+
+    dqkv->op     = GGML_OP_PET_ATTN_BACK;
+    dqkv->src[0] = qkv;
+    dqkv->src[1] = bias;
+    dqkv->src[2] = result;
+    dqkv->src[3] = grad;
+
+    return dqkv;
+}
