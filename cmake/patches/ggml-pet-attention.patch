diff --git a/src/ggml-cuda/pet-attn.cu b/src/ggml-cuda/pet-attn.cu
new file mode 100644
index 0000000..baa8819
--- /dev/null
+++ b/src/ggml-cuda/pet-attn.cu
@@ -0,0 +1,553 @@
+#include "pet-attn.cuh"
+
+// One thread per (query or key, head); a block holds T positions x H heads
+// and streams the other side in tiles of T rows through shared memory. Rows
+// of all heads are kept head-padded to d+1 floats, so the H threads of one
+// position read distinct banks. Probabilities are recomputed from the stored
+// log-sum-exp in the backward kernels: no L x L matrix is ever stored.
+//
+// qkv [D, 3, L, N] and the result rows [D + H] are contiguous; bias is
+// [L, L, 1, N], bias[n][query][key].
+
+static constexpr int MAX_SMEM = 48*1024;
+
+template <int d>
+static __global__ void pet_attn_fwd(
+        const float * __restrict__ qkv, const float * __restrict__ bias, float * __restrict__ dst,
+        const int H, const int L, const int T, const float scale) {
+    extern __shared__ float sm[];
+    const int D = H*d, P = d + 1;
+    float * Ks = sm;            // [T][H][P]
+    float * Vs = Ks + T*H*P;    // [T][H][P]
+    float * Bs = Vs + T*H*P;    // [T][T]
+
+    const int64_t n = blockIdx.x;
+    const int q0 = blockIdx.y*T, t = threadIdx.x, h = t % H, qi = t / H, i = q0 + qi;
+    const bool active = i < L;
+    const float * base = qkv + n*L*3*D;
+
+    float q[d], acc[d], m = -INFINITY, l = 0.0f;
+#pragma unroll
+    for (int c = 0; c < d; c++) q[c] = active ? scale*base[(int64_t) i*3*D + h*d + c] : 0.0f, acc[c] = 0.0f;
+
+    for (int k0 = 0; k0 < L; k0 += T) {
+        const int nk = min(T, L - k0);
+        for (int e = t; e < nk*D; e += blockDim.x) {
+            const int kk = e / D, c = e % D, o = (kk*H + c / d)*P + c % d;
+            Ks[o] = base[(int64_t) (k0 + kk)*3*D +   D + c];
+            Vs[o] = base[(int64_t) (k0 + kk)*3*D + 2*D + c];
+        }
+        for (int e = t; e < T*nk; e += blockDim.x) {
+            const int a = e / nk, kk = e % nk;
+            Bs[a*T + kk] = q0 + a < L ? bias[(n*L + q0 + a)*L + k0 + kk] : 0.0f;
+        }
+        __syncthreads();
+        if (active) {
+            for (int kk = 0; kk < nk; kk++) {
+                const float * kr = Ks + (kk*H + h)*P;
+                float s = Bs[qi*T + kk];
+#pragma unroll
+                for (int c = 0; c < d; c++) s += q[c]*kr[c];
+                if (s > m) {
+                    const float corr = expf(m - s);
+                    l *= corr;
+#pragma unroll
+                    for (int c = 0; c < d; c++) acc[c] *= corr;
+                    m = s;
+                }
+                const float p = expf(s - m);
+                l += p;
+                const float * vr = Vs + (kk*H + h)*P;
+#pragma unroll
+                for (int c = 0; c < d; c++) acc[c] += p*vr[c];
+            }
+        }
+        __syncthreads();
+    }
+    if (active) {
+        float * o = dst + (n*L + i)*(D + H);
+#pragma unroll
+        for (int c = 0; c < d; c++) o[h*d + c] = acc[c]/l;
+        o[D + h] = m + logf(l);
+    }
+}
+
+// dq = scale * sum_k p (dp - Di) k, one thread per (query, head)
+template <int d>
+static __global__ void pet_attn_bwd_dq(
+        const float * __restrict__ qkv, const float * __restrict__ bias, const float * __restrict__ res,
+        const float * __restrict__ grad, float * __restrict__ dst,
+        const int H, const int L, const int T, const float scale) {
+    extern __shared__ float sm[];
+    const int D = H*d, P = d + 1;
+    float * Ks = sm;
+    float * Vs = Ks + T*H*P;
+    float * Bs = Vs + T*H*P;
+
+    const int64_t n = blockIdx.x;
+    const int q0 = blockIdx.y*T, t = threadIdx.x, h = t % H, qi = t / H, i = q0 + qi;
+    const bool active = i < L;
+    const float * base = qkv + n*L*3*D;
+    const int64_t row = n*L + (active ? i : 0);
+
+    float q[d], dO[d], dq[d], Di = 0.0f;
+#pragma unroll
+    for (int c = 0; c < d; c++) {
+        q[c]  = active ? base[(int64_t) i*3*D + h*d + c] : 0.0f;
+        dO[c] = active ? grad[row*(D + H) + h*d + c] : 0.0f;
+        Di   += dO[c]*(active ? res[row*(D + H) + h*d + c] : 0.0f);
+        dq[c] = 0.0f;
+    }
+    const float lse = active ? res[row*(D + H) + D + h] : 0.0f;
+
+    for (int k0 = 0; k0 < L; k0 += T) {
+        const int nk = min(T, L - k0);
+        for (int e = t; e < nk*D; e += blockDim.x) {
+            const int kk = e / D, c = e % D, o = (kk*H + c / d)*P + c % d;
+            Ks[o] = base[(int64_t) (k0 + kk)*3*D +   D + c];
+            Vs[o] = base[(int64_t) (k0 + kk)*3*D + 2*D + c];
+        }
+        for (int e = t; e < T*nk; e += blockDim.x) {
+            const int a = e / nk, kk = e % nk;
+            Bs[a*T + kk] = q0 + a < L ? bias[(n*L + q0 + a)*L + k0 + kk] : 0.0f;
+        }
+        __syncthreads();
+        if (active) {
+            for (int kk = 0; kk < nk; kk++) {
+                const float * kr = Ks + (kk*H + h)*P;
+                const float * vr = Vs + (kk*H + h)*P;
+                float s = 0.0f, dp = 0.0f;
+#pragma unroll
+                for (int c = 0; c < d; c++) s += q[c]*kr[c], dp += dO[c]*vr[c];
+                const float p  = expf(scale*s + Bs[qi*T + kk] - lse);
+                const float ds = p*(dp - Di);
+#pragma unroll
+                for (int c = 0; c < d; c++) dq[c] += ds*kr[c];
+            }
+        }
+        __syncthreads();
+    }
+    if (active) {
+#pragma unroll
+        for (int c = 0; c < d; c++) dst[row*3*D + h*d + c] = scale*dq[c];
+    }
+}
+
+// dk = scale * sum_q p (dp - Di) q, dv = sum_q p dO, one thread per (key, head)
+template <int d>
+static __global__ void pet_attn_bwd_dkv(
+        const float * __restrict__ qkv, const float * __restrict__ bias, const float * __restrict__ res,
+        const float * __restrict__ grad, float * __restrict__ dst,
+        const int H, const int L, const int T, const float scale) {
+    extern __shared__ float sm[];
+    const int D = H*d, P = d + 1;
+    float * Qs  = sm;             // [T][H][P]
+    float * dOs = Qs + T*H*P;     // [T][H][P]
+    float * Bs  = dOs + T*H*P;    // [T queries][T keys]
+    float * Ls  = Bs + T*T;       // [T][H] log-sum-exp
+    float * Ds  = Ls + T*H;       // [T][H] dO . O
+
+    const int64_t n = blockIdx.x;
+    const int k0 = blockIdx.y*T, t = threadIdx.x, h = t % H, kj = t / H, j = k0 + kj;
+    const bool active = j < L;
+    const int nk = min(T, L - k0);
+    const float * base = qkv + n*L*3*D;
+
+    float k[d], v[d], dk[d], dv[d];
+#pragma unroll
+    for (int c = 0; c < d; c++) {
+        k[c] = active ? base[(int64_t) j*3*D +   D + h*d + c] : 0.0f;
+        v[c] = active ? base[(int64_t) j*3*D + 2*D + h*d + c] : 0.0f;
+        dk[c] = dv[c] = 0.0f;
+    }
+
+    for (int q0 = 0; q0 < L; q0 += T) {
+        const int nq = min(T, L - q0);
+        for (int e = t; e < nq*D; e += blockDim.x) {
+            const int qq = e / D, c = e % D, o = (qq*H + c / d)*P + c % d;
+            const int64_t row = n*L + q0 + qq;
+            Qs[o]  = base[(int64_t) (q0 + qq)*3*D + c];
+            dOs[o] = grad[row*(D + H) + c];
+        }
+        for (int e = t; e < nq*nk; e += blockDim.x) {
+            const int qq = e / nk, kk = e % nk;
+            Bs[qq*T + kk] = bias[(n*L + q0 + qq)*L + k0 + kk];
+        }
+        for (int e = t; e < nq*H; e += blockDim.x) Ls[e] = res[(n*L + q0 + e / H)*(D + H) + D + e % H];
+        __syncthreads();
+        for (int e = t; e < nq*H; e += blockDim.x) {
+            const int qq = e / H, hh = e % H;
+            const float * o = res + (n*L + q0 + qq)*(D + H) + hh*d;
+            float s = 0.0f;
+            for (int c = 0; c < d; c++) s += dOs[(qq*H + hh)*P + c]*o[c];
+            Ds[e] = s;
+        }
+        __syncthreads();
+        if (active) {
+            for (int qq = 0; qq < nq; qq++) {
+                const float * qr = Qs  + (qq*H + h)*P;
+                const float * gr = dOs + (qq*H + h)*P;
+                float s = 0.0f, dp = 0.0f;
+#pragma unroll
+                for (int c = 0; c < d; c++) s += qr[c]*k[c], dp += gr[c]*v[c];
+                const float p  = expf(scale*s + Bs[qq*T + kj] - Ls[qq*H + h]);
+                const float ds = p*(dp - Ds[qq*H + h]);
+#pragma unroll
+                for (int c = 0; c < d; c++) dv[c] += p*gr[c], dk[c] += ds*qr[c];
+            }
+        }
+        __syncthreads();
+    }
+    if (active) {
+        float * o = dst + (n*L + j)*3*D;
+#pragma unroll
+        for (int c = 0; c < d; c++) o[D + h*d + c] = scale*dk[c], o[2*D + h*d + c] = dv[c];
+    }
+}
+
+
+// ---- v2: register-blocked ----
+// Each thread owns R rows (queries; keys in the dk/dv kernel) of one head, so
+// a row streamed through shared memory is loaded once and used R times
+// (v1: once). Shared rows are padded to d+4 floats: 128-bit loads, and the
+// heads of a quarter-warp hit disjoint banks. A block holds G row groups x H
+// heads (TP = G*R rows, fitted to L: short adaptive-cutoff sequences do not
+// leave threads idle) and streams the other side in tiles of TS rows. A
+// thread's rows are strided by G, so that a tile's rows are spread evenly.
+
+template <int d>
+static __device__ __forceinline__ void load_row(const float * __restrict__ s, float (&r)[d]) {
+#pragma unroll
+    for (int c = 0; c < d; c += 4) {
+        const float4 v = *reinterpret_cast<const float4 *>(s + c);
+        r[c] = v.x, r[c + 1] = v.y, r[c + 2] = v.z, r[c + 3] = v.w;
+    }
+}
+
+// nr rows of D floats (row stride `stride`) into shared [nr][H][P]
+static __device__ __forceinline__ void stage_rows(float * __restrict__ dst, const float * __restrict__ src,
+        const int64_t stride, const int nr, const int D, const int d, const int P, const int t, const int nt) {
+    const int H = D / d;
+    if ((stride & 3) == 0 && (reinterpret_cast<uintptr_t>(src) & 15) == 0) {
+        const int D4 = D / 4;
+        for (int e = t; e < nr*D4; e += nt) {
+            const int r = e / D4, c = (e % D4)*4;
+            *reinterpret_cast<float4 *>(dst + (r*H + c / d)*P + c % d) = *reinterpret_cast<const float4 *>(src + r*stride + c);
+        }
+    } else {
+        for (int e = t; e < nr*D; e += nt) {
+            const int r = e / D, c = e % D;
+            dst[(r*H + c / d)*P + c % d] = src[r*stride + c];
+        }
+    }
+}
+
+template <int d, int R>
+static __global__ void pet_attn_fwd_v2(
+        const float * __restrict__ qkv, const float * __restrict__ bias, float * __restrict__ dst,
+        const int H, const int L, const int TP, const int TS, const float scale) {
+    extern __shared__ float4 sm4[];
+    float * sm = reinterpret_cast<float *>(sm4);
+    const int D = H*d, P = d + 4, G = TP / R;
+    float * Ks = sm;            // [TS][H][P]
+    float * Vs = Ks + TS*H*P;   // [TS][H][P]
+    float * Bs = Vs + TS*H*P;   // [TP][TS]
+
+    const int64_t n = blockIdx.x;
+    const int q0 = blockIdx.y*TP, t = threadIdx.x, h = t % H, g = t / H;
+    const float * base = qkv + n*L*3*D;
+
+    float q[R][d], acc[R][d], m[R], l[R];
+#pragma unroll
+    for (int r = 0; r < R; r++) {
+        const int i = q0 + g + r*G;
+        m[r] = -INFINITY, l[r] = 0.0f;
+#pragma unroll
+        for (int c = 0; c < d; c++) q[r][c] = i < L ? scale*base[(int64_t) i*3*D + h*d + c] : 0.0f, acc[r][c] = 0.0f;
+    }
+
+    for (int k0 = 0; k0 < L; k0 += TS) {
+        const int nk = min(TS, L - k0);
+        stage_rows(Ks, base + (int64_t) k0*3*D +   D, 3*D, nk, D, d, P, t, blockDim.x);
+        stage_rows(Vs, base + (int64_t) k0*3*D + 2*D, 3*D, nk, D, d, P, t, blockDim.x);
+        for (int e = t; e < TP*nk; e += blockDim.x) {
+            const int a = e / nk, kk = e % nk;
+            Bs[a*TS + kk] = q0 + a < L ? bias[(n*L + q0 + a)*L + k0 + kk] : 0.0f;
+        }
+        __syncthreads();
+        for (int kk = 0; kk < nk; kk++) {
+            float kr[d], vr[d];
+            load_row<d>(Ks + (kk*H + h)*P, kr);
+            load_row<d>(Vs + (kk*H + h)*P, vr);
+#pragma unroll
+            for (int r = 0; r < R; r++) {
+                float s = Bs[(g + r*G)*TS + kk];
+#pragma unroll
+                for (int c = 0; c < d; c++) s += q[r][c]*kr[c];
+                if (s > m[r]) {
+                    const float corr = __expf(m[r] - s);
+                    l[r] *= corr;
+#pragma unroll
+                    for (int c = 0; c < d; c++) acc[r][c] *= corr;
+                    m[r] = s;
+                }
+                const float p = __expf(s - m[r]);
+                l[r] += p;
+#pragma unroll
+                for (int c = 0; c < d; c++) acc[r][c] += p*vr[c];
+            }
+        }
+        __syncthreads();
+    }
+#pragma unroll
+    for (int r = 0; r < R; r++) {
+        const int i = q0 + g + r*G;
+        if (i >= L) continue;
+        float * o = dst + (n*L + i)*(D + H);
+#pragma unroll
+        for (int c = 0; c < d; c++) o[h*d + c] = acc[r][c]/l[r];
+        o[D + h] = m[r] + logf(l[r]);
+    }
+}
+
+template <int d, int R>
+static __global__ void pet_attn_bwd_dq_v2(
+        const float * __restrict__ qkv, const float * __restrict__ bias, const float * __restrict__ res,
+        const float * __restrict__ grad, float * __restrict__ dst,
+        const int H, const int L, const int TP, const int TS, const float scale) {
+    extern __shared__ float4 sm4[];
+    float * sm = reinterpret_cast<float *>(sm4);
+    const int D = H*d, P = d + 4, G = TP / R;
+    float * Ks = sm;
+    float * Vs = Ks + TS*H*P;
+    float * Bs = Vs + TS*H*P;   // [TP][TS]
+
+    const int64_t n = blockIdx.x;
+    const int q0 = blockIdx.y*TP, t = threadIdx.x, h = t % H, g = t / H;
+    const float * base = qkv + n*L*3*D;
+
+    float q[R][d], dO[R][d], dq[R][d], Di[R], lse[R];
+#pragma unroll
+    for (int r = 0; r < R; r++) {
+        const int i = q0 + g + r*G;
+        const bool ok = i < L;
+        const int64_t row = n*L + (ok ? i : 0);
+        Di[r] = 0.0f;
+#pragma unroll
+        for (int c = 0; c < d; c++) {
+            q[r][c]  = ok ? base[(int64_t) i*3*D + h*d + c] : 0.0f;
+            dO[r][c] = ok ? grad[row*(D + H) + h*d + c] : 0.0f;
+            Di[r]   += dO[r][c]*(ok ? res[row*(D + H) + h*d + c] : 0.0f);
+            dq[r][c] = 0.0f;
+        }
+        lse[r] = ok ? res[row*(D + H) + D + h] : 0.0f;
+    }
+
+    for (int k0 = 0; k0 < L; k0 += TS) {
+        const int nk = min(TS, L - k0);
+        stage_rows(Ks, base + (int64_t) k0*3*D +   D, 3*D, nk, D, d, P, t, blockDim.x);
+        stage_rows(Vs, base + (int64_t) k0*3*D + 2*D, 3*D, nk, D, d, P, t, blockDim.x);
+        for (int e = t; e < TP*nk; e += blockDim.x) {
+            const int a = e / nk, kk = e % nk;
+            Bs[a*TS + kk] = q0 + a < L ? bias[(n*L + q0 + a)*L + k0 + kk] : 0.0f;
+        }
+        __syncthreads();
+        for (int kk = 0; kk < nk; kk++) {
+            float kr[d], vr[d];
+            load_row<d>(Ks + (kk*H + h)*P, kr);
+            load_row<d>(Vs + (kk*H + h)*P, vr);
+#pragma unroll
+            for (int r = 0; r < R; r++) {
+                float s = 0.0f, dp = 0.0f;
+#pragma unroll
+                for (int c = 0; c < d; c++) s += q[r][c]*kr[c], dp += dO[r][c]*vr[c];
+                const float p  = __expf(scale*s + Bs[(g + r*G)*TS + kk] - lse[r]);
+                const float ds = p*(dp - Di[r]);
+#pragma unroll
+                for (int c = 0; c < d; c++) dq[r][c] += ds*kr[c];
+            }
+        }
+        __syncthreads();
+    }
+#pragma unroll
+    for (int r = 0; r < R; r++) {
+        const int i = q0 + g + r*G;
+        if (i >= L) continue;
+#pragma unroll
+        for (int c = 0; c < d; c++) dst[(n*L + i)*3*D + h*d + c] = scale*dq[r][c];
+    }
+}
+
+template <int d, int R>
+static __global__ void pet_attn_bwd_dkv_v2(
+        const float * __restrict__ qkv, const float * __restrict__ bias, const float * __restrict__ res,
+        const float * __restrict__ grad, float * __restrict__ dst,
+        const int H, const int L, const int TP, const int TS, const float scale) {
+    extern __shared__ float4 sm4[];
+    float * sm = reinterpret_cast<float *>(sm4);
+    const int D = H*d, P = d + 4, G = TP / R;
+    float * Qs  = sm;             // [TS][H][P]
+    float * dOs = Qs + TS*H*P;    // [TS][H][P]
+    float * Bs  = dOs + TS*H*P;   // [TS queries][TP keys]
+    float * Ls  = Bs + TS*TP;     // [TS][H]
+    float * Ds  = Ls + TS*H;      // [TS][H]
+
+    const int64_t n = blockIdx.x;
+    const int k0 = blockIdx.y*TP, t = threadIdx.x, h = t % H, g = t / H;
+    const float * base = qkv + n*L*3*D;
+
+    float k[R][d], v[R][d], dk[R][d], dv[R][d];
+#pragma unroll
+    for (int r = 0; r < R; r++) {
+        const int j = k0 + g + r*G;
+#pragma unroll
+        for (int c = 0; c < d; c++) {
+            k[r][c] = j < L ? base[(int64_t) j*3*D +   D + h*d + c] : 0.0f;
+            v[r][c] = j < L ? base[(int64_t) j*3*D + 2*D + h*d + c] : 0.0f;
+            dk[r][c] = dv[r][c] = 0.0f;
+        }
+    }
+
+    for (int q0 = 0; q0 < L; q0 += TS) {
+        const int nq = min(TS, L - q0);
+        stage_rows(Qs,  base + (int64_t) q0*3*D, 3*D, nq, D, d, P, t, blockDim.x);
+        stage_rows(dOs, grad + (n*L + q0)*(D + H), D + H, nq, D, d, P, t, blockDim.x);
+        for (int e = t; e < nq*TP; e += blockDim.x) {
+            const int qq = e / TP, a = e % TP;
+            Bs[qq*TP + a] = k0 + a < L ? bias[(n*L + q0 + qq)*L + k0 + a] : 0.0f;
+        }
+        for (int e = t; e < nq*H; e += blockDim.x) Ls[e] = res[(n*L + q0 + e / H)*(D + H) + D + e % H];
+        __syncthreads();
+        for (int e = t; e < nq*H; e += blockDim.x) {
+            const int qq = e / H, hh = e % H;
+            const float * o = res + (n*L + q0 + qq)*(D + H) + hh*d;
+            float s = 0.0f;
+            for (int c = 0; c < d; c++) s += dOs[(qq*H + hh)*P + c]*o[c];
+            Ds[e] = s;
+        }
+        __syncthreads();
+        for (int qq = 0; qq < nq; qq++) {
+            float qr[d], gr[d];
+            load_row<d>(Qs  + (qq*H + h)*P, qr);
+            load_row<d>(dOs + (qq*H + h)*P, gr);
+            const float lq = Ls[qq*H + h], dq = Ds[qq*H + h];
+#pragma unroll
+            for (int r = 0; r < R; r++) {
+                float s = 0.0f, dp = 0.0f;
+#pragma unroll
+                for (int c = 0; c < d; c++) s += qr[c]*k[r][c], dp += gr[c]*v[r][c];
+                const float p  = __expf(scale*s + Bs[qq*TP + g + r*G] - lq);
+                const float ds = p*(dp - dq);
+#pragma unroll
+                for (int c = 0; c < d; c++) dv[r][c] += p*gr[c], dk[r][c] += ds*qr[c];
+            }
+        }
+        __syncthreads();
+    }
+#pragma unroll
+    for (int r = 0; r < R; r++) {
+        const int j = k0 + g + r*G;
+        if (j >= L) continue;
+        float * o = dst + (n*L + j)*3*D;
+#pragma unroll
+        for (int c = 0; c < d; c++) o[D + h*d + c] = scale*dk[r][c], o[2*D + h*d + c] = dv[r][c];
+    }
+}
+
+// v2 launch shape: G row groups (<= 256 threads, no more rows than L), then
+// the largest streamed tile TS <= 32 that fits (and is not much above L)
+struct pet_attn_shape { int TP, TS; size_t smem; };
+
+static pet_attn_shape pet_attn_v2_shape(int H, int d, int R, int L, bool dkv) {
+    const int G = std::max(1, std::min(256 / H, (L + R - 1) / R)), TP = G*R;
+    auto smem = [&](int TS) {
+        return (2*(size_t) TS*H*(d + 4) + (size_t) TP*TS + (dkv ? 2*(size_t) TS*H : 0))*sizeof(float);
+    };
+    int TS = 32;
+    while (TS > 1 && (TS / 2 >= L || smem(TS) > MAX_SMEM)) TS /= 2;
+    return {TP, TS, smem(TS)};
+}
+
+template <int d>
+static void pet_attn_launch_v2(ggml_backend_cuda_context & ctx, ggml_tensor * dst, bool back) {
+    constexpr int RF = 64 / d > 1 ? 64 / d : 1; // forward: q, acc in registers
+    constexpr int RB = 32 / d > 1 ? 32 / d : 1; // backward: three row arrays
+    const ggml_tensor * qkv = dst->src[0];
+    const int   H     = ggml_get_op_params_i32(dst, 0);
+    const float scale = ggml_get_op_params_f32(dst, 1);
+    const int   L     = (int) qkv->ne[2];
+    const int64_t N   = qkv->ne[3];
+    if (N == 0 || L == 0) return;
+    cudaStream_t stream = ctx.stream();
+    const float * q = (const float *) qkv->data, * b = (const float *) dst->src[1]->data;
+    if (!back) {
+        const pet_attn_shape s = pet_attn_v2_shape(H, d, RF, L, false);
+        const dim3 grid((unsigned) N, (L + s.TP - 1) / s.TP), block(s.TP / RF * H);
+        pet_attn_fwd_v2<d, RF><<<grid, block, s.smem, stream>>>(q, b, (float *) dst->data, H, L, s.TP, s.TS, scale);
+    } else {
+        const float * res = (const float *) dst->src[2]->data, * grad = (const float *) dst->src[3]->data;
+        const pet_attn_shape sq = pet_attn_v2_shape(H, d, RB, L, false), sk = pet_attn_v2_shape(H, d, RB, L, true);
+        pet_attn_bwd_dq_v2<d, RB><<<dim3((unsigned) N, (L + sq.TP - 1) / sq.TP), sq.TP / RB * H, sq.smem, stream>>>(
+            q, b, res, grad, (float *) dst->data, H, L, sq.TP, sq.TS, scale);
+        pet_attn_bwd_dkv_v2<d, RB><<<dim3((unsigned) N, (L + sk.TP - 1) / sk.TP), sk.TP / RB * H, sk.smem, stream>>>(
+            q, b, res, grad, (float *) dst->data, H, L, sk.TP, sk.TS, scale);
+    }
+    CUDA_CHECK(cudaGetLastError());
+}
+
+// positions per block: 256 threads, shrunk until the tiles fit
+static int pet_attn_tile(int H, int d, bool back) {
+    int T = std::max(1, 256 / H);
+    auto smem = [&](int T) { return (2*T*H*(d + 1) + T*T + (back ? 2*T*H : 0))*(int) sizeof(float); };
+    while (T > 1 && smem(T) > MAX_SMEM) T /= 2;
+    return T;
+}
+
+bool ggml_cuda_pet_attn_supported(const ggml_tensor * op) {
+    const int H = ggml_get_op_params_i32(op, 0);
+    const int64_t d = op->src[0]->ne[0] / H;
+    for (int i = 0; i < GGML_MAX_SRC && op->src[i]; i++)
+        if (op->src[i]->type != GGML_TYPE_F32 || !ggml_is_contiguous(op->src[i])) return false;
+    return (d == 8 || d == 16 || d == 32 || d == 64) && H <= 256 && op->src[0]->ne[2] <= (1 << 28);
+}
+
+template <int d>
+static void pet_attn_launch(ggml_backend_cuda_context & ctx, ggml_tensor * dst, bool back) {
+    const ggml_tensor * qkv = dst->src[0];
+    const int   H     = ggml_get_op_params_i32(dst, 0);
+    const float scale = ggml_get_op_params_f32(dst, 1);
+    const int   L     = (int) qkv->ne[2];
+    const int64_t N   = qkv->ne[3];
+    if (N == 0 || L == 0) return;
+    const int T = pet_attn_tile(H, d, back);
+    const dim3 grid((unsigned) N, (L + T - 1) / T), block(T*H);
+    cudaStream_t stream = ctx.stream();
+    const float * q = (const float *) qkv->data, * b = (const float *) dst->src[1]->data;
+    if (!back) {
+        const size_t smem = (2*T*H*(d + 1) + T*T)*sizeof(float);
+        pet_attn_fwd<d><<<grid, block, smem, stream>>>(q, b, (float *) dst->data, H, L, T, scale);
+    } else {
+        const float * res = (const float *) dst->src[2]->data, * grad = (const float *) dst->src[3]->data;
+        const size_t smem_q = (2*T*H*(d + 1) + T*T)*sizeof(float);
+        const size_t smem_k = smem_q + 2*T*H*sizeof(float);
+        pet_attn_bwd_dq<d><<<grid, block, smem_q, stream>>>(q, b, res, grad, (float *) dst->data, H, L, T, scale);
+        pet_attn_bwd_dkv<d><<<grid, block, smem_k, stream>>>(q, b, res, grad, (float *) dst->data, H, L, T, scale);
+    }
+    CUDA_CHECK(cudaGetLastError());
+}
+
+// GGML_PET_ATTN_V1=1: the one-row-per-thread kernels (A/B)
+static void pet_attn_dispatch(ggml_backend_cuda_context & ctx, ggml_tensor * dst, bool back) {
+    static const bool v1 = getenv("GGML_PET_ATTN_V1") != nullptr;
+    const int H = ggml_get_op_params_i32(dst, 0);
+    switch (dst->src[0]->ne[0] / H) {
+        case  8: v1 ? pet_attn_launch< 8>(ctx, dst, back) : pet_attn_launch_v2< 8>(ctx, dst, back); break;
+        case 16: v1 ? pet_attn_launch<16>(ctx, dst, back) : pet_attn_launch_v2<16>(ctx, dst, back); break;
+        case 32: v1 ? pet_attn_launch<32>(ctx, dst, back) : pet_attn_launch_v2<32>(ctx, dst, back); break;
+        case 64: v1 ? pet_attn_launch<64>(ctx, dst, back) : pet_attn_launch_v2<64>(ctx, dst, back); break;
+        default: GGML_ABORT("pet_attn: unsupported head size");
+    }
+}
+
+void ggml_cuda_op_pet_attn(ggml_backend_cuda_context & ctx, ggml_tensor * dst) { pet_attn_dispatch(ctx, dst, false); }
+void ggml_cuda_op_pet_attn_back(ggml_backend_cuda_context & ctx, ggml_tensor * dst) { pet_attn_dispatch(ctx, dst, true); }
